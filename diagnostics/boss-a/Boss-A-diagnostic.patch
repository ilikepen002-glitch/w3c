diff --git a/tools/VerifyEclipseBossCandidate.py b/tools/VerifyEclipseBossCandidate.py
new file mode 100644
index 0000000..80d5c8c
--- /dev/null
+++ b/tools/VerifyEclipseBossCandidate.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Verify Boss-A exact 100-byte delta; optionally verify actual packaged candidate.
+No parser dependency needed. This does not test native rendering.
+"""
+import argparse
+import hashlib
+import json
+import struct
+from pathlib import Path
+from GenerateTowerTerrainMask import Mpq, ROOT
+from VerifyTowerPlacementArtifact import unit_objects
+
+ORIGINAL = 'b19878db04cfef6dc053d6443281e312f95ff1375dd3f4a38007a29c7ea90406'
+CANDIDATE = 'f928308fbb4f09e14703852feaa0251e623e4e6b462f12b1809ab50609a70d73'
+MODEL = 'war3mapImported\\EclipseSpellweaver.mdx'
+TEXTURE = 'Textures\\EclipseSpellweaverAtlas.blp'
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+def chunks(data):
+    assert data[:4] == b'MDLX'
+    result, pos = {}, 4
+    while pos < len(data):
+        tag, size = struct.unpack_from('<4sI', data, pos)
+        assert tag not in result
+        result[tag] = (pos + 8, data[pos + 8:pos + 8 + size])
+        pos += 8 + size
+    assert pos == len(data)
+    return result
+
+def verify(data):
+    assert sha(data) == CANDIDATE, 'Candidate hash mismatch'
+    cs = chunks(data)
+    assert struct.unpack('<I', cs[b'VERS'][1])[0] == 800
+    original = bytearray(data)
+    start, bones = cs[b'BONE']
+    pos, offsets = 0, []
+    while pos < len(bones):
+        size = struct.unpack_from('<I', bones, pos)[0]
+        assert size >= 96 and pos + size + 8 <= len(bones)
+        assert struct.unpack_from('<ii', bones, pos + size) == (0, -1)
+        offset = start + pos + size
+        struct.pack_into('<i', original, offset, -1)
+        offsets.append(offset)
+        pos += size + 8
+    assert pos == len(bones) and len(offsets) == 25
+    assert sha(original) == ORIGINAL, 'Bytes besides the 25 GeosetId fields changed'
+    assert sum(a != b for a, b in zip(data, original)) == 100
+    # The reconstructed baseline hash proves geometry, UVs, bindings, animation
+    # tracks, hierarchy, pivots, extents and all other bytes remain identical.
+    return offsets
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--map', type=Path)
+    parser.add_argument('--reference-map', type=Path)
+    args = parser.parse_args()
+    assert not args.reference_map or args.map, '--reference-map requires --map'
+    source = (ROOT/'imports/war3mapImported/EclipseSpellweaver.mdx').read_bytes()
+    offsets = verify(source)
+    manifest = json.loads((ROOT/'assets/source/eclipse-spellweaver-v3/production-manifest.json').read_text())
+    assert manifest['assets'][0]['sha256'] == sha(source)
+    for item in manifest['assets']:
+        b = (ROOT/item['repositoryImportPath']).read_bytes()
+        assert len(b) == item['bytes'] and sha(b) == item['sha256']
+    result = {'candidate':'Boss-A-20261014','sourceSha256':sha(source),'changedBytes':100,
+              'boneGeosetOffsets':offsets,'nonMetadataBytesEquivalent':True,'nativeTested':False}
+    if args.map:
+        artifact = Mpq(args.map.read_bytes())
+        assert artifact.extract(MODEL) == source
+        assert artifact.extract(TEXTURE) == (ROOT/'imports/Textures/EclipseSpellweaverAtlas.blp').read_bytes()
+        units = unit_objects(artifact.extract('war3map.w3u'))
+        assert units['uB24']['umdl'] == MODEL
+        assert units['uB24']['usca'] == 8.0
+        assert b'Boss-A' in artifact.extract('war3map.w3i'), 'Diagnostic map label missing'
+        result.update(mapSha256=sha(args.map.read_bytes()), packagedModelAndTexture=True,
+                      unitModelPath=units['uB24']['umdl'], unitScale=units['uB24']['usca'])
+        if args.reference_map:
+            reference = Mpq(args.reference_map.read_bytes())
+            old = unit_objects(reference.extract('war3map.w3u'))
+            bosses = sorted(k for k in old if k.startswith('uB'))
+            assert bosses and 'uB24' in bosses
+            assert {k: old[k] for k in bosses} == {k: units[k] for k in bosses}, 'Boss object fields changed'
+            result['unchangedBossObjects'] = bosses
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+
+if __name__ == '__main__':
+    main()
