+// Read-only check: actual vertex influences plus ancestor dependencies, not all
+// declared matrix groups (unused groups must not count as an influence).
+const fs=require('fs'),path=require('path'),assert=require('assert');
+const rt=process.env.MDX_PARSER_RUNTIME;if(!rt)throw Error('Set MDX_PARSER_RUNTIME');
+const ts=require(path.join(rt,'typescript'));
+require.extensions['.ts']=(m,f)=>m._compile(ts.transpileModule(fs.readFileSync(f,'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2018}}).outputText,f);
+const base=path.join(rt,'mdx-m3-viewer/src');
+const Model=require(base+'/parsers/mdlx/model.ts').default;
+const sanity=require(base+'/utils/mdlx/sanitytest/sanitytest.ts').default;
+const data=fs.readFileSync(process.argv[2]),m=new Model();m.load(new Uint8Array(data));
+assert.equal(m.geosets.length,1);assert.equal(m.bones.length,25);assert.equal(m.geosetAnimations.length,0);
+const nodes=new Map(m.bones.map(b=>[b.objectId,b])),used=new Map(m.bones.map(b=>[b.objectId,new Set()]));
+m.geosets.forEach((g,gi)=>{let offset=0;const groups=Array.from(g.matrixGroups,n=>{const ids=Array.from(g.matrixIndices.subarray(offset,offset+n));offset+=n;return ids;});
+ for(const vi of g.faces){assert(vi<g.vertices.length/3);const group=groups[g.vertexGroups[vi]];assert(group?.length);for(let id of group){const seen=new Set();while(id!==-1){assert(nodes.has(id));assert(!seen.has(id),'bone parent cycle');seen.add(id);used.get(id).add(gi);id=nodes.get(id).parentId;}}}
+});
+for(const b of m.bones){assert.deepEqual([...used.get(b.objectId)],[0],b.name+' does not resolve solely to geoset 0');assert.equal(b.geosetId,0);assert.equal(b.geosetAnimationId,-1);}
+assert(data.equals(Buffer.from(m.saveMdx())),'binary roundtrip changed');const s=sanity(m);assert.equal(s.errors,0);assert.equal(s.severe,0);assert.equal(s.warnings,0);
+console.log(JSON.stringify({status:'PASS: all 25 bone influence/ancestor dependencies resolve solely to geoset 0',vertices:m.geosets[0].vertices.length/3,bones:m.bones.map(b=>({id:b.objectId,name:b.name,dependencies:[...used.get(b.objectId)]})),sanity:{errors:s.errors,severe:s.severe,warnings:s.warnings},nativeRenderingVerified:false},null,2));
