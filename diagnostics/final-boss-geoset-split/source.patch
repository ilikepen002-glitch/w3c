+}
+function main(){
+const report={status:'OFFLINE PASS: diagnostic candidate only',native127aTested:false,productionManifestUpdated:false,models:[]};
+for(const [name,folder,expected]of[['EclipseSpellweaver','eclipse-spellweaver-v3','b19878db04cfef6dc053d6443281e312f95ff1375dd3f4a38007a29c7ea90406'],['UncrownedAbyssKing','uncrowned-abyss-king','f736e64c9d238e60dfc7fb0fb5040fae5563aaa51df592f9cf9d4bc972ac974e']]){
+ const original=path.join(ROOT,'assets/source',folder,'original',name+'.mdx'),target=path.join(ROOT,'imports/war3mapImported',name+'.mdx'),src=fs.existsSync(original)?fs.readFileSync(original):execFileSync('python3',['-c',"import sys,subprocess;sys.path.insert(0,'tools');from GenerateTowerTerrainMask import Mpq;sys.stdout.buffer.write(Mpq(subprocess.check_output(['git','show','a8094440:ExampleMap.w3x'])).extract(sys.argv[1]))",'war3mapImported\\'+name+'.mdx'],{cwd:ROOT,maxBuffer:16*1024*1024});assert.equal(hash(src),expected,'frozen input changed');const generated=Buffer.from(split(parse(src)).saveMdx()),checks=verify(src,generated);
