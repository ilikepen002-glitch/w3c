+ * Without --write, verifies the already-generated imports against frozen sources.
+ * Frozen original MDX, source geometry, manifests, materials and animations stay intact.
+ */
+const fs=require('fs'),path=require('path'),assert=require('assert'),crypto=require('crypto');
+const {execFileSync}=require('child_process');
+const runtime=process.env.MDX_PARSER_RUNTIME;
