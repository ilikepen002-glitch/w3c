+}
+const reportPath=path.join(ROOT,'diagnostics/final-boss-geoset-split/offline-report.json');fs.mkdirSync(path.dirname(reportPath),{recursive:true});fs.writeFileSync(reportPath,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report,null,2));
