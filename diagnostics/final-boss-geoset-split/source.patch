+boolean bossMeshMoveRight = false
+
+function bossMeshReport(string message)
+	DisplayTimedTextToPlayer(Player(0), 0, 0, 30.0, "|cffffcc00[Boss网格拆分测试，非正式闯关]|r " + message)
+
+function bossMeshClear()
+	if bossMeshFixture != null
+		RemoveUnit(bossMeshFixture)
+		bossMeshFixture = null
+	bossMeshMoveRight = false
+
+function bossMeshFocus()
+	if GetLocalPlayer() == Player(0) and bossMeshFixture != null
+		PanCameraToTimed(GetUnitX(bossMeshFixture), GetUnitY(bossMeshFixture), 0.0)
+
+function bossMeshCreate(int rawcode)
+	bossMeshClear()
+	bossMeshFixture = CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), rawcode, -2048.0, 1024.0, 270.0)
+	SetUnitInvulnerable(bossMeshFixture, true)
+	SetUnitPathing(bossMeshFixture, false)
+	SetUnitAnimationByIndex(bossMeshFixture, 0)
+	bossMeshFocus()
+	bossMeshReport("已展示模型。-boss stand/walk/attack/hit/death/portrait；-boss move/turn/focus/clear。attack对蚀月播放Spell，对深渊播放Attack。")
+
+function bossMeshAnimation(int index)
+	IssueImmediateOrder(bossMeshFixture, "stop")
+	SetUnitAnimationByIndex(bossMeshFixture, index)
+	bossMeshReport("动作序号 " + I2S(index) + "；0待机/1行走/2施法或攻击/3受击/4死亡/5肖像。可再次输入重播。")
+
+function bossMeshCommand()
+	let text = GetEventPlayerChatString()
+	if text == "-boss24"
+		bossMeshCreate('uB24')
+	else if text == "-boss32"
+		bossMeshCreate('uB32')
+	else if text == "-boss clear"
+		bossMeshClear()
+		bossMeshReport("测试单位已清理。")
+	else if text == "-boss" or text == "-boss help"
+		bossMeshReport("P1输入 -boss24 或 -boss32 立即展示；-boss stand/walk/attack/spell/hit/death/portrait/move/turn/focus/clear。此图仅检验候选渲染，不证明修复。")
+	else if bossMeshFixture == null
+		bossMeshReport("先输入 -boss24 或 -boss32。")
+	else if text == "-boss stand"
+		bossMeshAnimation(0)
+	else if text == "-boss walk"
+		bossMeshAnimation(1)
+	else if text == "-boss attack" or text == "-boss spell"
+		bossMeshAnimation(2)
+	else if text == "-boss hit"
+		bossMeshAnimation(3)
+	else if text == "-boss death"
+		bossMeshAnimation(4)
+	else if text == "-boss portrait"
+		bossMeshAnimation(5)
+	else if text == "-boss turn"
+		IssueImmediateOrder(bossMeshFixture, "stop")
+		SetUnitFacing(bossMeshFixture, GetUnitFacing(bossMeshFixture) + 90.0)
+	else if text == "-boss move"
+		bossMeshMoveRight = not bossMeshMoveRight
+		var x = -2448.0
+		if bossMeshMoveRight
+			x = -1648.0
+		IssuePointOrder(bossMeshFixture, "move", x, 1024.0)
+	else if text == "-boss focus"
+		bossMeshFocus()
+	else
+		bossMeshReport("未知命令；输入 -boss help。")
+
+init
+	if not compiletime
+		let chat = CreateTrigger()
+		TriggerRegisterPlayerChatEvent(chat, Player(0), "-boss", false)
+		chat.addAction(function bossMeshCommand)
