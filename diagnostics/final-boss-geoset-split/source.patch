+ const sn=sanity(m);assert.equal(sn.errors,0);assert.equal(sn.severe,0);assert.equal(sn.warnings,0);const sampleOld=sampler(old),sampleNew=sampler(m),animations=[];
+ for(let si=0;si<m.sequences.length;si++){const s=m.sequences[si],times=new Set(Array.from({length:101},(_,i)=>s.interval[0]+(s.interval[1]-s.interval[0])*i/100));for(const n of [...m.bones,...m.helpers])for(const an of n.animations)for(const t of an.frames)if(t>=s.interval[0]&&t<=s.interval[1])times.add(t);let min=[Infinity,Infinity,Infinity],max=[-Infinity,-Infinity,-Infinity],maxEdge=0;
