+ return(si,time)=>{const matrices=new Map();function node(id){if(matrices.has(id))return matrices.get(id);const n=nodes.get(id),t=vec3.create(),q=new Float32Array([0,0,0,1]),sc=new Float32Array([1,1,1]);for(const [tag,out]of[['KGTR',t],['KGRT',q],['KGSC',sc]])tracks.get(id)[tag]?.getValue(out,si,time,time-m.sequences[si].interval[0]);const a=mat4.create();mat4.fromRotationTranslationScaleOrigin(a,q,t,sc,m.pivotPoints[id]);if(n.parentId!==-1)mat4.mul(a,node(n.parentId),a);matrices.set(id,a);return a;}
+ const corners=[];for(let j=0;j<m.geosets.length;j++){const g=m.geosets[j],vs=[];for(let i=0;i<g.vertexGroups.length;i++){const v=vec3.create(),ids=gs[j][g.vertexGroups[i]];for(const id of ids){const p=vec3.create();vec3.transformMat4(p,g.vertices.subarray(i*3,i*3+3),node(id));vec3.add(v,v,p);}vec3.scale(v,v,1/ids.length);vs.push(...v);}for(const i of g.faces)corners.push(...vs.slice(i*3,i*3+3));}return corners;
+ };}
+function verify(source,candidate){const old=parse(source),m=parse(candidate),a=chunks(source),b=chunks(candidate);assert.deepEqual(Object.keys(a),Object.keys(b));for(const k of Object.keys(a))if(k!=='GEOS')assert(a[k].equals(b[k]),'unrelated chunk '+k);assert.equal(Buffer.compare(candidate,Buffer.from(m.saveMdx())),0);assert.deepEqual(corners(old),corners(m));assert(m.geosets.every(g=>g.vertices.length/3<=MAX&&g.faces.length%3===0));
