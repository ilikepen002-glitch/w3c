+const base=path.join(runtime,'mdx-m3-viewer/src');
+const Model=require(base+'/parsers/mdlx/model.ts').default,Geoset=require(base+'/parsers/mdlx/geoset.ts').default;
+const sanity=require(base+'/utils/mdlx/sanitytest/sanitytest.ts').default;
+const {createTypedSd}=require(base+'/viewer/handlers/mdx/sd.ts');
+const {mat4,vec3}=require(path.join(runtime,'gl-matrix'));
+const ROOT=path.resolve(__dirname,'..'),MAX=3000;
+const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
+function parse(b){const m=new Model();m.load(new Uint8Array(b));return m;}
+function chunks(b){let p=4,r={};while(p<b.length){const k=b.toString('ascii',p,p+4),n=b.readUInt32LE(p+4);r[k]=b.subarray(p+8,p+8+n);p+=8+n;}assert.equal(p,b.length);return r;}
+function groups(g){let off=0;return Array.from(g.matrixGroups,n=>{const ids=Array.from(g.matrixIndices.subarray(off,off+n));off+=n;return ids;});}
+function corners(m){return m.geosets.flatMap(g=>{const gs=groups(g);return Array.from(g.faces,i=>[...g.vertices.subarray(i*3,i*3+3),...g.normals.subarray(i*3,i*3+3),...g.uvSets.flatMap(u=>Array.from(u.subarray(i*2,i*2+2))),gs[g.vertexGroups[i]]]);});}
+function split(m){assert.equal(m.version,800);assert.equal(m.geosets.length,1);const old=m.geosets[0];assert.equal(old.skin.length,0);assert.deepEqual(Array.from(old.faceTypeGroups),[4]);assert.equal(old.faces.length%3,0);const out=[];
+ for(let start=0;start<old.faces.length;start+=MAX){const ix=Array.from(old.faces.subarray(start,Math.min(start+MAX,old.faces.length))),g=new Geoset();g.vertices=new Float32Array(ix.flatMap(i=>Array.from(old.vertices.subarray(i*3,i*3+3))));g.normals=new Float32Array(ix.flatMap(i=>Array.from(old.normals.subarray(i*3,i*3+3))));g.uvSets=old.uvSets.map(u=>new Float32Array(ix.flatMap(i=>Array.from(u.subarray(i*2,i*2+2)))));g.vertexGroups=new Uint8Array(ix.map(i=>old.vertexGroups[i]));g.faces=new Uint16Array(ix.map((_,i)=>i));g.faceTypeGroups=new Uint32Array([4]);g.faceGroups=new Uint32Array([ix.length]);g.matrixGroups=old.matrixGroups.slice();g.matrixIndices=old.matrixIndices.slice();g.materialId=old.materialId;g.selectionGroup=old.selectionGroup;g.selectionFlags=old.selectionFlags;g.extent=old.extent;g.sequenceExtents=old.sequenceExtents;out.push(g);
