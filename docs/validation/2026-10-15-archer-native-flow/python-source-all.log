lse\n\treturn true\n\nfunction tdHandleTowerSelected()\n\tlet tower = GetTriggerUnit()\n\ttdEvolutionSelectionChanged(GetTriggerPlayer(), tower)\n\tif tower == null or tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower)) == 0\n\t\treturn\n\ttdShowTowerRangeIndicatorForPlayer(GetTriggerPlayer(), tower)\n\nfunction tdHandleTowerDeselected()\n\tlet tower = GetTriggerUnit()\n\ttdEvolutionDeselected(GetTriggerPlayer(), tower)\n\tlet playerId = GetPlayerId(GetTriggerPlayer())\n\tif tdValidRangeIndicatorPlayerId(playerId) and tdTowerRangeIndicatorTowers[playerId] == tower\n\t\ttdClearTowerRangeIndicator(playerId)\n\nfunction tdHandleTowerEquipmentVisualChanged()\n\tlet tower = GetManipulatingUnit()\n\tif tower == null or tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower)) == 0\n\t\treturn\n\t// 装备事件里反复销毁/重建范围图片会放大内存抖动；改为清掉旧图，等下次选中时再按最新范围重建。\n\ttdClearTowerRangeIndicatorsForTower(tower)\n\n// 虽然名字还是 createPads，但目前这里实际做的是给每个玩家生成建造农民。\n// 玩家就是通过这个农民的建造菜单来放置 1 阶塔。\npublic function tdCreatePads()\n\tfor playerId = 0 to TD_ACTIVE_PLAYER_COUNT - 1\n\t\tif tdIsLaneActive(playerId)\n\t\t\ttdFarmers[playerId] = createUnit(Player(playerId), TD_FARMER_UNIT_ID, tdFarmerSpawnPosition(playerId), 0 .fromDeg())\n\t\t\tif tdFarmersShouldBeInvulnerable()\n\t\t\t\ttdFarmers[playerId].setInvulnerable(true)\n\t\t\ttdAlignPlayerTowerPopulation(playerId)\n\t\telse\n\t\t\ttdFarmers[playerId] = null\n\n// 预留给“对话框式建造 UI”的启动入口。\n// 当前原型直接用农民自带的建造菜单，所以这里先留空。\npublic function tdSetupBuildDialog()\n\n// 预留给塔位选择逻辑的启动入口。\npublic function tdSetupPadSelection()\n\tif tdTowerSelectionEventsReady\n\t\treturn\n\ttdTowerSelectionEventsReady = true\n\ttdTowerSelectionTrigger.registerAnyUnitEvent(EVENT_PLAYER_UNIT_SELECTED)\n\ttdTowerDeselectionTrigger.registerAnyUnitEvent(EVENT_PLAYER_UNIT_DESELECTED)\n\ttdTowerSelectionTrigger.addAction(function tdHandleTowerSelected)\n\ttdTowerDeselectionTrigger.addAction(function tdHandleTowerDeselected)\n\nfunction tdApplyTowerPersistentState(unit tower)\n\tif tower == null\n\t\treturn\n\ttower.setInvulnerable(tdTowersShouldBeInvulnerable())\n\nfunction tdHandleTowerConstructionStarted()\n\tlet tower = GetConstructingStructure()\n\tif tower == null or tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower)) == 0\n\t\treturn\n\ttdGetTowerSaleState(tower).startWork()\n\ttdTargetPriorityTrackTower(tower)\n\ttdTargetPriorityWorkStarted(tower)\n\ttdAuraSetProviderCandidate(tower, true)\n\ttdCombatVisualSuspendGear(tower)\n\ttdEvolutionWorkStarted(tower)\n\ttdPetHeroTowerInvalidated(tower)\n\ttdPetTowerWorkStarted(tower)\n\ttdValidateTowerConstruction(tower)\n\nfunction tdHandleTowerConstructionFinished()\n\tlet tower = GetConstructedStructure()\n\tif tower == null or tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower)) == 0\n\t\treturn\n\ttdGetTowerSaleState(tower).finishWork()\n\ttdTargetPriorityTrackTower(tower)\n\ttdTargetPriorityWorkFinished(tower)\n\ttdCombatVisualResumeGear(tower)\n\ttdPetTowerWorkFinished(tower)\n\ttdEvolutionWorkFinished(tower)\n\ttdDamageTrackTower(tower)\n\ttdApplyTowerPersistentState(tower)\n\ttdEvolutionRefresh(tower)\n\ttdRefreshTowerEquipmentBonuses(tower)\n\ttdInitializeBloodlustAutocast(tower)\n\ttdAlignPlayerTowerPopulation(GetPlayerId(GetOwningPlayer(tower)))\n\nfunction tdHandleTowerConstructionCancelled()\n\tlet tower = GetCancelledStructure()\n\tif tower == null or tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower)) == 0\n\t\treturn\n\t// Native cancellation owns the refund and removes the building after this\n\t// event. Reconcile food afterward; do not manually refund or clear another\n\t// tower\'s occupancy. Retain only playerId, not the soon-removed unit handle.\n\tlet playerId = GetPlayerId(GetOwningPlayer(tower))\n\ttdClearTowerSaleState(tower)\n\ttdEvolutionForgetTower(tower)\n\ttdDamageRetireTower(tower)\n\ttdPetHeroTowerInvalidated(tower)\n\ttdPetTowerRemoved(tower)\n\ttdForgetEquipmentTower(tower)\n\ttdForgetEquipmentAbilities(tower)\n\ttdDarkTideForgetTower(tower)\n\ttdForgetBloodlustAutocast(tower)\n\ttdTargetPriorityForget(tower)\n\ttdClearTowerRangeIndicatorsForTower(tower)\n\tdoAfter(0.0) ->\n\t\ttdAlignPlayerTowerPopulation(playerId)\n\n// UpgradeRefundRate=1.0 in war3mapMisc.txt makes the engine refund the full\n// upgrade debit. Never add scripted compensation here (including deferred or\n// duplicate callbacks); construction and tower sale have separate refund rules.\nfunction tdHandleTowerUpgradeCancelled()\n\tlet tower = GetTriggerUnit()\n\tif tower == null or tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower)) == 0\n\t\treturn\n\ttdForgetEquipmentSpecial(tower)\n\tlet key = tower.getHandleId()\n\tlet cancelledGeneration = tdGetTowerSaleState(tower).getWorkGeneration()\n\t// Cancellation restores native unit fields after the event, including range.\n\tdoAfter(0.0) ->\n\t\tif tower == null or not tower.isAlive() or tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower)) == 0\n\t\t\treturn\n\t\tif not tdTowerSaleStates.hasInt(key)\n\t\t\treturn\n\t\tlet state = tdTowerSaleStates.loadInt(key) castTo TDTowerSaleState\n\t\tif not state.finishWorkForGeneration(cancelledGeneration)\n\t\t\treturn\n\t\ttdTargetPriorityTrackTower(tower)\n\t\ttdTargetPriorityWorkFinished(tower)\n\t\ttdCombatVisualResumeGear(tower)\n\t\ttdPetTowerWorkFinished(tower)\n\t\ttdEvolutionWorkFinished(tower)\n\t\ttdRefreshTowerEquipmentBonuses(tower)\n\t\ttdRefreshTowerRangeIndicatorsForTower(tower)\n\t\ttdEvolutionRefresh(tower)\n\t\ttdInitializeBloodlustAutocast(tower)\n\nfunction tdHandleTowerUpgradeFinished()\n\tlet tower = GetTriggerUnit()\n\tif tower == null\n\t\treturn\n\tlet towerChoice = tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower))\n\tif towerChoice == 0\n\t\treturn\n\ttdForgetEquipmentSpecial(tower)\n\ttdGetTowerSaleState(tower).finishWork()\n\ttdTargetPriorityTrackTower(tower)\n\ttdTargetPriorityWorkFinished(tower)\n\ttdCombatVisualResumeGear(tower)\n\ttdPetTowerWorkFinished(tower)\n\ttdEvolutionWorkFinished(tower)\n\ttdDamageTrackTower(tower)\n\ttdApplyTowerPersistentState(tower)\n\ttdEvolutionRefresh(tower)\n\ttdRefreshTowerEquipmentBonuses(tower)\n\ttdRefreshTowerRangeIndicatorsForTower(tower)\n\ttdInitializeBloodlustAutocast(tower)\n\ttdAlignPlayerTowerPopulation(GetPlayerId(GetOwningPlayer(tower)))\n\nfunction tdHandleTowerEvolutionCast() returns boolean\n\ttdEvolutionRequest(GetTriggerUnit(), GetTriggerPlayer())\n\treturn false\n\nfunction tdHandleTowerOwnershipChanged()\n\ttdEvolutionOwnershipChanged(GetTriggerUnit())\n\nfunction tdHandleTowerDeath()\n\tlet tower = GetTriggerUnit()\n\tif tower == null or tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower)) == 0\n\t\treturn\n\ttdClearTowerRangeIndicatorsForTower(tower)\n\ttdClearOrcBladestormState(tower)\n\ttdClearTowerSaleState(tower)\n\ttdEvolutionForgetTower(tower)\n\ttdDamageRetireTower(tower)\n\ttdPetHeroTowerInvalidated(tower)\n\ttdPetTowerRemoved(tower)\n\ttdForgetEquipmentTower(tower)\n\ttdForgetEquipmentAbilities(tower)\n\ttdDarkTideForgetTower(tower)\n\ttdForgetBloodlustAutocast(tower)\n\ttdTargetPriorityForget(tower)\n\ttdAlignPlayerTowerPopulation(GetPlayerId(GetOwningPlayer(tower)))\n\nfunction tdOrcBladestormStateKey(unit tower) returns int\n\treturn tower.getHandleId()\n\nfunction tdOrcBladestormIsActive(unit tower) returns boolean\n\treturn tower != null and tdOrcBladestormStates.hasBoolean(tdOrcBladestormStateKey(tower))\n\nfunction tdClearOrcBladestormState(unit tower)\n\tif not tdOrcBladestormIsActive(tower)\n\t\treturn\n\ttdOrcBladestormStates.removeBoolean(tdOrcBladestormStateKey(tower))\n\ttdTargetPriorityCasting(tower, false)\n\ttdPetHeroCancelStorm(tower)\n\ttower.removeAnimationProperties("spin")\n\tif tower.isAlive()\n\t\ttower.setAnimation("stand")\n\nfunction tdPulseOrcBladestorm(unit tower, tdTrialCombatContext context)\n\tif tower == null or not tower.isAlive()\n\t\treturn\n\tlet center = tower.getPos()\n\tlet ownerPlayerId = GetPlayerId(GetOwningPlayer(tower))\n\tlet damagePerTick = tdOrcBladestormDamagePerSecond() * tdOrcBladestormTickInterval()\n\tlet g = CreateGroup()\n\tg.enumUnitsInRange(center, tdOrcBladestormRadius())\n\tfor victim in g\n\t\tif tdTrialAoeTargetContextValid(victim, ownerPlayerId, context) and victim.isAlive() and GetOwningPlayer(victim) == Player(TD_ENEMY_PLAYER_ID) and tdEnemyLaneId(victim) == ownerPlayerId\n\t\t\tDamageEvent.setNextDamageFromCode()\n\t\t\ttower.damageTarget(victim, tdEnemyMechanicScaleSpellDamage(victim, damagePerTick))\n\tg.destr()\n\nfunction tdHandleOrcBladestormCast() returns boolean\n\tlet tower = GetTriggerUnit()\n\tif tower == null or tdOrcBladestormIsActive(tower)\n\t\treturn false\n\tlet key = tdOrcBladestormStateKey(tower)\n\tlet pulseCount = (tdOrcBladestormDuration() / tdOrcBladestormTickInterval() + 0.5).toInt()\n\ttdOrcBladestormStates.saveBoolean(key, true)\n\ttdTargetPriorityTrackTower(tower)\n\ttdTargetPriorityCasting(tower, true)\n\t// The classic Blademaster embeds its blade trail in Attack Walk Stand Spin.\n\ttower.addAnimationProperties("spin")\n\ttower.setAnimation("stand spin")\n\tlet context = tdTrialCurrentContext()\n\tlet heroStorm = tdPetHeroCaptureStorm(tower, context)\n\tdoPeriodicallyCounted(tdOrcBladestormTickInterval(), pulseCount) cb ->\n\t\tif not tdTrialContextValid(context) or not tdOrcBladestormIsActive(tower) or not tower.isAlive()\n\t\t\ttdClearOrcBladestormState(tower)\n\t\t\tdestroy cb\n\t\telse\n\t\t\ttdPulseOrcBladestorm(tower, context)\n\t\t\tif cb.isLast()\n\t\t\t\ttdPetHeroCompleteStorm(tower, heroStorm)\n\t\t\t\ttdClearOrcBladestormState(tower)\n\t\t\t\tdestroy cb\n\treturn false\n\nfunction tdHandleGhoulCorpseExplosionDamage()\n\tif DamageEvent.isSpell() or DamageEvent.isCode()\n\t\treturn\n\tlet source = DamageEvent.getSource()\n\tlet target = DamageEvent.getTarget()\n\tif source == null or target == null or tdTowerChoiceForUnitTypeId(GetUnitTypeId(source)) != TD_TOWER_CHOICE_GHOUL\n\t\treturn\n\t// Trial abnormal death never becomes a corpse-explosion/drop farming source.\n\tif GetUnitTypeId(target) == 0 or tdTrialIsTargetType(target)\n\t\treturn\n\tif source.getAbilityLevel(TD_GHOUL_CORPSE_EXPLOSION_DISPLAY_ABILITY_ID) <= 0\n\t\treturn\n\tlet maxLife = GetUnitState(target, UNIT_STATE_MAX_LIFE)\n\tif maxLife <= 0.405 or target.getLife() / maxLife > tdGhoulCorpseExplosionLifeThreshold()\n\t\treturn\n\tif target.getLife() > DamageEvent.getAmount() + 0.405\n\t\treturn\n\tlet center = target.getPos()\n\tlet laneId = tdEnemyLaneId(target)\n\tlet g = CreateGroup()\n\tg.enumUnitsInRange(center, tdGhoulCorpseExplosionRadius())\n\tfor victim in g\n\t\tif victim != target and victim.isAlive() and GetOwningPlayer(victim) == Player(TD_ENEMY_PLAYER_ID) and tdEnemyLaneId(victim) == laneId\n\t\t\tDamageEvent.setNextDamageFromCode()\n\t\t\tsource.damageTarget(victim, tdEnemyMechanicScaleSpellDamage(victim, tdGhoulCorpseExplosionDamageForBranch(tdTowerLevelForUnitTypeId(GetUnitTypeId(source)), tdTowerBranchForUnitTypeId(GetUnitTypeId(source)), tdTowerIsEvolved(source))))\n\tg.destr()\n\ttdPetHeroOnCorpseExplosionSettled(source, target, center)\n\tlet corpseExplosionEffect = AddSpecialEffect("Abilities\\\\Spells\\\\Undead\\\\DeathandDecay\\\\DeathandDecayDamage.mdl", center.x, center.y)\n\tDestroyEffect(corpseExplosionEffect)\n\nfunction tdArcherSplitArrowFlightTime(unit source, unit target) returns real\n\tlet projectileSpeed = tdTowerProjectileSpeed(TD_TOWER_CHOICE_ARCHER).toReal()\n\tif source == null or target == null or projectileSpeed <= 0.405\n\t\treturn 0.0\n\tlet distance = source.getPos().distanceTo(target.getPos())\n\treturn distance / projectileSpeed\n\n// Every selected extra shot owns a visible arrow; shared timing only, no admission cap.\nclass TDArcherArrowVisual\n\tFx fx\n\tvec3 startPos\n\tvec3 endPos\n\treal elapsed = 0.0\n\treal duration\n\tint epoch\n\n\tconstruct(unit source, unit target, real duration)\n\t\tthis.startPos = source.getPos().withTerrainZ(90.0)\n\t\tthis.endPos = target.getPos().withTerrainZ(60.0)\n\t\tthis.duration = RMaxBJ(0.03, duration)\n\t\tepoch = tdFlowEpoch()\n\t\tfx = new Fx(startPos.toVec2(), source.getPos().angleTo(target.getPos()))\n\t\tfx.setXYZ(startPos, false)\n\t\tfx.setFx(tdTowerProjectileArt(TD_TOWER_CHOICE_ARCHER))\n\n\tondestroy\n\t\tdestroy fx\n\nLinkedList<TDArcherArrowVisual> tdArcherArrowVisuals = new LinkedList<TDArcherArrowVisual>()\nboolean tdArcherVisualTimerRunning = false\n\nfunction tdLaunchArcherSplitArrowVisual(unit source, unit target, real duration)\n\tif source == null or target == null\n\t\treturn\n\ttdArcherArrowVisuals.add(new TDArcherArrowVisual(source, target, duration))\n\tif tdArcherVisualTimerRunning\n\t\treturn\n\ttdArcherVisualTimerRunning = true\n\t// One timer for all arrows, including volleys from several high-speed towers.\n\tdoPeriodically(0.03) cb ->\n\t\tlet itr = tdArcherArrowVisuals.iterator()\n\t\twhile itr.hasNext()\n\t\t\tlet arrow = itr.next()\n\t\t\tif arrow.epoch != tdFlowEpoch()\n\t\t\t\titr.remove()\n\t\t\t\tdestroy arrow\n\t\t\t\tcontinue\n\t\t\tarrow.elapsed += 0.03\n\t\t\tlet progress = RMinBJ(1.0, arrow.elapsed / arrow.duration)\n\t\t\tarrow.fx.setXYZ(arrow.startPos + (arrow.endPos - arrow.startPos) * progress, false)\n\t\t\tif progress >= 1.0\n\t\t\t\titr.remove()\n\t\t\t\tdestroy arrow\n\t\titr.close()\n\t\tif tdArcherArrowVisuals.isEmpty()\n\t\t\ttdArcherVisualTimerRunning = false\n\t\t\tdestroy cb\n\nfunction tdFindFarthestArcherSplitArrowShot(LinkedList<TDArcherSplitArrowShot> shots) returns TDArcherSplitArrowShot\n\tTDArcherSplitArrowShot farthestShot = null\n\tvar farthestFlightTime = -1.0\n\tfor shot in shots\n\t\tif shot != null and shot.flightTime > farthestFlightTime\n\t\t\tfarthestShot = shot\n\t\t\tfarthestFlightTime = shot.flightTime\n\treturn farthestShot\n\nfunction tdTryAddArcherSplitArrowShot(LinkedList<TDArcherSplitArrowShot> shots, unit source, unit victim, int maxTargetCount, real distance)\n\tif shots == null or source == null or victim == null or maxTargetCount <= 0\n\t\treturn\n\tlet projectileSpeed = tdTowerProjectileSpeed(TD_TOWER_CHOICE_ARCHER).toReal()\n\tlet flightTime = projectileSpeed <= 0.405 ? 0.0 : distance / projectileSpeed\n\tif shots.size() < maxTargetCount\n\t\tshots.add(new TDArcherSplitArrowShot(victim, flightTime))\n\t\treturn\n\tlet farthestShot = tdFindFarthestArcherSplitArrowShot(shots)\n\tif farthestShot != null and flightTime < farthestShot.flightTime\n\t\tif shots.remove(farthestShot)\n\t\t\tdestroy farthestShot\n\t\tshots.add(new TDArcherSplitArrowShot(victim, flightTime))\n\t\treturn\n\nfunction tdArcherSplitArrowVolleyExpireDelay(TDArcherSplitArrowVolley volley) returns real\n\tif volley == null\n\t\treturn 0.35\n\tvar expireDelay = volley.primaryFlightTime + 0.35\n\tfor shot in volley.extraShots\n\t\tif shot != null and shot.flightTime + 0.35 > expireDelay\n\t\t\texpireDelay = shot.flightTime + 0.35\n\treturn expireDelay\n\nfunction tdCreateArcherSplitArrowVolley(unit source, unit primaryTarget) returns TDArcherSplitArrowVolley\n\tif source == null or primaryTarget == null or tdTowerChoiceForUnitTypeId(GetUnitTypeId(source)) != TD_TOWER_CHOICE_ARCHER\n\t\treturn null\n\tif source.getAbilityLevel(TD_ARCHER_SPLIT_ARROW_ABILITY_ID) <= 0\n\t\treturn null\n\tlet level = tdTowerLevelForUnitTypeId(GetUnitTypeId(source))\n\tlet remainingTargets = tdArcherSplitArrowTargetCount(level) - 1 + tdEquipmentArcherAdditionalArrows(source)\n\tif remainingTargets <= 0\n\t\treturn null\n\tlet laneId = tdEnemyLaneId(primaryTarget)\n\tlet sourcePos = source.getPos()\n\tlet searchRange = tdTowerEffectiveRangeForTower(source)\n\tlet primaryFlightTime = tdArcherSplitArrowFlightTime(source, primaryTarget)\n\tlet g = CreateGroup()\n\tlet extraShots = new LinkedList<TDArcherSplitArrowShot>()\n\tg.enumUnitsInRange(sourcePos, searchRange)\n\tfor victim in g\n\t\tif victim != primaryTarget and victim.isAlive() and GetOwningPlayer(victim) == Player(TD_ENEMY_PLAYER_ID) and tdEnemyLaneId(victim) == laneId\n\t\t\tlet distance = sourcePos.distanceTo(victim.getPos())\n\t\t\tif distance <= searchRange + 0.405\n\t\t\t\ttdTryAddArc