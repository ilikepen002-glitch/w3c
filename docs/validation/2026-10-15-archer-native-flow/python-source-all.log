rmers[playerId]\n\n// Native building pathing owns occupancy. Read live units rather than keeping a\n// second reservation table: construction, upgrades, death and RemoveUnit cannot\n// leave stale cells, and another owner\'s unfinished tower also blocks placement.\npublic function tdTowerBlocksPlacement(vec2 candidatePosition, vec2 otherPosition, boolean sameUnit, boolean alive, int otherTypeId) returns boolean\n\treturn not sameUnit and alive and tdTowerChoiceForUnitTypeId(otherTypeId) != 0 and tdTowerFootprintsOverlap(candidatePosition, otherPosition)\n\nfunction tdTowerOverlapsAnotherTower(unit tower) returns boolean\n\tlet nearby = CreateGroup()\n\tnearby.enumUnitsInRect(boundRect)\n\tvar overlaps = false\n\tfor other from nearby\n\t\tif tdTowerBlocksPlacement(tower.getPos(), other.getPos(), other == tower, other.isAlive(), GetUnitTypeId(other))\n\t\t\toverlaps = true\n\tnearby.destr()\n\treturn overlaps\n\nfunction tdCountPlayerTowerEnum()\n\tlet tower = GetEnumUnit()\n\tif tower != null and tower.isAlive() and GetOwningPlayer(tower) == Player(tdTowerCountPlayerId) and tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower)) != 0\n\t\ttdTowerCountResult += 1\n\nfunction tdCountLivingPlayerTowers(int playerId) returns int\n\ttdTowerCountPlayerId = playerId\n\ttdTowerCountResult = 0\n\tlet g = CreateGroup()\n\tg.enumUnitsInRect(boundRect)\n\tForGroup(g, function tdCountPlayerTowerEnum)\n\tg.destr()\n\treturn tdTowerCountResult\n\nfunction tdAlignPlayerTowerPopulation(int playerId)\n\tif compiletime or not tdIsLanePlayer(playerId)\n\t\treturn\n\tSetPlayerState(Player(playerId), PLAYER_STATE_RESOURCE_FOOD_CAP, tdGetTowerPopulationLimit())\n\tSetPlayerState(Player(playerId), PLAYER_STATE_RESOURCE_FOOD_USED, tdCountLivingPlayerTowers(playerId))\n\nfunction tdRejectTowerConstruction(unit tower, int playerId, int towerChoice, string message)\n\t// RemoveUnit does not use native cancellation/refund. A duplicate callback\n\t// sees typeId 0 and cannot credit the base build cost