package TDCraftingTests
import TDCrafting
import TDInventory
import TDItems

@Test function craftingAcceptsOnlyThreeSameQualitiesBelowPurple()
	tdCraftModeForQualities(1, 1, 1).assertEquals(TD_CRAFT_MODE_THREE)
	tdCraftModeForQualities(1, 1, 2).assertEquals(TD_CRAFT_MODE_NONE)
	tdCraftModeForQualities(1, 1, 0).assertEquals(TD_CRAFT_MODE_NONE)
	tdCraftModeForQualities(1, 2, 3).assertEquals(TD_CRAFT_MODE_NONE)
	tdCraftModeForQualities(4, 4, 4).assertEquals(TD_CRAFT_MODE_NONE)

@Test function craftingConsumesAllThreeValidSlotsAndNoInvalidInputs()
	for slot = 0 to 2
		tdCraftConsumesSlot(1, 1, 1, slot).assertTrue()
		tdCraftConsumesSlot(1, 1, 2, slot).assertFalse()
		tdCraftConsumesSlot(1, 1, 0, slot).assertFalse()
	tdCraftConsumesSlot(1, 1, 1, 3).assertFalse()

@Test function tripleCraftingHasNoGamblingFailure()
	for roll = 1 to 100
		tdCraftSucceeds(TD_CRAFT_MODE_THREE, roll).assertTrue()
	tdCraftSucceeds(TD_CRAFT_MODE_NONE, 1).assertFalse()

@Test function craftingAdvancesOneQualityAndRejectsPurple()
	tdCraftResultQuality(1).assertEquals(2)
	tdCraftResultQuality(2).assertEquals(3)
	tdCraftResultQuality(3).assertEquals(4)
	tdCraftResultQuality(4).assertEquals(0)

@Test function craftingReadsOnlyVisibleFrontThreeSlots()
	tdCraftModeForInventorySlots(TD_ITEM_WHITE_WAR_AXE_ID, TD_ITEM_WHITE_WAR_AXE_ID, TD_ITEM_WHITE_WAR_AXE_ID, 0, 0, 0).assertEquals(TD_CRAFT_MODE_THREE)
	tdCraftModeForInventorySlots(TD_ITEM_WHITE_WAR_AXE_ID, TD_ITEM_WHITE_WAR_AXE_ID, 0, TD_ITEM_GREEN_WAR_AXE_ID, 0, 0).assertEquals(TD_CRAFT_MODE_NONE)

@Test function mixedNamesOfSameQualityRemainValidTriples()
	tdCraftModeForInventorySlots(TD_ITEM_WHITE_SCOPE_ID, TD_ITEM_WHITE_ARMOR_ID, TD_ITEM_WHITE_SWIFT_ID, 0, 0, 0).assertEquals(TD_CRAFT_MODE_THREE)
