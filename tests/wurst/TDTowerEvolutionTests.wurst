package TDTowerEvolutionTests
import TDTowers
import TDWaves
import TDState
import TDPetState

@Test function evolutionEachLaneClaimsOnceAfterRealWave24()
	for lane = 0 to 3
		let state = new TDTowerEvolutionLane()
		state.tryClaim(6, true, false, false).assertFalse()
		for wave = 1 to 23
			state.creditWave(wave, true, true).assertFalse()
		state.creditWave(24, false, true).assertFalse()
		state.creditWave(24, true, false).assertFalse()
		state.creditWave(24, true, true).assertTrue()
		state.creditWave(24, true, true).assertFalse()
		state.tryClaim(5, true, false, false).assertFalse()
		state.tryClaim(6, true, true, false).assertFalse()
		state.tryClaim(6, false, false, false).assertFalse()
		state.tryClaim(6, true, false, true).assertFalse()
		state.isSpent().assertFalse()
		state.tryClaim(6, true, false, false).assertTrue()
		state.creditWave(24, true, true).assertFalse()
		state.tryClaim(6, true, false, false).assertFalse()
		state.isQualified().assertTrue()
		state.isSpent().assertTrue()
		destroy state

function evolutionNewFixture()
	tdResetState()
	tdEvolutionResetForNewMatch()
	for lane = 0 to 3
		tdPetInitializeLane(lane)
		tdSetLaneActive(lane, true)

@Test function evolutionQualificationUsesOwnSettledWaveWithoutTower()
	evolutionNewFixture()
	tdSetGlobalWave(31)
	for lane = 0 to 3
		tdEvolutionCreditWave(lane, 24)
		tdEvolutionLaneQualified(lane).assertFalse()
		tdMarkWaveResolved(lane, 24)
		tdEvolutionCreditWave(lane, 24)
		tdEvolutionLaneQualified(lane).assertTrue()
		tdEvolutionLaneSpent(lane).assertFalse()
		if lane < 3
			tdEvolutionLaneQualified(lane + 1).assertFalse()
	tdEvolutionCreditWave(-1, 24)
	tdEvolutionCreditWave(4, 24)
	tdEvolutionLaneQualified(-1).assertFalse()
	tdEvolutionLaneSpent(4).assertFalse()
	tdEvolutionResetForNewMatch()
	for lane = 0 to 3
		tdEvolutionLaneQualified(lane).assertFalse()

@Test function evolutionQualificationRejectsClosedLaneAndInvalidWaves()
	for mode = 0 to 4
		evolutionNewFixture()
		tdMarkWaveResolved(0, 24)
		if mode == 0
			tdSetLaneActive(0, false)
		else if mode == 1
			tdSetLaneDefeated(0, true)
		else if mode == 2
			tdSetLaneFinished(0, true)
		else if mode == 3
			tdSetGameOver(true)
		else
			tdPetMarkPlayerLeft(0)
		tdEvolutionCreditWave(0, 24)
		tdEvolutionLaneQualified(0).assertFalse()
	evolutionNewFixture()
	for wave = -1 to 33
		if wave != 24
			tdMarkWaveResolved(0, wave)
			tdEvolutionCreditWave(0, wave)
			tdEvolutionLaneQualified(0).assertFalse()

@Test function evolutionCreditsOnlyRealSameLaneTowerKills()
	tdEvolutionKillEligible(true, false, true, 1, 0, 0).assertTrue()
	tdEvolutionKillEligible(true, true, true, 1, 0, 0).assertFalse()
	tdEvolutionKillEligible(false, false, true, 1, 0, 0).assertFalse()
	tdEvolutionKillEligible(true, false, false, 1, 0, 0).assertFalse()
	tdEvolutionKillEligible(true, false, true, 0, 0, 0).assertFalse()
	tdEvolutionKillEligible(true, false, true, 1, 0, 1).assertFalse()

@Test function evolutionPreservesUltimateBranchSkillChoice()
	tdEvolutionSkillReplacement(1, 1).assertEquals(0)
	tdEvolutionSkillReplacement(1, 2).assertEquals(TD_ARCHER_PERFECT_TRUESHOT_ABILITY_ID)
	tdEvolutionSkillReplacement(3, 2).assertEquals(TD_FOOT_EVOLVED_COMMAND_ABILITY_ID)
	tdEvolutionSkillReplacement(4, 2).assertEquals(TD_DRYAD_EVOLVED_SLOW_ABILITY_ID)
	tdEvolutionSkillReplacement(5, 2).assertEquals(0)
	tdEvolutionSkillOriginal(3, 2).assertEquals(TD_FOOT_COMMAND_ABILITY_ID)
	tdEvolutionSkillOriginal(4, 2).assertEquals(TD_DRYAD_WIDE_SLOW_ABILITY_ID)

@Test function evolutionStatisticsRemainExactBeyondThreshold()
	tdEvolutionProgressLevel(0).assertEquals(1)
	tdEvolutionProgressLevel(439).assertEquals(440)
	tdEvolutionProgressLevel(440).assertEquals(441)
	tdEvolutionProgressLevel(441).assertEquals(442)
	tdMatchEnemyCountPerLane().assertEquals(934)
	tdEvolutionProgressLevel(tdMatchEnemyCountPerLane()).assertEquals(935)

@Test function evolutionStatusIsIndependentOfKillsAndLaneIsolation()
	tdEvolutionStatusLevel(false, false, false).assertEquals(1)
	tdEvolutionStatusLevel(true, false, false).assertEquals(2)
	tdEvolutionStatusLevel(true, true, true).assertEquals(3)
	tdEvolutionStatusLevel(true, false, true).assertEquals(4)
	let a = new TDTowerEvolutionLane()
	let b = new TDTowerEvolutionLane()
	a.creditWave(24, true, true).assertTrue()
	a.tryClaim(6, true, false, false).assertTrue()
	b.isQualified().assertFalse()
	b.creditWave(24, true, true).assertTrue()
	b.tryClaim(6, true, false, false).assertTrue()
	destroy a
	destroy b
