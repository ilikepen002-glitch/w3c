package TDSemanticIconTests
import TDConfig
import TDItems
import TDTowers
import TDPetUIData

@Test function semanticWhiteEquipmentIconsMatchEveryPhysicalIdentity()
	tdItemIconPath(TD_ITEM_SHORT_BOW_ID).assertEquals("war3mapImported\\BTNTDItemShortBow.blp")
	tdItemIconPath(TD_ITEM_EAGLE_SCOPE_ID).assertEquals("war3mapImported\\BTNTDItemEagleScope.blp")
	tdItemIconPath(TD_ITEM_COOLING_RUNE_ID).assertEquals("war3mapImported\\BTNTDItemCoolingRune.blp")
	tdItemIconPath(TD_ITEM_STABLE_TOTEM_ID).assertEquals("war3mapImported\\BTNTDItemStableTotem.blp")
	tdItemIconPath(TD_ITEM_ARMOR_SPIKE_ID).assertEquals("war3mapImported\\BTNTDItemArmorSpike.blp")
	tdItemIconPath(TD_ITEM_GOLD_RING_ID).assertEquals("war3mapImported\\BTNTDItemGoldRing.blp")
	tdItemIconPath(TD_ITEM_SCAVENGER_BAG_ID).assertEquals("war3mapImported\\BTNTDItemScavengerBag.blp")
	tdItemIconPath(TD_ITEM_POISON_SAC_ID).assertEquals("war3mapImported\\BTNTDItemPoisonSac.blp")
	tdItemIconPath(TD_ITEM_SWIFT_GLOVES_ID).assertEquals("ReplaceableTextures\\CommandButtons\\BTNGlove.blp")
	tdItemIconPath(TD_ITEM_EXECUTION_DAGGER_ID).assertEquals("ReplaceableTextures\\CommandButtons\\BTNDaggerOfEscape.blp")

