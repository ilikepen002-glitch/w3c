package TDPetUIDataTests
import TDPetUIData
import TDPetData
import TDPetRules

@Test function petFarmerCommandsUseStableSemanticIconPaths()
	tdPetMenuToolsIconPath().assertEquals("war3mapImported\\BTNTDPetMenuTools.blp")
	tdPetCollectionIconPath().assertEquals("war3mapImported\\BTNTDPetCollection.blp")
	tdPetDeployIconPath().assertEquals("war3mapImported\\BTNTDPetDeploy.blp")

@Test function petCollectionCommandsHaveEightDistinctPurposeIcons()
	tdPetUICommandIconPath(0).assertEquals("war3mapImported\\BTNTDPetCollection.blp")
	tdPetUICommandIconPath(1).assertEquals("war3mapImported\\BTNTDPetPrevious.blp")
	tdPetUICommandIconPath(2).assertEquals("war3mapImported\\BTNTDPetNext.blp")
	tdPetUICommandIconPath(3).assertEquals("war3mapImported\\BTNTDPetReturnBuilder.blp")
	tdPetUICommandIconPath(4).assertEquals("war3mapImported\\BTNTDPetDeploy.blp")
	tdPetUICommandIconPath(5).assertEquals("war3mapImported\\BTNTDPetRecall.blp")
	tdPetUICommandIconPath(6).assertEquals("war3mapImported\\BTNTDPetCultivate.blp")
	tdPetUICommandIconPath(7).assertEquals("war3mapImported\\BTNTDPetInfo.blp")
	for command = 0 to 7
		for other = command + 1 to 7
			(tdPetUICommandIconPath(command) != tdPetUICommandIconPath(other)).assertTrue()

@Test function petSpeciesIconsMatchFifteenDistinctFinalPortraits()
	for species = 1 to 15
		let stem = "TDPetSpecies" + (species < 10 ? "0" : "") + species.toString()
		tdPetSpeciesIconPath(species).assertEquals("war3mapImported\\BTN" + stem + ".blp")
		for other = species + 1 to 15
			(tdPetSpeciesIconPath(species) != tdPetSpeciesIconPath(other)).assertTrue()

@Test function petEmptySlotIsIndependentFromBrightAndLockedSkillStates()
	tdPetSlotIconPath(TD_PET_SLOT_EMPTY).assertEquals("war3mapImported\\BTNTDPetEmptySlot.blp")
	for variant = 0 to TD_PET_SKILL_COUNT - 1
		let skill = variant
		tdPetSlotIconPath(variant).assertEquals(tdPetSkillIconPath(skill, false))
		tdPetSlotIconPath(variant + TD_PET_SKILL_COUNT).assertEquals(tdPetSkillIconPath(skill, true))
		(tdPetSlotIconPath(variant) != tdPetSlotIconPath(TD_PET_SLOT_EMPTY)).assertTrue()
		(tdPetSlotIconPath(variant + TD_PET_SKILL_COUNT) != tdPetSlotIconPath(TD_PET_SLOT_EMPTY)).assertTrue()

@Test function petSpeciesQualityBordersAreSixtyDistinctOwnedQualityStates()
	for species = 1 to 15
		for quality = 1 to 4
			let stem = "TDPetSpecies" + (species < 10 ? "0" : "") + species.toString()
			tdPetSpeciesQualityIconPath(species, quality).assertEquals("war3mapImported\\BTN" + stem + "Q" + quality + ".blp")
			for other = quality + 1 to 4
				(tdPetSpeciesQualityIconPath(species, quality) != tdPetSpeciesQualityIconPath(species, other)).assertTrue()

@Test function petPreviewAndReleaseCommandsUseExplicitPurposeArtwork()
	tdPetManagerCommandIconPath(15).assertEquals("war3mapImported\\BTNTDPetRelease.blp")
	tdPetManagerCommandIconPath(17).assertEquals("war3mapImported\\BTNTDPetKeepOld.blp")
	tdPetManagerCommandIconPath(18).assertEquals("war3mapImported\\BTNTDPetUseNew.blp")
	tdPetManagerCommandIconPath(19).assertEquals(tdPetManagerCommandIconPath(15))
	tdPetManagerCommandIconPath(20).assertEquals("war3mapImported\\BTNTDPetKeep.blp")

@Test function activeSpiritIdentitiesUseDistinctPaths()
	for skill = 0 to TD_PET_SKILL_COUNT - 1
		if tdPetSkillDefined(skill)
			for other = skill + 1 to TD_PET_SKILL_COUNT - 1
				if tdPetSkillDefined(other)
					(tdPetSkillIconPath(skill, false) != tdPetSkillIconPath(other, false)).assertTrue()

@Test function customSpiritIconUsesActualImportAndDisabledPaths()
	tdPetSkillIconPath(TD_PET_SKILL_RESOLVE, false).assertEquals("war3mapImported\\BTNTDPetSkillResoluteStrike.blp")
	tdPetSkillIconPath(TD_PET_SKILL_RESOLVE, true).assertEquals("ReplaceableTextures\\CommandButtonsDisabled\\DISBTNTDPetSkillResoluteStrike.blp")
	tdPetSkillIconPath(11, false).assertEquals("ReplaceableTextures\\CommandButtons\\BTNBloodLust.blp")

@Test function openingNewSlotDoesNotReuseRerollActionArtwork()
	tdPetManagerCommandIconPath(14).assertEquals(tdPetSlotIconPath(TD_PET_SLOT_EMPTY))
	for action = 10 to 13
		(tdPetManagerCommandIconPath(action) != tdPetManagerCommandIconPath(14)).assertTrue()
