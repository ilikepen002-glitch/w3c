package TDPetHeroTests
import TDPetHeroRules
import TDPetHeroData
import TDTowerCommonData

@Test function heroIdentitiesAreReservedDistinctAndExactFinalBranches()
	TD_PET_HERO_FIRST.assertEquals(39)
	TD_PET_HERO_LAST.assertEquals(48)
	tdPetHeroDefined(38).assertFalse()
	tdPetHeroDefined(49).assertFalse()
	tdPetHeroHostTypeId(-1).assertEquals(0)
	for skill = TD_PET_HERO_FIRST to TD_PET_HERO_LAST
		tdPetHeroDefined(skill).assertTrue()
		tdPetHeroFitsRawcode(skill, tdPetHeroHostTypeId(skill)).assertTrue()
		tdPetHeroFitsRawcode(skill, 0).assertFalse()
		for other = TD_PET_HERO_FIRST to TD_PET_HERO_LAST
			tdPetHeroFitsRawcode(skill, tdPetHeroHostTypeId(other)).assertEquals(skill == other)
		tdPetHeroFitsRawcode(skill, 'uA5A').assertFalse()
		tdPetHeroFitsRawcode(skill, 'uH5A').assertFalse()
	tdPetHeroHostTypeId(TD_PET_HERO_FROST).assertEquals('uA6A')
	tdPetHeroHostTypeId(TD_PET_HERO_MOON).assertEquals('uA6B')
	tdPetHeroHostTypeId(TD_PET_HERO_BOSS).assertEquals('uO6A')
	tdPetHeroHostTypeId(TD_PET_HERO_STORM).assertEquals('uO6B')
	tdPetHeroHostTypeId(TD_PET_HERO_JUDGEMENT).assertEquals('uH6A')
	tdPetHeroHostTypeId(TD_PET_HERO_RELAY).assertEquals('uH6B')
	tdPetHeroHostTypeId(TD_PET_HERO_POISON).assertEquals('uD6A')
	tdPetHeroHostTypeId(TD_PET_HERO_ROOT).assertEquals('uD6B')
	tdPetHeroHostTypeId(TD_PET_HERO_HUNT).assertEquals('uG6A')
	tdPetHeroHostTypeId(TD_PET_HERO_EPIDEMIC).assertEquals('uG6B')

@Test function heroFourQualityValuesMatchApprovedBudgets()
	for quality = 1 to 4
		((tdPetHeroPower(TD_PET_HERO_FROST, quality) - (0.04 + 0.04 * quality)).abs() < 0.000001).assertTrue()
		((tdPetHeroPower(TD_PET_HERO_MOON, quality) - (0.20 + 0.20 * quality)).abs() < 0.000001).assertTrue()
		((tdPetHeroPower(TD_PET_HERO_BOSS, quality) - (0.03 + 0.03 * quality)).abs() < 0.000001).assertTrue()
		((tdPetHeroPower(TD_PET_HERO_STORM, quality) - (0.50 + 0.50 * quality)).abs() < 0.000001).assertTrue()
		((tdPetHeroPower(TD_PET_HERO_JUDGEMENT, quality) - (0.125 + 0.125 * quality)).abs() < 0.000001).assertTrue()
		tdPetHeroPower(TD_PET_HERO_RELAY, quality).assertEquals(tdPetHeroPower(TD_PET_HERO_JUDGEMENT, quality))
		((tdPetHeroPower(TD_PET_HERO_POISON, quality) - (0.05 + 0.05 * quality)).abs() < 0.000001).assertTrue()
		((tdPetHeroPower(TD_PET_HERO_ROOT, quality) - (0.10 + 0.10 * quality)).abs() < 0.000001).assertTrue()
		((tdPetHeroPower(TD_PET_HERO_HUNT, quality) - (0.10 + 0.10 * quality)).abs() < 0.000001).assertTrue()
		((tdPetHeroPower(TD_PET_HERO_EPIDEMIC, quality) - (0.10 + 0.15 * quality)).abs() < 0.000001).assertTrue()
	for skill = TD_PET_HERO_FIRST to TD_PET_HERO_LAST
		tdPetHeroPower(skill, 0).assertEquals(0.0)
		tdPetHeroPower(skill, 5).assertEquals(0.0)
		tdPetHeroPower(skill, -1).assertEquals(0.0)
	tdPetHeroPower(49, 4).assertEquals(0.0)

@Test function heroCountersCapsAndBaseAttackKindsStayBounded()
	tdPetHeroPrimaryPeriod(TD_PET_HERO_MOON).assertEquals(5)
	tdPetHeroPrimaryPeriod(TD_PET_HERO_POISON).assertEquals(4)
	tdPetHeroPrimaryPeriod(TD_PET_HERO_ROOT).assertEquals(5)
	tdPetHeroPrimaryPeriod(TD_PET_HERO_BOSS).assertEquals(0)
	tdPetHeroTargetCap(TD_PET_HERO_POISON).assertEquals(2)
	tdPetHeroTargetCap(TD_PET_HERO_ROOT).assertEquals(3)
	tdPetHeroTargetCap(TD_PET_HERO_STORM).assertEquals(6)
	tdPetHeroTargetCap(TD_PET_HERO_EPIDEMIC).assertEquals(6)
	tdPetHeroUsesBaseAttack(TD_PET_HERO_JUDGEMENT).assertFalse()
	tdPetHeroUsesBaseAttack(TD_PET_HERO_RELAY).assertTrue()
	tdPetHeroUsesBaseAttack(TD_PET_HERO_POISON).assertTrue()
	tdPetHeroUsesBaseAttack(TD_PET_HERO_ROOT).assertTrue()
	tdPetHeroUsesBaseAttack(TD_PET_HERO_HUNT).assertTrue()
	tdPetHeroLifetime(TD_PET_HERO_FROST).assertEquals(2.0)
	tdPetHeroLifetime(TD_PET_HERO_MOON).assertEquals(3.0)
	tdPetHeroLifetime(TD_PET_HERO_JUDGEMENT).assertEquals(2.0)
	tdPetHeroLifetime(TD_PET_HERO_RELAY).assertEquals(3.0)
	tdPetHeroLifetime(TD_PET_HERO_EPIDEMIC).assertEquals(2.0)
	tdPetHeroRadius(TD_PET_HERO_RELAY).assertEquals(450.0)
	tdPetHeroRadius(TD_PET_HERO_POISON).assertEquals(240.0)
	tdPetHeroRadius(TD_PET_HERO_ROOT).assertEquals(120.0)
	tdPetHeroRadius(TD_PET_HERO_EPIDEMIC).assertEquals(180.0)
	for skill = TD_PET_HERO_FIRST to TD_PET_HERO_LAST
		let spell = skill == 40 or skill == 42 or skill == 44 or skill == 45 or skill == 46 or skill == 48
		tdPetHeroIsSpellDamage(skill).assertEquals(spell)

@Test function weakerSourcesCannotRenewStrongMarksOrSeals()
	tdPetHeroOfferWins(0.4, 1.0, 3.0, 2.9).assertFalse()
	tdPetHeroOfferWins(1.0, 1.0, 3.0, 2.9).assertTrue()
	tdPetHeroOfferWins(1.1, 1.0, 3.0, 2.9).assertTrue()
	tdPetHeroOfferWins(0.4, 1.0, 3.0, 3.0).assertTrue()
	tdPetHeroOfferWins(0.0, 1.0, 3.0, 4.0).assertFalse()
	tdPetHeroOneShotLive(false, 3.0, 2.999).assertTrue()
	tdPetHeroOneShotLive(false, 3.0, 3.0).assertFalse()
	tdPetHeroOneShotLive(true, 3.0, 2.0).assertFalse()

@Test function grantHitCannotConsumeItsOwnSealAndRelayNeedsAnotherSameLaneTower()
	tdPetHeroLaterHit(5, 5).assertFalse()
	tdPetHeroLaterHit(5, 4).assertFalse()
	tdPetHeroLaterHit(5, 6).assertTrue()
	tdPetHeroLaterHit(-1, 1).assertFalse()
	tdPetHeroRelayEligible(10, 11, true, true, true).assertTrue()
	tdPetHeroRelayEligible(10, 10, true, true, true).assertFalse()
	tdPetHeroRelayEligible(0, 11, true, true, true).assertFalse()
	tdPetHeroRelayEligible(10, 0, true, true, true).assertFalse()
	tdPetHeroRelayEligible(10, 11, false, true, true).assertFalse()
	tdPetHeroRelayEligible(10, 11, true, false, true).assertFalse()
	tdPetHeroRelayEligible(10, 11, true, true, false).assertFalse()

@Test function onlyLiveOriginalNormalDeathsCanStartOneGenerationPropagation()
	tdPetHeroDeathCanPropagate(true, false, true, false, 3.0, 2.0).assertTrue()
	tdPetHeroDeathCanPropagate(true, false, false, false, 3.0, 2.0).assertFalse()
	tdPetHeroDeathCanPropagate(false, false, true, false, 3.0, 2.0).assertFalse()
	tdPetHeroDeathCanPropagate(true, true, true, false, 3.0, 2.0).assertFalse()
	tdPetHeroDeathCanPropagate(true, false, true, true, 3.0, 2.0).assertFalse()
	tdPetHeroDeathCanPropagate(true, false, true, false, 3.0, 3.0).assertFalse()

@Test function originalOrdinalIgnoresNestedDerivedDamageAndFailsClosedOnOverflow()
	var serial = tdPetHeroNextSerial(4)
	serial.assertEquals(5)
	let grant = serial
	tdPetHeroSerialEligible(true, false, 0, 100.0).assertFalse()
	tdPetHeroSerialEligible(true, false, 'Pdam', 100.0).assertFalse()
	tdPetHeroSerialEligible(false, true, 0, 100.0).assertFalse()
	tdPetHeroSerialEligible(false, false, 'Tspl', 100.0).assertFalse()
	tdPetHeroSerialEligible(false, false, 'Pdam', 100.0).assertFalse()
	tdPetHeroSerialEligible(false, false, 0, 0.0).assertFalse()
	tdPetHeroLaterHit(grant, serial).assertFalse()
	tdPetHeroSerialEligible(false, false, 0, 100.0).assertTrue()
	serial = tdPetHeroNextSerial(serial)
	tdPetHeroLaterHit(grant, serial).assertTrue()
	tdPetHeroNextSerial(2147483646).assertEquals(2147483647)
	tdPetHeroNextSerial(2147483647).assertEquals(-1)
	tdPetHeroNextSerial(-1).assertEquals(-1)

@Test function pendingJudgementCommitsOnlyItsOriginalAndNeverOverwritesNewerGrant()
	tdPetHeroGrantCanCommit(5, 5).assertTrue()
	tdPetHeroGrantCanCommit(5, 4).assertFalse()
	tdPetHeroGrantCanCommit(5, 6).assertFalse()
	tdPetHeroGrantCanCommit(0, 0).assertFalse()
	tdPetHeroGrantNewer(5, 4).assertTrue()
	tdPetHeroGrantNewer(5, 5).assertFalse()
	tdPetHeroGrantNewer(4, 5).assertFalse()
	tdPetHeroGrantNewer(-1, 0).assertFalse()
	// hit2 consumes seal1, commits seal2 before its native post; hit3 can consume2.
	tdPetHeroLaterHit(1, 2).assertTrue()
	tdPetHeroGrantCanCommit(2, 2).assertTrue()
	tdPetHeroLaterHit(2, 2).assertFalse()
	tdPetHeroLaterHit(2, 3).assertTrue()

@Test function epidemicTooltipUsesCurrentCorpseExplosionDamage()
	for quality = 1 to 4
		let expected = tdGhoulCorpseExplosionDamage() * tdPetHeroPower(TD_PET_HERO_EPIDEMIC, quality)
		((expected - (18.0 + 27.0 * quality)).abs() < 0.0001).assertTrue()
	tdPetHeroDescription(TD_PET_HERO_EPIDEMIC, 1).contains("各受45法术伤害").assertTrue()
	tdPetHeroDescription(TD_PET_HERO_EPIDEMIC, 2).contains("各受72法术伤害").assertTrue()
	tdPetHeroDescription(TD_PET_HERO_EPIDEMIC, 3).contains("各受99法术伤害").assertTrue()
	tdPetHeroDescription(TD_PET_HERO_EPIDEMIC, 4).contains("各受126法术伤害").assertTrue()
