package TDBossSpellResistanceTests
import TDEnemyMechanicData
import TDEnemyMechanicState
import TDState
import TDDamageState

@Test function bossStageCurveScalesExistingChannelExactlyOnce()
	for stage = 1 to 4
		// original lane/wave 0, stage * 8
		let stageBoss = new TDEnemyMechanicState(0, stage * 8, TD_ENEMY_ROLE_BOSS, 240.0)
		let expected = stage == 1 ? 100.0 : (stage == 2 ? 100.0 : (stage == 3 ? 68.0 : 58.0))
		stageBoss.scaledSpellAmount(100.0).assertEquals(expected, 0.000001)
		destroy stageBoss

	// original lane/wave 0, 32
	let boss = new TDEnemyMechanicState(0, 32, TD_ENEMY_ROLE_BOSS, 240.0)
	// An already-native-reduced amount gets only the additional stage factor.
	boss.scaledSpellAmount(75.0).assertEquals(43.5, 0.000001)
	boss.scaledSpellAmount(0.125).assertEquals(0.0725, 0.000001)
	boss.scaledSpellAmount(0.0).assertEquals(0.0)
	boss.scaledSpellAmount(-3.5).assertEquals(-3.5)
	destroy boss


@Test function ordinaryEliteGuardAndInvalidBossWavesPassThrough()
	// original lane/wave 0, 32
	for role = TD_ENEMY_ROLE_NORMAL to TD_ENEMY_ROLE_GUARD
		let state = new TDEnemyMechanicState(0, 32, role, 240.0)
		state.scaledSpellAmount(100.0).assertEquals(100.0)
		destroy state
	let invalidRole = new TDEnemyMechanicState(0, 32, -1, 240.0)
	invalidRole.scaledSpellAmount(100.0).assertEquals(100.0)
	destroy invalidRole

	for wave = -1 to 33
		if not tdEnemyBossSpellResistanceEnabled(wave)
			// original lane/wave 0, wave
			let state = new TDEnemyMechanicState(0, wave, TD_ENEMY_ROLE_BOSS, 240.0)
			state.scaledSpellAmount(100.0).assertEquals(100.0)
			destroy state


@Test function originalBossWaveWinsOverGlobalWaveAndRetiredState()
	tdResetState()
	tdSetGlobalWave(32)
	// original lane/wave 0, 16
	let boss = new TDEnemyMechanicState(0, 16, TD_ENEMY_ROLE_BOSS, 240.0)
	boss.scaledSpellAmount(100.0).assertEquals(100.0, 0.000001)
	tdSetGlobalWave(8)
	boss.scaledSpellAmount(100.0).assertEquals(100.0, 0.000001)
	boss.deactivate().assertTrue()
	boss.scaledSpellAmount(100.0).assertEquals(100.0)
	destroy boss

	tdResetState()

@Test function nativeListenerSelectsOnlyNonCodeSpell()
	tdEnemyMechanicNativeSpellEligible(false, false).assertFalse()
	tdEnemyMechanicNativeSpellEligible(false, true).assertFalse()
	tdEnemyMechanicNativeSpellEligible(true, false).assertTrue()
	tdEnemyMechanicNativeSpellEligible(true, true).assertFalse()

@Test function scaledSpellLedgerCapsAtRemainingLife()
	// original lane/wave 0, 32
	let boss = new TDEnemyMechanicState(0, 32, TD_ENEMY_ROLE_BOSS, 240.0)
	let amount = boss.scaledSpellAmount(100.0)
	tdEffectiveDamage(amount, 20.0).assertEquals(20.0)
	tdEffectiveDamage(amount, 100.0).assertEquals(58.0, 0.000001)
	tdEffectiveDamage(amount, 0.0).assertEquals(0.0)
	destroy boss
