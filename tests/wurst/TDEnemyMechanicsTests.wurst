package TDEnemyMechanicsTests
import TDEnemyMechanicData
import TDEnemyMechanicState
import TDWaves
import TDEquipmentRules

@Test function guardLinksIsolateLaneAndOriginalWave()
	let link = new TDEnemyGuardLink(0, 8)
	let guard = new TDEnemyMechanicState(link, TD_ENEMY_ROLE_GUARD, 260.0)
	link.protects(0, 8).assertTrue()
	link.protects(1, 8).assertFalse()
	link.protects(0, 16).assertFalse()
	destroy guard
	link.protects(0, 8).assertFalse()
	destroy link

@Test function lastGuardAndRepeatedUnregisterAreIdempotent()
	let link = new TDEnemyGuardLink(0, 32)
	let first = new TDEnemyMechanicState(link, TD_ENEMY_ROLE_GUARD, 260.0)
	let last = new TDEnemyMechanicState(link, TD_ENEMY_ROLE_GUARD, 260.0)
	first.deactivate().assertTrue()
	first.deactivate().assertFalse()
	link.livingGuards.assertEquals(1)
	link.protects(0, 32).assertTrue()
	last.deactivate().assertTrue()
	link.livingGuards.assertEquals(0)
	link.protects(0, 32).assertFalse()
	destroy first
	destroy last
	destroy link

@Test function bossMayRegisterAndDieBeforeGuards()
	let link = new TDEnemyGuardLink(0, 8)
	let boss = new TDEnemyMechanicState(link, TD_ENEMY_ROLE_BOSS, 220.0)
	link.protects(0, 8).assertFalse()
	let guard = new TDEnemyMechanicState(link, TD_ENEMY_ROLE_GUARD, 260.0)
	link.protects(0, 8).assertTrue()
	boss.deactivate().assertTrue()
	link.livingGuards.assertEquals(1)
	destroy boss
	destroy guard
	destroy link

@Test function sprintOnlyAtReachedWaypointAndOnlyOnce()
	let link = new TDEnemyGuardLink(0, 12)
	let state = new TDEnemyMechanicState(link, TD_ENEMY_ROLE_ELITE, 270.0)
	state.beginSprint(1).assertFalse()
	state.beginSprint(2).assertTrue()
	let token = state.getGeneration()
	state.finishSprint(token + 1).assertFalse()
	state.finishSprint(token).assertTrue()
	state.finishSprint(token).assertFalse()
	state.beginSprint(2).assertFalse()
	state.originalBaseSpeed.assertEquals(270.0)
	destroy state
	destroy link

@Test function removalOrShutdownInvalidatesDelayedSprintToken()
	let link = new TDEnemyGuardLink(0, 32)
	let state = new TDEnemyMechanicState(link, TD_ENEMY_ROLE_GUARD, 260.0)
	state.beginSprint(2).assertTrue()
	let token = state.getGeneration()
	state.deactivate().assertTrue()
	state.finishSprint(token).assertFalse()
	state.isSprinting().assertFalse()
	let replacement = new TDEnemyMechanicState(link, TD_ENEMY_ROLE_GUARD, 260.0)
	replacement.beginSprint(2).assertTrue()
	replacement.finishSprint(token).assertFalse()
	destroy replacement
	destroy state
	destroy link

@Test function sprintObjectCapsAndArmorIdsAreIndependent()
	tdEnemyMechanicMaxSpeed(12, TD_ENEMY_ROLE_ELITE, 270).assertEquals(378)
	tdEnemyMechanicMaxSpeed(20, TD_ENEMY_ROLE_ELITE, 280).assertEquals(392)
	tdEnemyMechanicMaxSpeed(28, TD_ENEMY_ROLE_ELITE, 285).assertEquals(399)
	tdEnemyMechanicMaxSpeed(32, TD_ENEMY_ROLE_GUARD, 260).assertEquals(364)
	tdEnemyMechanicMaxSpeed(4, TD_ENEMY_ROLE_ELITE, 205).assertEquals(205)
	(TD_ENEMY_GUARD_ARMOR_ABILITY_ID != TD_EQUIPMENT_ARMOR_SHRED_ABILITY_ID).assertTrue()

@Test function descendingSpawnCounterCreatesGuardsBeforeBoss()
	for chapter = 1 to 4
		let wave = chapter * 8
		let count = tdWaveEnemyCount(wave)
		let guards = tdWaveBossGuardEnemyCount(wave)
		for offset = 0 to guards - 1
			tdWaveSpawnUnitId(wave, count - offset).assertEquals(tdWaveBossGuardUnitId(wave))
		tdWaveSpawnUnitId(wave, count - guards).assertEquals(tdWaveSpecialUnitId(wave))
		tdWaveSpawnUnitId(wave, 1).assertEquals(tdWaveUnitId(wave))
