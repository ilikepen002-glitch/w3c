package TDInventoryTests
import TDInventory
import TDItems
import TDConfig
import TDTowers

@Test function towersKeepThreeSlotsAndRawcodeCopiesAreDefensivelyIgnored()
	tdTowerEquipmentSlotCount().assertEquals(3)
	tdEquipmentAttackBonusForItems(TD_ITEM_WHITE_WAR_AXE_ID, TD_ITEM_WHITE_WAR_AXE_ID, TD_ITEM_WHITE_WAR_AXE_ID).assertEquals(40.0)
	tdTowerAttackBonusAbilityLevelForItems(TD_ITEM_WHITE_WAR_AXE_ID, TD_ITEM_WHITE_WAR_AXE_ID, TD_ITEM_WHITE_WAR_AXE_ID).assertEquals(8)

@Test function cooldownAndRangeBonusesRespectSingleCatalogAndCaps()
	tdTowerEquipmentCooldownCap().assertEquals(0.40)
	tdTowerEquipmentRangeCap().assertEquals(500.0)
	tdEquipmentCooldownReductionForItems(TD_ITEM_WHITE_COMMAND_ID, TD_ITEM_GREEN_COMMAND_ID, TD_ITEM_PURPLE_GOLD_ID).assertEquals(0.0)
	tdItemAuraValue(TD_ITEM_PURPLE_GOLD_ID).assertEquals(0.18)
	tdEquipmentRangeBonusForItems(TD_ITEM_WHITE_SCOPE_ID, TD_ITEM_WHITE_SCOPE_ID, TD_ITEM_WHITE_SCOPE_ID).assertEquals(90.0)
	tdEquipmentRangeBonusForItems(TD_ITEM_WHITE_SCOPE_ID, TD_ITEM_GREEN_SCOPE_ID, TD_ITEM_PURPLE_SCOPE_ID).assertEquals(500.0)
	tdTowerAttackSpeedAbilityLevelForItems(TD_ITEM_WHITE_SWIFT_ID, TD_ITEM_GREEN_SWIFT_ID, TD_ITEM_PURPLE_SWIFT_ID).assertEquals(80)

@Test function economicAndDropBonusesUseHighestKindAndPurpleHasNoEconomy()
	tdEquipmentKillGoldBonusForItems(TD_ITEM_WHITE_GOLD_ID, TD_ITEM_GREEN_GOLD_ID, 0).assertEquals(20)
	tdEquipmentDropBonusRollsForItems(TD_ITEM_GREEN_GOLD_ID, TD_ITEM_BLUE_GOLD_ID, 0).assertEquals(2)
	tdEquipmentKillGoldBonusForItems(TD_ITEM_BLUE_GOLD_ID, TD_ITEM_BLUE_GOLD_ID, TD_ITEM_BLUE_GOLD_ID).assertEquals(30)
	tdEquipmentDropBonusRollsForItems(TD_ITEM_BLUE_GOLD_ID, TD_ITEM_BLUE_GOLD_ID, TD_ITEM_BLUE_GOLD_ID).assertEquals(2)
	tdEquipmentKillGoldBonusForItems(TD_ITEM_PURPLE_GOLD_ID, 0, 0).assertEquals(0)
	tdEquipmentDropBonusRollsForItems(TD_ITEM_PURPLE_GOLD_ID, 0, 0).assertEquals(0)

@Test function equipmentRewardsRequireSameOriginLaneTowerAndNonBoss()
	tdCanUseEquipmentKillRewards(0, 0, TD_ARCHER_LEVEL_1_ID, false).assertTrue()
	tdCanUseEquipmentKillRewards(0, 1, TD_ARCHER_LEVEL_1_ID, false).assertFalse()
	tdCanUseEquipmentKillRewards(0, 0, TD_FARMER_UNIT_ID, false).assertFalse()
	tdCanUseEquipmentKillRewards(0, 0, TD_ARCHER_LEVEL_1_ID, true).assertFalse()
	tdCanUseEquipmentKillRewards(-1, -1, TD_ARCHER_LEVEL_1_ID, false).assertFalse()

@Test function poisonBonusesUseHighestTierWithoutDuplicateCopies()
	tdEquipmentPoisonBonusForItems(TD_ITEM_WHITE_POISON_ID, TD_ITEM_GREEN_POISON_ID, TD_ITEM_PURPLE_POISON_ID).assertEquals(120.0)
	tdEquipmentPoisonBonusForItems(TD_ITEM_PURPLE_POISON_ID, TD_ITEM_PURPLE_POISON_ID, TD_ITEM_PURPLE_POISON_ID).assertEquals(120.0)

@Test function distinctRawcodesDoNotShareDuplicatePenaltyBuckets()
	tdEquipmentAttackBonusForItems(TD_ITEM_WHITE_WAR_AXE_ID, TD_ITEM_GREEN_WAR_AXE_ID, TD_ITEM_PURPLE_WAR_AXE_ID).assertEquals(290.0)

@Test function towerEffectiveRangeAddsEquipmentBonusOnTopOfBaseRange()
	let baseRange = tdTowerBaseRangeForBranch(TD_TOWER_CHOICE_ARCHER, 5, TD_TOWER_BRANCH_A).toReal()
	tdTowerEffectiveRangeForLoadout(TD_TOWER_CHOICE_ARCHER, 5, TD_TOWER_BRANCH_A, TD_ITEM_WHITE_SCOPE_ID, TD_ITEM_GREEN_SCOPE_ID, 0).assertEquals(baseRange + 240.0)


@Test function equipmentRangeOnlyAppliesToAllArcherAndDryadBranches()
	var checked = 0
	for choice = 1 to TD_TOWER_CHOICE_COUNT
		for level = 1 to tdTowerMaxLevel(choice)
			let branches = level == tdTowerMaxLevel(choice) ? tdTowerUltimateBranchCount(choice) : 1
			for branch = 1 to branches
				let baseRange = tdTowerBaseRangeForBranch(choice, level, branch).toReal()
				let ranged = choice == TD_TOWER_CHOICE_ARCHER or choice == TD_TOWER_CHOICE_DRYAD
				tdTowerEffectiveRangeForLoadout(choice, level, branch, 0, 0, 0).assertEquals(baseRange)
				tdTowerEffectiveRangeForLoadout(choice, level, branch, TD_ITEM_WHITE_SCOPE_ID, 0, 0).assertEquals(baseRange + (ranged ? 90.0 : 0.0))
				tdTowerEffectiveRangeForLoadout(choice, level, branch, TD_ITEM_GREEN_SCOPE_ID, 0, 0).assertEquals(baseRange + (ranged ? 150.0 : 0.0))
				tdTowerEffectiveRangeForLoadout(choice, level, branch, TD_ITEM_BLUE_SCOPE_ID, 0, 0).assertEquals(baseRange + (ranged ? 230.0 : 0.0))
				tdTowerEffectiveRangeForLoadout(choice, level, branch, TD_ITEM_PURPLE_SCOPE_ID, 0, 0).assertEquals(baseRange + (ranged ? 340.0 : 0.0))
				tdTowerEffectiveRangeForLoadout(choice, level, branch, TD_ITEM_WHITE_SCOPE_ID, TD_ITEM_GREEN_SCOPE_ID, TD_ITEM_PURPLE_SCOPE_ID).assertEquals(baseRange + (ranged ? 500.0 : 0.0))
				// Removing equipment recomputes from the current tower/branch, with no cached bonus.
				tdTowerEffectiveRangeForLoadout(choice, level, branch, 0, 0, 0).assertEquals(baseRange)
				checked += 1
	checked.assertEquals(35)
	// Range gear still supplies its other stats on melee towers.
	tdEquipmentAttackBonusForItems(TD_ITEM_GREEN_SCOPE_ID, 0, 0).assertEquals(40.0)
	tdEquipmentAttackBonusForItems(TD_ITEM_BLUE_SCOPE_ID, 0, 0).assertEquals(80.0)
	tdEquipmentAttackSpeedBonusForItems(TD_ITEM_PURPLE_SCOPE_ID, 0, 0).assertEquals(0.24)
