package TDPetRawcodeTests
import TDPetData
import ObjectIds

function referenceHexId(string prefix, int index) returns int
	let digits = "0123456789ABCDEF"
	return (prefix + SubString(digits, index div 16, index div 16 + 1) + SubString(digits, index mod 16, index mod 16 + 1)).fromRawCode()

function referenceListId(int index) returns int
	let digits = "0123456789ABCDEF"
	return ("L" + SubString(digits, index div 256, index div 256 + 1) + SubString(digits, (index mod 256) div 16, (index mod 256) div 16 + 1) + SubString(digits, index mod 16, index mod 16 + 1)).fromRawCode()

@Test function petStartupIdsCoverExact610ListAnd23ManagerObjects()
	for cell = 0 to 9
		tdPetListAbilityId(cell, 0, 0, 0).assertEquals(referenceListId(cell * 241))
		for species = 1 to 15
			for quality = 1 to 4
				for count = 1 to 4
					tdPetListAbilityId(cell, species, quality, count).assertEquals(referenceListId(cell * 241 + (species - 1) * 16 + (quality - 1) * 4 + 1))
	for action = 0 to 22
		let expected = action < 8 ? referenceHexId("Pc", action) : referenceHexId("Pm", action - 8)
		tdPetManagerCommandId(action).assertEquals(expected)
	tdPetListAbilityId(0, 0, 0, 0).assertEquals('L000')
	tdPetListAbilityId(9, 15, 4, 4).assertEquals('L966')
	tdPetListAbilityId(0, 1, 1, 0).assertEquals(0)
	tdPetListAbilityId(0, 0, 0, 1).assertEquals(0)
	tdPetListAbilityId(0, 16, 1, 1).assertEquals(0)
	tdPetListAbilityId(10, 1, 1, 1).assertEquals(0)
	tdPetManagerCommandId(23).assertEquals(0)

@Test function petHexIdsKeepDisplayPreviewAndArithmeticStartupPartitions()
	for species = 1 to 15
		for quality = 1 to 4
			tdPetDisplayUnitId(species, quality).assertEquals(referenceHexId("pd", (species - 1) * 4 + quality))
	for position = 0 to 1
		for skill = 0 to TD_PET_SKILL_COUNT - 1
			tdPetPreviewAbilityId(position, skill).assertEquals(referenceHexId("Ps", position * TD_PET_SKILL_COUNT + skill))
		tdPetPreviewArrowAbilityId(position).assertEquals(referenceHexId("Pa", position))
	tdPetPreviewArrowAbilityId(2).assertEquals(0)
	for index = 0 to 255
		tdPetHexRawcode('L000', index, 256).assertEquals(referenceHexId("L0", index))
	tdPetHexRawcode('L000', -1, 256).assertEquals(0)
	tdPetHexRawcode('L000', 256, 256).assertEquals(0)
