package TDPetsTests
import TDPetData
import TDPetRules
import TDPetState
import TDPetCombat
import TDPetWild
import TDPetEffectState
import TDConfig
import TDWaves

@Test function ordinaryPetCaptureIsFixedSixtyPercent()
	tdPetCaptureChance(100.0, 100.0).assertEquals(0.60)
	tdPetCaptureChance(0.0, 100.0).assertEquals(0.60)
	tdPetCaptureChance(-5.0, 0.0).assertEquals(0.60)

@Test function capturedSkillAndQualityDistributionsHaveExactBuckets()
	var two = 0
	var three = 0
	var four = 0
	int array counts
	for roll = 1 to 100
		let count = tdPetSkillCountForRoll(roll)
		if count == 2
			two += 1
		else if count == 3
			three += 1
		else
			four += 1
		counts[tdPetQualityForRoll(roll)] += 1
	two.assertEquals(55)
	three.assertEquals(35)
	four.assertEquals(10)
	counts[1].assertEquals(45)
	counts[2].assertEquals(30)
	counts[3].assertEquals(20)
	counts[4].assertEquals(5)

@Test function petSkillsEnforceCategoryUniqueIdsAndAtMostOneActive()
	let pet = new TDPet(0, 1, 0)
	pet.setSkill(0, 0, 1)
	pet.setSkill(1, 13, 4)
	pet.setSkill(2, 14, 1)
	pet.skillCount.assertEquals(2)
	pet.setSkill(2, 13, 2)
	pet.skillCount.assertEquals(2)
	pet.setSkill(2, 9, 3)
	pet.setSkill(3, 10, 2)
	pet.skillCount.assertEquals(4)
	pet.setSkill(0, 5, 2)
	pet.skillAt(0).assertEquals(0)
	pet.setSkill(1, 9, 1)
	pet.skillAt(1).assertEquals(13)
	pet.setSkill(3, 9, 4)
	pet.skillAt(3).assertEquals(10)
	pet.setSkill(0, 1, 4)
	pet.skillAt(0).assertEquals(1)
	destroy pet

@Test function petInitialTwoSlotsAreUnlockedAndUniversal()
	for numeric = 0 to 3
		for mechanism = 4 to 15
			if tdPetSkillIsUniversal(mechanism)
				let pet = new TDPet(0, 1, 1)
				pet.setSkill(0, numeric, 1)
				pet.setSkill(1, mechanism, 1)
				pet.skillCount.assertEquals(2)
				pet.level.assertEquals(1)
				tdPetUnlockedSlots(pet.level).assertEquals(2)
				for tower = 1 to 6
					tdPetSkillFitsTower(mechanism, tower).assertTrue()
				destroy pet

@Test function petStageEncounterBudgetIsBoundedAndBossSafe()
	tdPetInitializeLane(0)
	var fixed = 0
	for wave = 1 to 32
		if tdPetFixedEncounter(wave)
			fixed += 1
	fixed.assertEquals(10)
	for stage = 0 to 3
		let wave = tdPetStageStart(stage)
		tdPetExtraEncounterWave[stage] = wave
	var total = 0
	for wave = 1 to 32
		let count = tdPetEncounterCount(0, wave)
		(count >= 0 and count <= 2).assertTrue()
		if wave > 25
			count.assertEquals(0)
		total += count
	total.assertEquals(14)

@Test function petResonanceUsesPersonalMilestonesWithoutRerollingSkills()
	tdPetInitializeLane(1)
	let pet = new TDPet(1, 2, 5)
	pet.setSkill(0, 0, 1)
	pet.setSkill(1, 5, 2)
	pet.setSkill(2, 9, 3)
	pet.setSkill(3, 13, 4)
	tdPetStore(1, pet).assertTrue()
	tdPetCreditWave(1, 8)
	pet.level.assertEquals(3)
	pet.skillCount.assertEquals(4)
	pet.skillAt(2).assertEquals(9)
	let balls = tdPetBallsForLane(1)
	tdPetCreditWave(1, 8)
	tdPetBallsForLane(1).assertEquals(balls)
	tdPetCreditWave(1, 4)
	pet.level.assertEquals(3)
	let late = new TDPet(1, 3, 15)
	tdPetStore(1, late).assertTrue()
	late.level.assertEquals(3)

@Test function petBallBudgetAndMasterForgeAreIndependentAndAtomic()
	tdPetInitializeLane(2)
	tdPetForgeMasterBall(2).assertFalse()
	tdPetBallsForLane(2).assertEquals(3)
	for wave = 1 to 25
		tdPetCreditWave(2, wave)
	tdPetBallsForLane(2).assertEquals(27)
	tdPetForgeMasterBall(2).assertTrue()
	tdPetBallsForLane(2).assertEquals(22)
	tdPetMasterBalls[2].assertEquals(1)
	tdPetTakeDropBudget(2, 3).assertTrue()
	tdPetTakeDropBudget(2, 4).assertFalse()
	tdPetTakeDropBudget(2, 3).assertFalse()
	tdPetForgeMasterBall(-1).assertFalse()

@Test function petCollectionOwnershipAndCapacityRemainAtomic()
	tdPetInitializeLane(0)
	tdPetInitializeLane(3)
	for slot = 0 to TD_PET_COLLECTION_LIMIT - 1
		let pet = new TDPet(0, slot mod 3 + 1, 1)
		tdPetStore(3, pet).assertFalse()
		tdPetStore(0, pet).assertTrue()
		tdPetStore(0, pet).assertFalse()
	let extra = new TDPet(0, 1, 1)
	tdPetStore(0, extra).assertFalse()
	destroy extra
	tdPetCollectionCount(0).assertEquals(12)
	tdPetRelease(0, 2).assertTrue()
	tdPetRelease(0, 2).assertFalse()
	tdPetCollectionCount(0).assertEquals(11)

@Test function petCultivationConsumesOnPreviewAndPreservesCooldown()
	tdPetInitializeLane(3)
	let pet = new TDPet(3, 1, 1)
	pet.setSkill(0, 0, 1)
	pet.setSkill(1, 13, 1)
	tdPetStore(3, pet).assertTrue()
	tdPetRerollStones[3] = 2
	tdPetSlotStones[3] = 1
	pet.readyAt = 99.0
	pet.buffSkill = 11
	pet.buffUntil = 100.0
	tdPetBeginReroll(3, 0, 1).assertTrue()
	tdPetRerollStones[3].assertEquals(1)
	tdPetBeginReroll(3, 0, 0).assertFalse()
	tdPetOpenSlot(3, 0).assertFalse()
	tdPetSlotStones[3].assertEquals(1)
	tdPetResolveReroll(3, 0, false).assertTrue()
	pet.skillAt(1).assertEquals(13)
	tdPetBeginReroll(3, 0, 1).assertTrue()
	tdPetResolveReroll(3, 0, true).assertTrue()
	pet.readyAt.assertEquals(99.0)
	pet.buffUntil.assertEquals(0.0)
	tdPetOpenSlot(3, 0).assertTrue()
	pet.skillCount.assertEquals(3)
	tdPetSlotStones[3].assertEquals(0)
	pet.setSkill(3, pet.rollSkill(3), 1)
	tdPetSlotStones[3] = 1
	tdPetOpenSlot(3, 0).assertFalse()
	tdPetSlotStones[3].assertEquals(1)

@Test function petStableWildIdentityDoesNotOverlapNormalOrDisplayTypes()
	for wave = 1 to 32
		for species = 1 to 3
			tdPetSpeciesForWildType(tdPetWildUnitId(wave, species)).assertEquals(species)
			tdPetSpeciesForWildType(tdPetDisplayUnitId(species)).assertEquals(0)
			tdPetSpeciesForWildType(tdPetVisualUnitId(species)).assertEquals(0)
		tdPetSpeciesForWildType(tdWaveUnitId(wave)).assertEquals(0)

@Test function petTaggedDamageCannotRecursivelyTriggerSkills()
	tdPetDamageSourceEligible(false, false, 0).assertTrue()
	tdPetDamageSourceEligible(true, false, 0).assertFalse()
	tdPetDamageSourceEligible(false, true, 0).assertFalse()
	tdPetDamageSourceEligible(false, false, 'Tspl').assertFalse()
	tdPetDamageSourceEligible(false, false, TD_PET_DAMAGE_ID).assertFalse()

@Test function recallPreservesActiveCooldownAndInvalidatesPendingWork()
	let pet = new TDPet(0, 1, 1)
	pet.setSkill(0, 0, 1)
	pet.setSkill(1, 13, 1)
	pet.readyAt = 25.0
	pet.pendingSkill = true
	pet.recall()
	pet.readyAt.assertEquals(25.0)
	pet.pendingSkill.assertFalse()
	pet.generation.assertEquals(1)
	pet.skillAt(1).assertEquals(13)
	destroy pet
@Test function independentPetSlowExpiryPreservesWeakLongAndSameStrengthLongEffects()
	let slow = new TDPetSlowState()
	slow.refresh(0, 0.12, 3.0, 0.0)
	slow.refresh(4, 0.55, 1.0, 0.0)
	slow.effectivePower(0.5).assertEquals(0.55)
	slow.effectivePower(1.5).assertEquals(0.12)
	slow.refresh(0, 0.12, 0.30, 1.5)
	slow.effectivePower(2.5).assertEquals(0.12)
	slow.refreshAura(0.24)
	slow.effectivePower(2.5).assertEquals(0.24)
	slow.clearAura()
	slow.effectivePower(2.5).assertEquals(0.12)
	slow.effectivePower(3.0).assertEquals(0.0)
	destroy slow
@Test function fullCollectionAndInvalidTargetsDoNotSpendOrdinaryOrMasterBalls()
	tdPetInitializeLane(0)
	tdPetMasterBalls[0] = 2
	tdPetSpendCaptureBall(0, false, false).assertFalse()
	tdPetSpendCaptureBall(0, true, false).assertFalse()
	for slot = 0 to 11
		tdPetStore(0, new TDPet(0, 1, 1)).assertTrue()
	tdPetSpendCaptureBall(0, false, true).assertFalse()
	tdPetSpendCaptureBall(0, true, true).assertFalse()
	tdPetBallsForLane(0).assertEquals(3)
	tdPetMasterBalls[0].assertEquals(2)
	tdPetRelease(0, 0).assertTrue()
	tdPetSpendCaptureBall(0, true, true).assertTrue()
	tdPetMasterBalls[0].assertEquals(1)
	tdPetSpendCaptureBall(0, false, true).assertTrue()
	tdPetBallsForLane(0).assertEquals(2)
@Test function wildTerminalRaceHasExactlyOneSettlementAndDeadlineIsAbsolute()
	let captured = new TDPetWildState(0, 10.0)
	captured.canCapture(true, 69.9).assertTrue()
	captured.settle(TD_PET_WILD_CAPTURED, 69.9).assertTrue()
	captured.settle(TD_PET_WILD_KILLED, 69.9).assertFalse()
	captured.settle(TD_PET_WILD_EXPIRED, 70.0).assertFalse()
	captured.state.assertEquals(TD_PET_WILD_CAPTURED)
	let hunted = new TDPetWildState(1, 0.0)
	hunted.beginHunt(true, 50.0).assertTrue()
	hunted.deadline.assertEquals(60.0)
	hunted.canCapture(true, 50.0).assertFalse()
	hunted.settle(TD_PET_WILD_CAPTURED, 50.0).assertFalse()
	hunted.settle(TD_PET_WILD_KILLED, 60.0).assertFalse()
	hunted.state.assertEquals(TD_PET_WILD_EXPIRED)
	let killed = new TDPetWildState(2, 0.0)
	killed.beginHunt(true, 1.0).assertTrue()
	killed.settle(TD_PET_WILD_KILLED, 59.9).assertTrue()
	killed.settle(TD_PET_WILD_KILLED, 59.9).assertFalse()
	destroy captured
	destroy hunted
	destroy killed
@Test function randomEncounterPlansRespectEachStageAndDoNotUseBossWaves()
	for _trial = 0 to 31
		tdPetInitializeLane(2)
		tdPetWildPlanLane(2)
		var additions = 0
		for stage = 0 to 3
			let wave = tdPetExtraEncounterWave[2 * 4 + stage]
			if wave != 0
				(wave >= tdPetStageStart(stage) and wave <= tdPetStageEnd(stage)).assertTrue()
				tdWaveBossEnemyCount(wave).assertEquals(0)
				additions += 1
		var total = 0
		for wave = 1 to 32
			let count = tdPetEncounterCount(2, wave)
			(count >= 0 and count <= 2).assertTrue()
			total += count
		total.assertEquals(10 + additions)
		(total >= 10 and total <= 14).assertTrue()

@Test function wildTravelIsConservativeForAllFourLanesAndStopsOutsideExit()
	for lane = 0 to 3
		var distance = 0.0
		var origin = tdLaneSpawnPosition(lane)
		for waypoint = 0 to tdLaneWaypointCount(lane) - 1
			let next = tdLaneWaypointPosition(lane, waypoint)
			distance += origin.distanceTo(next)
			origin = next
		distance += origin.distanceTo(tdLaneExitPosition(lane))
		(distance / tdPetWildTravelSpeed(lane) >= 75.0).assertTrue()
		(tdPetWildHoldPosition(lane).distanceTo(tdLaneExitPosition(lane)) >= 599.0).assertTrue()


