@Test function captureActiveClassificationMatchesEntireRegistry()
	for skill = -1 to TD_PET_SKILL_COUNT
		let expected = tdActiveSkillDefinitionForPetSkill(skill).driver == TD_ACTIVE_DRIVER_PET_PROC
		tdPetSkillIsActive(skill).assertEquals(expected)

@Test function ordinaryPetCaptureIsFixedSixtyFivePercent()
	tdPetCaptureChance(100.0, 100.0).assertEquals(0.65)
	tdPetCaptureChance(0.0, 100.0).assertEquals(0.65)
	tdPetCaptureChance(-5.0, 0.0).assertEquals(0.65)

@Test function capturedSkillAndQualityDistributionsHaveExactBuckets()
	var two = 0
	var three = 0
	var four = 0
	int array counts
	for roll = 1 to 100
		let count = tdPetSkillCountForRoll(roll)
		if count == 2
			two += 1
		else if count == 3
			three += 1
		else
			four += 1
		counts[tdPetQualityForRoll(roll)] += 1
	two.assertEquals(55)
	three.assertEquals(35)
	four.assertEquals(10)
	counts[1].assertEquals(45)
	counts[2].assertEquals(30)
	counts[3].assertEquals(20)
	counts[4].assertEquals(5)

@Test function petSkillsEnforceFourDistinctSlotRoles()
	let pet = new TDPet(0, 1, 0)
	pet.setSkill(0, 0, 1)
	pet.setSkill(1, 5, 4)
	pet.setSkill(2, 12, 1)
	pet.skillCount.assertEquals(2)
	pet.setSkill(2, 5, 2)
	pet.skillCount.assertEquals(2)
	pet.setSkill(2, 39, 3)
	pet.setSkill(3, 11, 2)
	pet.skillCount.assertEquals(4)
	pet.setSkill(0, 5, 2)
	pet.skillAt(0).assertEquals(0)
	pet.setSkill(1, 39, 1)
	pet.skillAt(1).assertEquals(5)
	pet.setSkill(3, 39, 4)
	pet.skillAt(3).assertEquals(11)
	pet.setSkill(3, 19, 4)
	pet.skillAt(3).assertEquals(11)
	pet.setSkill(3, 22, 4)
	pet.skillAt(3).assertEquals(22)
	pet.setSkill(3, 23, 1)
	pet.skillAt(3).assertEquals(22)
	for slot = 0 to 2
		pet.setSkill(slot, 12, 1)
		pet.skillAt(slot).assertEquals(slot == 0 ? 0 : (slot == 1 ? 5 : 39))
	destroy pet

@Test function petInitialTwoSlotsHaveOneAttributeAndOneAttackPassive()
	for mechanism = 0 to TD_PET_SKILL_COUNT - 1
		if tdPetSkillIsAttackPassive(mechanism)
			let pet = new TDPet(0, 1, 1)
			pet.setSkill(0, 0, 1)
			pet.setSkill(1, mechanism, 1)
			pet.skillCount.assertEquals(2)
			pet.level.assertEquals(1)
			tdPetUnlockedSlots(pet.level).assertEquals(2)
			for tower = 1 to 6
				// Split-arrow/corpse capabilities do not restrict these seven passives.
				// Resolve's separate native-critical gate is tested in TDPetAttackTests.
				tdPetSkillFitsAbilities(mechanism, tower == TD_TOWER_CHOICE_ARCHER, tower == TD_TOWER_CHOICE_GHOUL).assertTrue()
			destroy pet

@Test function petStageEncounterBudgetIsBoundedAndBossSafe()
	tdPetInitializeLane(0)
	var fixed = 0
	for wave = 1 to 32
		if tdPetFixedEncounter(wave)
			fixed += 1
	fixed.assertEquals(10)
	for stage = 0 to 3
		let wave = tdPetStageStart(stage)
		tdPetExtraEncounterWave[stage] = wave
	var total = 0
	for wave = 1 to 32
		let count = tdPetEncounterCount(0, wave)
		(count >= 0 and count <= 2).assertTrue()
		if wave > 25
			count.assertEquals(0)
		total += count
	total.assertEquals(14)

@Test function petResonanceUsesPersonalMilestonesWithoutRerollingSkills()
	tdResetState()
	tdSetLaneActive(1, true)
	tdPetInitializeLane(1)
	let pet = new TDPet(1, 2, 5)
	pet.setSkill(0, 0, 1)
	pet.setSkill(1, 5, 2)
	pet.setSkill(2, 39, 3)
	pet.setSkill(3, 11, 4)
	tdPetStore(1, pet).assertTrue()
	tdMarkWaveResolved(1, 8)
	tdPetCreditWave(1, 8)
	pet.level.assertEquals(3)
	pet.skillCount.assertEquals(4)
	pet.skillAt(2).assertEquals(39)
	let balls = tdPetBallsForLane(1)
	tdMarkWaveResolved(1, 8)
	tdPetCreditWave(1, 8)
	tdPetBallsForLane(1).assertEquals(balls)
	tdMarkWaveResolved(1, 4)
	tdPetCreditWave(1, 4)
	pet.level.assertEquals(3)
	let late = new TDPet(1, 3, 15)
	tdPetStore(1, late).assertTrue()
	late.level.assertEquals(3)

@Test function petBallBudgetAndDropsRemainIndependentAndAtomic()
	tdResetState()
	tdSetLaneActive(2, true)
	tdPetInitializeLane(2)
	tdPetBallsForLane(2).assertEquals(3)
	for wave = 1 to 25
		tdMarkWaveResolved(2, wave)
		tdPetCreditWave(2, wave)
	tdPetBallsForLane(2).assertEquals(27)
	tdPetSpendCaptureBall(2, true).assertTrue()
	tdPetBallsForLane(2).assertEquals(26)
	tdPetAddBall(2).assertTrue()
	tdPetBallsForLane(2).assertEquals(27)
	tdPetTakeDropBudget(2, 3).assertTrue()
	tdPetTakeDropBudget(2, 4).assertFalse()
	tdPetTakeDropBudget(2, 3).assertFalse()
	tdPetSpendCaptureBall(-1, true).assertFalse()

@Test function ordinaryCaptureInventoryEmptySpendAndRefundPreserveBounds()
	tdPetInitializeLane(1)
	tdPetSpendCaptureBall(4, true).assertFalse()
	for ball = 1 to 3
		tdPetSpendCaptureBall(1, true).assertTrue()
	tdPetBallsForLane(1).assertEquals(0)
	tdPetSpendCaptureBall(1, true).assertFalse()
	for ball = 1 to TD_PET_BALL_LIMIT
		tdPetAddBall(1).assertTrue()
	tdPetAddBall(1).assertFalse()
	tdPetSpendCaptureBall(1, true).assertTrue()
	tdPetAddBall(1).assertTrue()
	tdPetBallsForLane(1).assertEquals(TD_PET_BALL_LIMIT)
	tdPetCaptureChance(1.0, 100.0).assertEquals(0.65)
	tdPetCaptureChance(100.0, 100.0).assertEquals(0.65)

@Test function petCollectionOwnershipAndCapacityRemainAtomic()
	tdPetInitializeLane(0)
	tdPetInitializeLane(3)
	for slot = 0 to TD_PET_COLLECTION_LIMIT - 1
		let pet = new TDPet(0, slot mod 3 + 1, 1)
		tdPetStore(3, pet).assertFalse()
		tdPetStore(0, pet).assertTrue()
		tdPetStore(0, pet).assertFalse()
	let extra = new TDPet(0, 1, 1)
	tdPetStore(0, extra).assertFalse()
	destroy extra
	tdPetCollectionCount(0).assertEquals(20)
	tdPetDiscardOwned(0, 2).assertTrue()
	tdPetDiscardOwned(0, 2).assertFalse()
	tdPetCollectionCount(0).assertEquals(19)

@Test function petCultivationConsumesOnPreviewAndPreservesCooldown()
	tdResetState()
	tdSetLaneActive(3, true)
	tdPetInitializeLane(3)
	let pet = new TDPet(3, 1, 1)
	pet.setSkill(0, 0, 1)
	pet.setSkill(1, 6, 1)
	tdPetStore(3, pet).assertTrue()
	tdPetRerollStones[3] = 2
	tdPetSlotStones[3] = 1
	pet.readyAt = 99.0
	pet.buffSkill = 11
	pet.buffUntil = 100.0
	tdPetBeginReroll(3, 0, 1).assertTrue()
	tdPetRerollStones[3].assertEquals(1)
	tdPetBeginReroll(3, 0, 0).assertFalse()
	tdPetOpenSlot(3, 0).assertFalse()
	tdPetSlotStones[3].assertEquals(1)
	tdPetResolveReroll(3, 0, false).assertTrue()
	pet.skillAt(1).assertEquals(6)
	tdPetBeginReroll(3, 0, 1).assertTrue()
	tdPetResolveReroll(3, 0, true).assertTrue()
	pet.readyAt.assertEquals(99.0)
	pet.buffUntil.assertEquals(0.0)
	tdPetOpenSlot(3, 0).assertTrue()
	pet.skillCount.assertEquals(3)
	tdPetSlotStones[3].assertEquals(0)
	pet.setSkill(3, pet.rollSkill(3), 1)
	tdPetSlotStones[3] = 1
	tdPetOpenSlot(3, 0).assertFalse()
	tdPetSlotStones[3].assertEquals(1)

@Test function petStableWildIdentityDoesNotOverlapNormalOrDisplayTypes()
	for wave = 1 to 32
		for species = 1 to 15
			tdPetSpeciesForWildType(tdPetWildUnitId(wave, species)).assertEquals(species)
			tdPetSpeciesForWildType(tdPetDisplayUnitId(species)).assertEquals(0)
			tdPetSpeciesForWildType(tdPetVisualUnitId(species)).assertEquals(0)
		tdPetSpeciesForWildType(tdWaveUnitId(wave)).assertEquals(0)

@Test function petTaggedDamageCannotRecursivelyTriggerSkills()
	tdPetDamageSourceEligible(false, false, 0).assertTrue()
	tdPetDamageSourceEligible(true, false, 0).assertFalse()
	tdPetDamageSourceEligible(false, true, 0).assertFalse()
	tdPetDamageSourceEligible(false, false, 'Tspl').assertFalse()
	tdPetDamageSourceEligible(false, false, TD_PET_DAMAGE_ID).assertFalse()

@Test function recallPreservesActiveCooldownAndInvalidatesPendingWork()
	let pet = new TDPet(0, 1, 1)
	pet.setSkill(0, 0, 1)
	pet.setSkill(1, 6, 1)
	pet.setSkill(2, 39, 1)
	pet.setSkill(3, 11, 1)
	pet.readyAt = 25.0
	pet.pendingSkill = true
	pet.recall()
	pet.readyAt.assertEquals(25.0)
	pet.pendingSkill.assertFalse()
	pet.generation.assertEquals(1)
	pet.skillAt(1).assertEquals(6)
	destroy pet
@Test function independentPetSlowExpiryPreservesWeakLongAndSameStrengthLongEffects()
	let slow = new TDPetSlowState()
	slow.refresh(0, 0.12, 3.0, 0.0)
	slow.refresh(4, 0.55, 1.0, 0.0)
	((slow.effectivePower(0.5) - 0.67).abs() < 0.000001).assertTrue()
	slow.effectivePower(1.5).assertEquals(0.12)
	slow.refresh(0, 0.12, 0.30, 1.5)
	slow.effectivePower(2.5).assertEquals(0.12)
	slow.refreshAura(0.24)
	((slow.effectivePower(2.5) - 0.36).abs() < 0.000001).assertTrue()
	slow.clearAura()
	slow.effectivePower(2.5).assertEquals(0.12)
	slow.effectivePower(3.0).assertEquals(0.0)
	destroy slow
@Test function fullCollectionAndInvalidTargetsDoNotSpendOrdinaryBalls()
	tdPetInitializeLane(0)
	tdPetSpendCaptureBall(0, false).assertFalse()
	for slot = 0 to 19
		tdPetStore(0, new TDPet(0, 1, 1)).assertTrue()
	tdPetSpendCaptureBall(0, true).assertFalse()
	tdPetBallsForLane(0).assertEquals(3)
	tdPetDiscardOwned(0, 0).assertTrue()
	tdPetSpendCaptureBall(0, true).assertTrue()
	tdPetBallsForLane(0).assertEquals(2)
@Test function wildTerminalRaceHasExactlyOneCaptureOrExpiryAndAbsoluteDeadline()
	TD_PET_WILD_LIFETIME.assertEquals(180.0)
	let captured = new TDPetWildState(0, 10.0)
	captured.deadline.assertEquals(190.0)
	captured.canCapture(true, 189.999).assertTrue()
	captured.canCapture(false, 189.999).assertFalse()
	captured.settle(TD_PET_WILD_CAPTURED, 189.999).assertTrue()
	captured.settle(TD_PET_WILD_CAPTURED, 189.999).assertFalse()
	captured.settle(TD_PET_WILD_EXPIRED, 190.0).assertFalse()
	captured.state.assertEquals(TD_PET_WILD_CAPTURED)
	let expired = new TDPetWildState(1, 0.0)
	expired.canCapture(true, 179.999).assertTrue()
	expired.canCapture(true, 180.0).assertFalse()
	expired.canCapture(true, 180.001).assertFalse()
	expired.settle(TD_PET_WILD_CAPTURED, 180.0).assertFalse()
	expired.state.assertEquals(TD_PET_WILD_EXPIRED)
	expired.settle(TD_PET_WILD_EXPIRED, 180.0).assertFalse()
	let removed = new TDPetWildState(2, 10.0)
	removed.settle(3, 10.0).assertFalse()
	removed.settle(TD_PET_WILD_EXPIRED, 190.0).assertTrue()
	removed.settle(TD_PET_WILD_CAPTURED, 190.0).assertFalse()
	removed.canCapture(true, 190.0).assertFalse()
	removed.deadline.assertEquals(190.0)
	destroy captured
	destroy expired
	destroy removed
@Test function randomEncounterPlansRespectEachStageAndDoNotUseBossWaves()
	for _trial = 0 to 31
		tdPetInitializeLane(2)
		tdPetWildPlanLane(2)
		var additions = 0
		for stage = 0 to 3
			let wave = tdPetExtraEncounterWave[2 * 4 + stage]
			if wave != 0
				(wave >= tdPetStageStart(stage) and wave <= tdPetStageEnd(stage)).assertTrue()
				tdWaveBossEnemyCount(wave).assertEquals(0)
				additions += 1
		var total = 0
		for wave = 1 to 32
			let count = tdPetEncounterCount(2, wave)
			(count >= 0 and count <= 2).assertTrue()
			total += count
		total.assertEquals(10 + additions)
		(total >= 10 and total <= 14).assertTrue()

@Test function wildTravelIsConservativeForAllFourLanesAndStopsOutsideExit()
	for lane = 0 to 3
		var distance = 0.0
		var origin = tdLaneSpawnPosition(lane)
		for waypoint = 0 to tdLaneWaypointCount(lane) - 1
			let next = tdLaneWaypointPosition(lane, waypoint)
			distance += origin.distanceTo(next)
			origin = next
		distance += origin.distanceTo(tdLaneExitPosition(lane))
		(distance / tdPetWildTravelSpeed(lane) >= 75.0).assertTrue()
		(tdPetWildHoldPosition(lane).distanceTo(tdLaneExitPosition(lane)) >= 599.0).assertTrue()



@Test function inspirationDescribesAllHostActivesWithoutSkillNameWhitelist()
	let description = tdPetSkillDescriptionById(3, 4)
	description.contains("全部主动技能冷却缩短").assertTrue()
	description.contains("包括精灵主动技能").assertTrue()
	description.contains("上限40%").assertTrue()
