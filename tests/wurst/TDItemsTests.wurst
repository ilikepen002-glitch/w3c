package TDItemsTests
import TDItems

@Test function catalogHasTenLinesAtAllFourQualities()
	tdItemDefinitionCount().assertEquals(40)
	tdItemQualityCount(TD_ITEM_QUALITY_WHITE).assertEquals(10)
	tdItemQualityCount(TD_ITEM_QUALITY_GREEN).assertEquals(10)
	tdItemQualityCount(TD_ITEM_QUALITY_BLUE).assertEquals(10)
	tdItemQualityCount(TD_ITEM_QUALITY_PURPLE).assertEquals(10)

@Test function singleLookupAuraSnapshotMatchesAllFortyCatalogItems()
	for index = 1 to tdItemDefinitionCount()
		let id = tdItemIdForCatalogIndex(index)
		let aura = tdItemAuraDefinition(id)
		aura.kind.assertEquals(tdItemAuraKind(id))
		aura.quality.assertEquals(tdItemQuality(id))
		((aura.power - tdItemAuraValue(id)).abs() < 0.000001).assertTrue()
		((aura.radius - tdItemAuraRadius(id)).abs() < 0.000001).assertTrue()

function assertNoEquipmentAuraSnapshot(int id)
	let aura = tdItemAuraDefinition(id)
	aura.kind.assertEquals(0)
	aura.quality.assertEquals(0)
	(aura.power == 0.0 and aura.radius == 0.0).assertTrue()
	tdItemIsEquipment(id).assertFalse()

@Test function absentEquipmentHasNoAuraSnapshot()
	assertNoEquipmentAuraSnapshot(0)
	assertNoEquipmentAuraSnapshot(-1)
	assertNoEquipmentAuraSnapshot('Ibal')
	assertNoEquipmentAuraSnapshot('uA11')
	assertNoEquipmentAuraSnapshot('iZ01')

@Test function qualityProgressionStopsAtPurple()
	tdNextItemQuality(TD_ITEM_QUALITY_WHITE).assertEquals(TD_ITEM_QUALITY_GREEN)
	tdNextItemQuality(TD_ITEM_QUALITY_GREEN).assertEquals(TD_ITEM_QUALITY_BLUE)
	tdNextItemQuality(TD_ITEM_QUALITY_BLUE).assertEquals(TD_ITEM_QUALITY_PURPLE)
	tdNextItemQuality(TD_ITEM_QUALITY_PURPLE).assertEquals(TD_ITEM_QUALITY_PURPLE)

@Test function launchWhiteAndBlueItemsExposeStableMetadata()
	tdItemIsEquipment(TD_ITEM_WHITE_WAR_AXE_ID).assertTrue()
	tdItemName(TD_ITEM_WHITE_WAR_AXE_ID).assertEquals("战斧")
	tdItemQuality(TD_ITEM_WHITE_WAR_AXE_ID).assertEquals(TD_ITEM_QUALITY_WHITE)
	tdItemPrimaryEffectKind(TD_ITEM_WHITE_WAR_AXE_ID).assertEquals(TD_ITEM_EFFECT_ATTACK)
	tdItemPrimaryEffectValue(TD_ITEM_WHITE_WAR_AXE_ID).assertEquals(40.0)
	tdItemName(TD_ITEM_BLUE_GOLD_ID).assertEquals("赏金契约")
	tdItemQuality(TD_ITEM_BLUE_GOLD_ID).assertEquals(TD_ITEM_QUALITY_BLUE)

@Test function equipmentTitleNamesUseQualityColorsWithoutChangingPlainNames()
	tdItemName(TD_ITEM_BLUE_GOLD_ID).assertEquals("赏金契约")
	tdItemTitleName(TD_ITEM_WHITE_WAR_AXE_ID).assertEquals("|cffffffff战斧|r")
	tdItemTitleName(TD_ITEM_GREEN_WAR_AXE_ID).assertEquals("|cff00ff00精钢战斧|r")
	tdItemTitleName(TD_ITEM_BLUE_GOLD_ID).assertEquals("|cff3399ff赏金契约|r")
	tdItemTitleName(TD_ITEM_PURPLE_SCOPE_ID).assertEquals("|cffcc66ff风行旗|r")

@Test function equipmentObjectsDoNotRelyOnNativePassiveItemAbilities()
	for index = 1 to tdItemDefinitionCount()
		tdItemPassiveAbilityRawcodes(tdItemIdForCatalogIndex(index)).assertEquals("")

@Test function farmerCraftUsesDistinctInventoryCraftIcon()
	tdFarmerCraftIconPath().assertEquals("war3mapImported\\BTNTDActionInventoryCraft.blp")

@Test function allFortyItemsHaveUniqueIdsAndThirtyExplicitSameLineLinks()
	for index = 1 to tdItemDefinitionCount()
		let current = tdItemIdForCatalogIndex(index)
		let next = tdItemFixedNextId(current)
		if tdItemQuality(current) == 4
			next.assertEquals(0)
		else
			tdItemQuality(next).assertEquals(tdItemQuality(current) + 1)
			tdItemLine(next).assertEquals(tdItemLine(current))
		for other = index + 1 to tdItemDefinitionCount()
			(current != tdItemIdForCatalogIndex(other)).assertTrue()

@Test function catalogFreezesRangeAndSpecializationValues()
	tdItemPrimaryEffectValue(TD_ITEM_BLUE_SCOPE_ID).assertEquals(230.0)
	tdItemSpecialCount(TD_ITEM_PURPLE_WAR_AXE_ID).assertEquals(4)
	tdItemWarAttackSpeed().assertEquals(0.20)
	tdItemWarDuration().assertEquals(3.0)
	tdItemSpecialCount(TD_ITEM_PURPLE_SWIFT_ID).assertEquals(6)
	tdItemSpecialRadius(TD_ITEM_PURPLE_SWIFT_ID).assertEquals(180.0)
	tdItemSpecialTargetCap(TD_ITEM_PURPLE_SWIFT_ID).assertEquals(4)
	tdItemSpecialCount(TD_ITEM_PURPLE_POISON_ID).assertEquals(3)
	tdItemSpecialRadius(TD_ITEM_PURPLE_POISON_ID).assertEquals(220.0)
	tdItemSpecialTargetCap(TD_ITEM_PURPLE_SHIELD_ID).assertEquals(2)
	tdItemAuraValue(TD_ITEM_PURPLE_COMMAND_ID).assertEquals(0.12)
	tdItemAuraValue(TD_ITEM_PURPLE_ARMOR_ID).assertEquals(4.0)
	tdItemAuraRadius(TD_ITEM_WHITE_WIND_ID).assertEquals(350.0)
	tdItemAuraRadius(TD_ITEM_PURPLE_FROST_ID).assertEquals(550.0)
