package TDHudProjectionTests
import TDHudProjection

@Test function hudProjectionWritesEmptyCellsOnceAndClearsOldText()
	tdHudProjectionInvalidate(TD_HUD_STATUS_SECTION)
	tdHudProjectionBind(TD_HUD_STATUS_SECTION, null, 0, 16, 4)
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 15, 3, "").assertTrue()
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 15, 3, "").assertFalse()
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 15, 3, "旧尾行").assertTrue()
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 15, 3, "").assertTrue()
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 15, 3, "").assertFalse()
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 15, 2, "").assertTrue()

@Test function hudProjectionTracksEachPresentationPropertyIndependently()
	tdHudProjectionInvalidate(TD_HUD_STATUS_SECTION)
	tdHudProjectionBind(TD_HUD_STATUS_SECTION, null, 0, 9, 4)
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 4, 1, "").assertTrue()
	tdHudProjectionAcceptIcon(TD_HUD_STATUS_SECTION, 4, 1, "").assertTrue()
	tdHudProjectionAcceptStyle(TD_HUD_STATUS_SECTION, 4, 1, false, false).assertTrue()
	tdHudProjectionAcceptTitle(TD_HUD_STATUS_SECTION, "").assertTrue()
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 4, 1, "").assertFalse()
	tdHudProjectionAcceptIcon(TD_HUD_STATUS_SECTION, 4, 1, "").assertFalse()
	tdHudProjectionAcceptStyle(TD_HUD_STATUS_SECTION, 4, 1, false, false).assertFalse()
	tdHudProjectionAcceptTitle(TD_HUD_STATUS_SECTION, "").assertFalse()
	tdHudProjectionAcceptIcon(TD_HUD_STATUS_SECTION, 4, 1, "boss.blp").assertTrue()
	tdHudProjectionAcceptStyle(TD_HUD_STATUS_SECTION, 4, 1, false, true).assertTrue()
	tdHudProjectionAcceptStyle(TD_HUD_STATUS_SECTION, 4, 1, true, true).assertTrue()
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 4, 1, "").assertFalse()
	tdHudProjectionAcceptTitle(TD_HUD_STATUS_SECTION, "胜利").assertTrue()
	tdHudProjectionAcceptIcon(TD_HUD_STATUS_SECTION, 4, 1, "boss.blp").assertFalse()

@Test function hudProjectionInvalidatesWhenSectionMovesOrResizes()
	tdHudProjectionInvalidate(TD_HUD_STATUS_SECTION)
	tdHudProjectionBind(TD_HUD_STATUS_SECTION, null, 6, 16, 4)
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 0, 0, "排名").assertTrue()
	tdHudProjectionAcceptIcon(TD_HUD_STATUS_SECTION, 0, 0, "").assertTrue()
	tdHudProjectionAcceptStyle(TD_HUD_STATUS_SECTION, 0, 0, true, false).assertTrue()
	tdHudProjectionAcceptTitle(TD_HUD_STATUS_SECTION, "标题").assertTrue()
	tdHudProjectionBind(TD_HUD_STATUS_SECTION, null, 6, 16, 4)
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 0, 0, "排名").assertFalse()
	tdHudProjectionBind(TD_HUD_STATUS_SECTION, null, 9, 16, 4)
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 0, 0, "排名").assertTrue()
	tdHudProjectionAcceptIcon(TD_HUD_STATUS_SECTION, 0, 0, "").assertTrue()
	tdHudProjectionAcceptStyle(TD_HUD_STATUS_SECTION, 0, 0, true, false).assertTrue()
	tdHudProjectionAcceptTitle(TD_HUD_STATUS_SECTION, "标题").assertTrue()
	tdHudProjectionBind(TD_HUD_STATUS_SECTION, null, 6, 16, 4)
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 0, 0, "排名").assertTrue()
	tdHudProjectionBind(TD_HUD_STATUS_SECTION, null, 6, 15, 4)
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 0, 0, "排名").assertTrue()
	tdHudProjectionBind(TD_HUD_STATUS_SECTION, null, 6, 15, 3)
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 0, 0, "排名").assertTrue()
	tdHudProjectionInvalidate(TD_HUD_STATUS_SECTION)
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 0, 0, "排名").assertTrue()

@Test function hudProjectionSectionsKeepIndependentFlatCellRanges()
	for section = TD_HUD_STATUS_SECTION to TD_HUD_COMPACT_TRIAL_SECTION
		tdHudProjectionInvalidate(section)
		tdHudProjectionBind(section, null, 0, 16, 4)
		tdHudProjectionAcceptValue(section, 15, 3, "独立尾格").assertTrue()
	for section = TD_HUD_STATUS_SECTION to TD_HUD_COMPACT_TRIAL_SECTION
		tdHudProjectionAcceptValue(section, 15, 3, "独立尾格").assertFalse()
	tdHudProjectionInvalidate(TD_HUD_DAMAGE_SECTION)
	tdHudProjectionAcceptValue(TD_HUD_STATUS_SECTION, 15, 3, "独立尾格").assertFalse()
	tdHudProjectionAcceptValue(TD_HUD_DAMAGE_SECTION, 15, 3, "独立尾格").assertTrue()
	tdHudProjectionAcceptValue(TD_HUD_TRIAL_SECTION, 15, 3, "独立尾格").assertFalse()
