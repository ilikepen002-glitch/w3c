package TDDamageTests
import TDDamageState
import TDDamageData
import TDState

@Test function damageCountsOnlyPositiveLifeAndCapsOverkill()
	tdEffectiveDamage(100.0, 30.0).assertEquals(30.0)
	tdEffectiveDamage(3.0, 30.0).assertEquals(3.0)
	tdEffectiveDamage(-3.0, 30.0).assertEquals(0.0)
	tdEffectiveDamage(3.0, 0.0).assertEquals(0.0)
	tdEffectiveDamage(3.0, -1.0).assertEquals(0.0)
	tdEffectiveDamage(0.0, 30.0).assertEquals(0.0)

@Test function damageCombinesHostSegmentsWithoutMovingEarlierHistory()
	let ledger = new TDDamageLedger()
	let host = ledger.register(0, "宿主塔")
	let nextHost = ledger.register(0, "下一宿主塔")
	let otherPlayerTower = ledger.register(1, "另一玩家")
	// Native attack, equipment and pet code hits all resolve to the source tower.
	ledger.credit(host, 100.0, 30.0).assertEquals(30.0)
	ledger.credit(host, 20.0, 100.0).assertEquals(20.0)
	ledger.credit(host, 10.0, 100.0).assertEquals(10.0)
	ledger.credit(nextHost, 40.0, 100.0)
	ledger.credit(otherPlayerTower, 45.0, 100.0)
	host.getTotal().assertEquals(60.0)
	nextHost.getTotal().assertEquals(40.0)
	ledger.playerTotal(0).assertEquals(100.0)
	ledger.playerTotal(1).assertEquals(45.0)
	ledger.count(0).assertEquals(2)
	(ledger.ranked(-1, 0) == host).assertTrue()
	(ledger.ranked(1, 0) == otherPlayerTower).assertTrue()
	host.retired = true
	host.label = "升级后塔"
	ledger.credit(host, 1.0, 100.0)
	ledger.playerTotal(0).assertEquals(101.0)
	ledger.reset()
	ledger.count(-1).assertEquals(0)
	ledger.playerTotal(0).assertEquals(0.0)
	let replacement = ledger.register(0, "新塔")
	replacement.getSerial().assertEquals(1)
	destroy ledger

@Test function damageSortsInstancesDeterministicallyAndRejectsInvalidRecords()
	let ledger = new TDDamageLedger()
	let foreign = new TDDamageLedger()
	(ledger.register(-1, "") == null).assertTrue()
	(ledger.register(4, "") == null).assertTrue()
	let first = ledger.register(0, "同名塔")
	let second = ledger.register(0, "同名塔")
	ledger.credit(first, 20.0, 100.0)
	ledger.credit(second, 20.0, 100.0)
	(ledger.ranked(0, 0) == first).assertTrue()
	(ledger.ranked(0, 1) == second).assertTrue()
	ledger.credit(second, 1.0, 100.0)
	(ledger.ranked(0, 0) == second).assertTrue()
	(ledger.ranked(0, -1) == null).assertTrue()
	(ledger.ranked(0, 2) == null).assertTrue()
	let foreignRecord = foreign.register(0, "")
	ledger.credit(foreignRecord, 10.0, 10.0).assertEquals(0.0)
	ledger.credit(null, 10.0, 10.0).assertEquals(0.0)
	foreign.credit(foreignRecord, -10.0, 10.0).assertEquals(0.0)
	foreignRecord.getTotal().assertEquals(0.0)
	destroy ledger
	destroy foreign

@Test function damagePagesClampEmptyAndBoundaryCounts()
	tdDamagePageCount(0).assertEquals(1)
	tdDamagePageCount(8).assertEquals(1)
	tdDamagePageCount(9).assertEquals(2)
	tdDamageClampedPage(99, 9).assertEquals(1)
	tdDamageClampedPage(-1, 9).assertEquals(0)
	tdDamageText(0.04).assertEquals("<0.1")
	tdDamageText(0.4).assertEquals("0.4")
	tdDamageText(0.0).assertEquals("0")

@Test function damagePageActionsFilterPlayersAndIsolateViewerState()
	tdResetState()
	tdSetLaneActive(0, true)
	tdSetLaneActive(1, true)
	tdDamageLedger.reset()
	tdResetDamageViews()
	for index = 0 to 8
		tdDamageLedger.register(0, "塔" + index.toString())
	let otherPlayer = tdDamageLedger.register(1, "另一玩家")
	tdDamageApplyPageAction(0, TD_DAMAGE_ACTION_NEXT).assertTrue()
	tdDamageViewerPage(0).assertEquals(1)
	tdDamageViewerPage(1).assertEquals(0)
	(tdDamageLedger.ranked(0, 8) != null).assertTrue()
	tdDamageApplyPageAction(0, TD_DAMAGE_ACTION_NEXT).assertTrue()
	tdDamageViewerPage(0).assertEquals(1)
	tdDamageApplyPageAction(0, TD_DAMAGE_ACTION_PLAYER_BASE + 1).assertTrue()
	tdDamageViewerLane(0).assertEquals(1)
	tdDamageViewerPage(0).assertEquals(0)
	(tdDamageLedger.ranked(tdDamageViewerLane(0), 0) == otherPlayer).assertTrue()
	tdDamageViewerLane(1).assertEquals(-1)
	tdDamageApplyPageAction(0, TD_DAMAGE_ACTION_NEXT).assertTrue()
	tdDamageViewerPage(0).assertEquals(0)
	tdDamageApplyPageAction(0, TD_DAMAGE_ACTION_CLOSE).assertTrue()
	tdDamageViewerLane(0).assertEquals(1)
	tdDamageApplyPageAction(0, TD_DAMAGE_ACTION_PLAYER_BASE + 2).assertFalse()
	tdDamageApplyPageAction(0, -1).assertFalse()
	tdDamageApplyPageAction(0, 8).assertFalse()
	tdDamageApplyPageAction(-1, TD_DAMAGE_ACTION_ALL).assertFalse()
	tdDamageApplyPageAction(0, TD_DAMAGE_ACTION_ALL).assertTrue()
	tdDamageViewerLane(0).assertEquals(-1)
	tdDamageApplyPageAction(0, TD_DAMAGE_ACTION_PREVIOUS).assertTrue()
	tdDamageViewerPage(0).assertEquals(0)
	tdDamageSetView(0, 4).assertFalse()
	tdDamagePageTitle(0).assertEquals("全部玩家 · 第 1/2 页")
	tdDamageLedger.reset()
	tdResetDamageViews()
	tdResetState()

@Test function damageStatisticsButtonHasItsOwnBookCell()
	tdDamageStatisticsButtonX().assertEquals(2)
	tdDamageStatisticsButtonY().assertEquals(0)
	(TD_FARMER_DAMAGE_STATISTICS_ABILITY_ID != 0).assertTrue()
