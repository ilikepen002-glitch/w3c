package TDPetDisplayTests
import TDPetDisplayRules
import TDPetState
import TDPetDisplayRuntime
import TDTowerCatalogData
import TDConfig

@Test function displayAllFifteenSpeciesOwnNewAnimationIndices()
	for species = 1 to 15
		tdPetDisplaySupported(species).assertTrue()
	tdPetDisplaySupported(0).assertFalse()
	tdPetDisplaySupported(16).assertFalse()
	TD_PET_DISPLAY_FLOAT.assertEquals(5)
	TD_PET_DISPLAY_CAST.assertEquals(9)
	tdPetDisplayIdleAction(0).assertEquals(6)
	tdPetDisplayIdleAction(1).assertEquals(7)
	tdPetDisplayIdleAction(2).assertEquals(8)
	tdPetDisplayIdleAction(3).assertEquals(6)
	tdPetDisplayDuration(6).assertEquals(0.8)
	tdPetDisplayDuration(7).assertEquals(1.2)
	tdPetDisplayDuration(8).assertEquals(3.0)
	tdPetDisplayDuration(9).assertEquals(1.2)

@Test function displayIdleStaggerIsDeterministicAndBoundedForEightySlots()
	for lane = 0 to 3
		for slot = 0 to 19
			for species = 1 to 15
				let gap = tdPetDisplayIdleGap(lane, slot, species)
				(gap >= 8.0 and gap <= 16.0).assertTrue()
				gap.assertEquals(tdPetDisplayIdleGap(lane, slot, species))
	tdPetDisplayIdleGap(0, 0, 1).assertEquals(9.5)
	tdPetDisplayIdleGap(0, 1, 1).assertEquals(10.0)

@Test function displayProfilesCoverAllThirtyFiveTowerRawcodes()
	for choice = TD_TOWER_CHOICE_ARCHER to TD_TOWER_CHOICE_GHOUL
		for level = 1 to 6
			for branch = 1 to (level == 6 ? 2 : 1)
				let typeId = tdTowerUnitIdForLevelBranch(choice, level, branch)
				tdTowerChoiceForUnitTypeId(typeId).assertEquals(choice)
				tdTowerLevelForUnitTypeId(typeId).assertEquals(level)
				tdPetDisplayHeight(typeId).assertEquals(tdPetDisplayModelHeight(choice, level) * (0.95 + level * 0.03) + 110.0)
	tdPetDisplayModelHeight(TD_TOWER_CHOICE_ARCHER, 4).assertEquals(110.0)
	tdPetDisplayModelHeight(TD_TOWER_CHOICE_ARCHER, 5).assertEquals(160.0)
	tdPetDisplayModelHeight(TD_TOWER_CHOICE_ORC, 4).assertEquals(135.0)
	tdPetDisplayModelHeight(TD_TOWER_CHOICE_ORC, 5).assertEquals(145.0)
	tdPetDisplayModelHeight(TD_TOWER_CHOICE_FOOTMAN, 4).assertEquals(115.0)
	tdPetDisplayModelHeight(TD_TOWER_CHOICE_FOOTMAN, 5).assertEquals(145.0)
	tdPetDisplayModelHeight(TD_TOWER_CHOICE_DRYAD, 4).assertEquals(155.0)
	tdPetDisplayModelHeight(TD_TOWER_CHOICE_DRYAD, 5).assertEquals(180.0)
	tdPetDisplayModelHeight(TD_TOWER_CHOICE_GHOUL, 4).assertEquals(105.0)
	tdPetDisplayModelHeight(TD_TOWER_CHOICE_GHOUL, 5).assertEquals(185.0)
	tdPetDisplayHeight(0).assertEquals(270.0)

@Test function displayInvalidationClearsOnlyCosmeticDeadlineAndCycle()
	let pet = new TDPet(0, 1, 1)
	pet.visualAction.assertEquals(-1)
	pet.visualNextAt.assertEquals(0.0)
	pet.visualCycle.assertEquals(0)
	(pet.visualLink == null).assertTrue()
	pet.readyAt = 99.0
	pet.visualAction = 9
	pet.visualNextAt = 12.0
	pet.visualCycle = 2
	pet.invalidateCombat()
	pet.visualAction.assertEquals(-1)
	pet.visualNextAt.assertEquals(0.0)
	pet.visualCycle.assertEquals(0)
	(pet.visualLink == null).assertTrue()
	pet.readyAt.assertEquals(99.0)
	pet.generation.assertEquals(1)
	tdPetDisplayCast(pet, null, 1, 100.0)
	tdPetDisplayTick(pet, 0, 100.0)
	pet.visualAction.assertEquals(-1)
	(pet.visualLink == null).assertTrue()
	pet.readyAt.assertEquals(99.0)
	pet.generation.assertEquals(1)
	destroy pet

@Test function displayScaleIsBoundedAndSpeciesSpecific()
	for species = 1 to 15
		let scale = tdPetDisplayScale(species)
		(scale >= 1.0 and scale <= 2.70).assertTrue()
	tdPetDisplayScale(1).assertEquals(1.46)
	tdPetDisplayScale(2).assertEquals(1.38)
	tdPetDisplayScale(14).assertEquals(2.66)
	tdPetDisplayScale(0).assertEquals(1.0)
	tdPetDisplayScale(16).assertEquals(1.0)
