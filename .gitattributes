# Deterministic generator outputs are compared byte for byte on every platform.
/wurst/towers/TDTowerTerrainMask.wurst text eol=lf
/maps/tower-terrain-mask.json text eol=lf

# The compiler lock hashes this reviewed patch byte for byte.
/tools/compiler/legacy-jass-array-capacity.patch text eol=lf

# Pet UI source assets and the preserved renderer have byte-exact contracts.
/assets/source/pet-ui/*.svg text eol=lf
/wurst/pets/TDPetUIView.wurst text eol=lf

# Map archives and imported textures must never undergo text conversion.
*.w3x binary
*.tga binary
