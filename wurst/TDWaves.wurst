	return 0

public function tdEnemyAcquisitionRange() returns real
	return 0.0

public function tdEnemyCollisionSize() returns real
	return 0.0

public function tdEnemySelectionScale() returns real
	return 1.0

public function tdEnemyNormalAbilities() returns string
	return ""

function UnitDefinition.tdApplyEscaperStats(string name, int hitPoints, int armor, int speed) returns UnitDefinition
	this
	..setName(name)
	..setDescription("只会沿路逃跑，不会反击。")
	..setHitPointsMaximumBase(hitPoints)
	..setDefenseBase(armor)
	..setSpeedBase(speed)
	// Native slows must be able to reduce speed below the unmodified base.
	..setSpeedMinimum(1)
	..setSpeedMaximum(speed)
	..setAttacksEnabled(tdEnemyAttacksEnabled())
	..setAcquisitionRange(tdEnemyAcquisitionRange())
	..setNormalAbilities(tdEnemyNormalAbilities())
	..setSelectionScale(tdEnemySelectionScale())
	..setCanFlee(false)
	..setSleeps(tdEnemySleepsAtNight())
	..setGoldBountyAwardedBase(tdEnemyNativeGoldBountyBase())
	..setGoldBountyAwardedNumberofDice(tdEnemyNativeGoldBountyDice())
	..setGoldBountyAwardedSidesperDie(tdEnemyNativeGoldBountySides())
	..setLumberBountyAwardedBase(0)
	..setLumberBountyAwardedNumberofDice(0)
	..setLumberBountyAwardedSidesperDie(0)
	..setCollisionSize(tdEnemyCollisionSize())
	..setPointValue(20)
	return this

