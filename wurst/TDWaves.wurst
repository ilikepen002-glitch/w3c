	if wave == 4
		return TD_WAVE_4_ELITE_UNIT_ID
	if wave == 12
		return TD_WAVE_12_ELITE_UNIT_ID
	if wave == 20
		return TD_WAVE_20_ELITE_UNIT_ID
	if wave == 28
		return TD_WAVE_28_ELITE_UNIT_ID
	if wave == 8
		return TD_WAVE_8_BOSS_UNIT_ID
	if wave == 16
		return TD_WAVE_16_BOSS_UNIT_ID
	if wave == 24
		return TD_WAVE_24_BOSS_UNIT_ID
	if wave == 32
		return TD_WAVE_32_BOSS_UNIT_ID
	return 0

public function tdWaveBossGuardUnitId(int wave) returns int
	if wave == 8
		return TD_WAVE_8_GUARD_UNIT_ID
	if wave == 16
		return TD_WAVE_16_GUARD_UNIT_ID
	if wave == 24
		return TD_WAVE_24_GUARD_UNIT_ID
	if wave == 32
		return TD_WAVE_32_GUARD_UNIT_ID
	return 0

public function tdIsEliteUnitTypeId(int unitTypeId) returns boolean
	return unitTypeId == TD_WAVE_4_ELITE_UNIT_ID or unitTypeId == TD_WAVE_12_ELITE_UNIT_ID or unitTypeId == TD_WAVE_20_ELITE_UNIT_ID or unitTypeId == TD_WAVE_28_ELITE_UNIT_ID

public function tdIsBossGuardUnitTypeId(int unitTypeId) returns boolean
	return unitTypeId == TD_WAVE_8_GUARD_UNIT_ID or unitTypeId == TD_WAVE_16_GUARD_UNIT_ID or unitTypeId == TD_WAVE_24_GUARD_UNIT_ID or unitTypeId == TD_WAVE_32_GUARD_UNIT_ID

public function tdIsBossUnitTypeId(int unitTypeId) returns boolean
	return unitTypeId == TD_WAVE_8_BOSS_UNIT_ID or unitTypeId == TD_WAVE_16_BOSS_UNIT_ID or unitTypeId == TD_WAVE_24_BOSS_UNIT_ID or unitTypeId == TD_WAVE_32_BOSS_UNIT_ID

public function tdWaveSpawnUnitId(int wave, int remainingCount) returns int
	let normalCount = tdWaveNormalEnemyCount(wave)
	let guardCount = tdWaveBossGuardEnemyCount(wave)
	// Counted timers emit remainingCount in descending order: guards first,
	// then Boss, then the unchanged normal segment.
	if tdWaveBossEnemyCount(wave) > 0 and remainingCount > normalCount
		if remainingCount > normalCount + tdWaveBossEnemyCount(wave)
			return tdWaveBossGuardUnitId(wave)
		return tdWaveSpecialUnitId(wave)
	if guardCount > 0 and remainingCount > normalCount
		return tdWaveBossGuardUnitId(wave)
	if tdWaveEliteEnemyCount(wave) > 0 and remainingCount > normalCount
		return tdWaveSpecialUnitId(wave)
	return tdWaveUnitId(wave)

public function tdWaveSpawnInterval(int wave) returns real
	if wave <= 1
		return 0.7875000000000001
	if wave <= 3
		return 0.735
	if wave <= 5
		return 0.66
	if wave <= 8
		return 0.585
	if wave <= 12
		return 0.5249999999999999
	if wave <= 16
		return 0.48
	if wave <= 20
		return 0.43499999999999994
	if wave <= 24
		return 0.405
	if wave <= 28
		return 0.375
	return 0.34500000000000003

// 本路真实完成的进度工资；只由既有单次波次结算发放。
public function tdWaveProgressWage(int wave) returns int
	if wave < 1 or wave > tdWaveCount() or (wave - 1) mod 3 != 0
		return 0
	return (wave + 5) * 10

