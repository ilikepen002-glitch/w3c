public function tdWaveCompositionText(int wave) returns string
	if wave < 1 or wave > tdWaveCount()
		return ""
	var text = tdWaveNormalEnemyCount(wave) > 0 ? tdWaveNormalName(wave) + " ×" + tdWaveNormalEnemyCount(wave) : ""
	if tdWaveEliteEnemyCount(wave) > 0
		text += "、" + tdWaveEliteName(wave) + " ×" + tdWaveEliteEnemyCount(wave).toString()
	if tdWaveBossGuardEnemyCount(wave) > 0
		text += "、" + tdWaveBossGuardName(wave) + " ×" + tdWaveBossGuardEnemyCount(wave).toString()
	if tdWaveBossEnemyCount(wave) > 0
		text += (text == "" ? "" : "、") + tdWaveBossName(wave) + " ×" + tdWaveBossEnemyCount(wave)
	return text

