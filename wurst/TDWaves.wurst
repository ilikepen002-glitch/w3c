public function tdWaveKillGold(int wave) returns int
	if wave <= 3
		return tdScaledEconomyValue(3)
	if wave <= 7
		return tdScaledEconomyValue(4)
	if wave <= 15
		return tdScaledEconomyValue(5)
	if wave <= 16
		return tdScaledEconomyValue(6)
	if wave <= 20
		return tdScaledEconomyValue(7)
	if wave <= 24
		return tdScaledEconomyValue(8)
	if wave <= 28
		return tdScaledEconomyValue(9)
	return tdScaledEconomyValue(10)

// Normal enemies doubled: split their kill income across both copies.
public function tdEnemyEconomyValue(int fullValue, int unitTypeId) returns int
	if tdIsEliteUnitTypeId(unitTypeId) or tdIsBossGuardUnitTypeId(unitTypeId) or tdIsBossUnitTypeId(unitTypeId)
		return fullValue
	return fullValue div 2

public function tdWaveKillGoldForUnitTypeId(int wave, int unitTypeId) returns int
	return tdEnemyEconomyValue(tdWaveKillGold(wave), unitTypeId)

public function tdWaveScoreValue(int wave) returns int
	if wave <= 0
		return 0
	return 1 + wave * 2 + tdWaveEliteEnemyCount(wave) * 3 + tdWaveBossGuardEnemyCount(wave) * 4 + tdWaveBossEnemyCount(wave) * 8

function tdWaveObjectParentId(int wave) returns int
	if wave == 1
		return 'hpea'
	if wave == 2
		return 'hfoo'
	if wave == 3
		return 'ugho'
	if wave == 4
		return 'hrif'
	if wave == 5
		return 'ogru'
	if wave == 6
		return 'edry'
	if wave == 7
		return 'esen'
	if wave == 8
		return 'uaco'
	if wave == 9
		return 'okod'
	if wave == 10
		return 'nfel'
	if wave == 11
		return 'otau'
	if wave == 12
		return 'uabo'
	if wave == 13
		return 'ncen'
	if wave == 14
		return 'hkni'
	if wave == 15
		return 'nbal'
	if wave == 16
		return 'opeo'
