package TDSpawn
import TDConfig
import TDAuraState
import TDState
import initlater TDGame
import TDWaves
import ClosureTimers
import Orders
import TDPetWild
import TDEnemyMechanicData
import TDEnemyMechanicRuntime
import TDWaveFlowState
import Table

constant Table tdEnemyMatchEpochs = new Table()

public function tdEnemyBelongsToCurrentMatch(unit enemy) returns boolean
	return enemy != null and tdEnemyMatchEpochs.hasInt(enemy.getHandleId()) and tdEnemyMatchEpochs.loadInt(enemy.getHandleId()) == tdFlowEpoch()

public function tdForgetEnemyMatch(unit enemy)
	if enemy != null
		tdEnemyMatchEpochs.removeInt(enemy.getHandleId())

rect tdWorldRect = GetWorldBounds()
int tdLaneEnemyCheckPlayer = -1
int tdLaneEnemyCheckWave = 0
boolean tdLaneEnemyCheckFound = false
// 测试环境可能缺少 World Editor rect 句柄；兜底时用接近 32x32 路点的半径，
// 避免在拐角前过早切到下一个 waypoint。
constant real TD_WAYPOINT_ARRIVAL_RADIUS = 16.0

// 把“属于哪一路、哪一波、是否已经按漏怪结算”编码进单位的 user data，
// 这样奖励和扣命都能直接从单位本身取回上下文。
function tdEncodeEnemyData(int playerId, int wave, int state) returns int
	return playerId * 10000 + wave * 100 + state

public function tdEnemyLaneId(unit enemy) returns int
	return enemy.getUserData() div 10000

public function tdEnemyWave(unit enemy) returns int
	return (enemy.getUserData() div 100) mod 100

function tdEnemyState(unit enemy) returns int
	return enemy.getUserData() mod 100

function tdSetEnemyData(unit enemy, int playerId, int wave, int state)
	enemy.setUserData(tdEncodeEnemyData(playerId, wave, state))

public function tdEnemyWasLeaked(unit enemy) returns boolean
	return tdEnemyState(enemy) >= 99

public function tdEnemyDeathWasSettled(unit enemy) returns boolean
	return tdEnemyState(enemy) >= 98

public function tdMarkEnemyKilled(unit enemy)
	tdSetEnemyData(enemy, tdEnemyLaneId(enemy), tdEnemyWave(enemy), 98)

public function tdMarkEnemyLeaked(unit enemy)
	tdSetEnemyData(enemy, tdEnemyLaneId(enemy), tdEnemyWave(enemy), 99)

public function tdEnemyWaypointIndex(unit enemy) returns int
	return tdEnemyState(enemy)

function tdSetEnemyWaypointIndex(unit enemy, int index)
	tdSetEnemyData(enemy, tdEnemyLaneId(enemy), tdEnemyWave(enemy), index)

public function tdEnemyUsesCreepGuard() returns boolean
	return false

function tdEnemyRemovesGuardPosition() returns boolean
	return true

public function tdEnemyRemovesGuardPositionForTest() returns boolean
	return tdEnemyRemovesGuardPosition()

function tdEnemyRuntimePathingEnabled() returns boolean
	return true

public function tdEnemyRuntimePathingEnabledForTest() returns boolean
	return tdEnemyRuntimePathingEnabled()

public function tdEnemyWaypointArrivalRadiusForTest() returns real
	return TD_WAYPOINT_ARRIVAL_RADIUS

function tdEnemyLaneOrderId() returns int
	return Orders.move

public function tdEnemyLaneOrderIdForTest() returns int
	return tdEnemyLaneOrderId()

public function tdEnemyLaneOrderNameForTest() returns string
	return "move"

function tdEnemyNeedsLaneOrderRefresh(int currentOrder, int laneOrderId) returns boolean
	return currentOrder != laneOrderId

public function tdEnemyNeedsLaneOrderRefreshForTest(int currentOrder, int laneOrderId) returns boolean
	return tdEnemyNeedsLaneOrderRefresh(currentOrder, laneOrderId)

function tdEnemyShouldIssueLaneOrder(int currentOrder, int laneOrderId, boolean waypointAdvanced) returns boolean
	return waypointAdvanced or tdEnemyNeedsLaneOrderRefresh(currentOrder, laneOrderId)

public function tdEnemyShouldIssueLaneOrderForTest(int currentOrder, int laneOrderId, boolean waypointAdvanced) returns boolean
	return tdEnemyShouldIssueLaneOrder(currentOrder, laneOrderId, waypointAdvanced)

function tdOrderEnemyAlongLane(unit enemy, boolean waypointAdvanced)
	if not tdEnemyBelongsToCurrentMatch(enemy)
		return
	let playerId = tdEnemyLaneId(enemy)
	if not tdIsLaneActive(playerId)
		return
	let laneOrderId = tdEnemyLaneOrderId()
	if not tdEnemyShouldIssueLaneOrder(enemy.getCurrentOrder(), laneOrderId, waypointAdvanced)
		return
	let waypointIndex = tdEnemyWaypointIndex(enemy)
	if waypointIndex < tdLaneWaypointCount(playerId)
		// 只有路线命令被中断或 waypoint 推进时才重新下令，
		// 避免每次轮询都重置正在执行的 move order。
		enemy.issuePointOrderById(laneOrderId, tdLaneWaypointPosition(playerId, waypointIndex))
	else
		enemy.issuePointOrderById(laneOrderId, tdLaneExitPosition(playerId))

public function tdOrderEnemyAlongLane(unit enemy)
	tdOrderEnemyAlongLane(enemy, false)

// 为指定路线生成一个敌人，并立刻把路线元数据绑定到它身上。
public function tdCreateEnemy(int playerId, int wave, int unitId) returns unit
	let enemy = createUnit(Player(TD_ENEMY_PLAYER_ID), unitId, tdLaneSpawnPosition(playerId), 0 .fromDeg())
	SetUnitCreepGuard(enemy, tdEnemyUsesCreepGuard())
	enemy.setPathing(tdEnemyRuntimePathingEnabled())
	if tdEnemyRemovesGuardPosition()
		enemy.removeGuardPosition()
	tdSetEnemyData(enemy, playerId, wave, 0)
	tdEnemyMatchEpochs.saveInt(enemy.getHandleId(), tdFlowEpoch())
	var role = TD_ENEMY_ROLE_NORMAL
	if tdIsBossUnitTypeId(unitId)
		role = TD_ENEMY_ROLE_BOSS
	else if tdIsBossGuardUnitTypeId(unitId)
		role = TD_ENEMY_ROLE_GUARD
	else if tdIsEliteUnitTypeId(unitId)
		role = TD_ENEMY_ROLE_ELITE
	tdEnemyMechanicRegister(enemy, playerId, wave, role)
	tdAuraRegisterTarget(enemy, false)
	tdOrderEnemyAlongLane(enemy)
	return enemy

public function tdEnemyHealthDisplayManagedByRuntimeForTest() returns boolean
	// 血条表现交给魔兽原生 UI，运行时不再维护 texttag 生命周期。
	return false

function tdPositionIsInsideRect(vec2 position, rect area) returns boolean
	return area != null
		and position.x >= GetRectMinX(area)
		and position.x <= GetRectMaxX(area)
		and position.y >= GetRectMinY(area)
		and position.y <= GetRectMaxY(area)

function tdEnemyReachedWaypointPosition(int playerId, int waypointIndex, vec2 position) returns boolean
	let waypointRect = tdLaneWaypointRect(playerId, waypointIndex)
	if waypointRect != null
		return tdPositionIsInsideRect(position, waypointRect)
	return position.distanceTo(tdLaneWaypointPosition(playerId, waypointIndex)) <= TD_WAYPOINT_ARRIVAL_RADIUS

public function tdEnemyReachedWaypointPositionForTest(int playerId, int waypointIndex, vec2 position) returns boolean
	return tdEnemyReachedWaypointPosition(playerId, waypointIndex, position)

function tdEnemyReachedWaypoint(unit enemy, int playerId, int waypointIndex) returns boolean
	return tdEnemyReachedWaypointPosition(playerId, waypointIndex, enemy.getPos())

function tdAdvanceEnemyWaypoint(unit enemy)
	if tdPetIsWild(enemy) or enemy == null or not tdEnemyBelongsToCurrentMatch(enemy) or not enemy.isAlive() or GetOwningPlayer(enemy) != Player(TD_ENEMY_PLAYER_ID) or tdEnemyWasLeaked(enemy)
		return
	let playerId = tdEnemyLaneId(enemy)
	let waypointIndex = tdEnemyWaypointIndex(enemy)
	var waypointAdvanced = false
	if waypointIndex < tdLaneWaypointCount(playerId)
		if tdEnemyReachedWaypoint(enemy, playerId, waypointIndex)
			// This is the reached index BEFORE increment, not the next destination.
			tdEnemyMechanicOnWaypoint(enemy, waypointIndex)
			tdSetEnemyWaypointIndex(enemy, waypointIndex + 1)
			waypointAdvanced = true
	tdOrderEnemyAlongLane(enemy, waypointAdvanced)

function tdLaneEnemyCheckEnum()
	let enemy = GetEnumUnit()
	// Keep every eligibility guard ahead of the optional wave match; avoid mixed and/or.
	if enemy == null or not tdEnemyBelongsToCurrentMatch(enemy) or tdLaneEnemyCheckFound or tdPetIsWild(enemy) or not enemy.isAlive() or GetOwningPlayer(enemy) != Player(TD_ENEMY_PLAYER_ID) or tdEnemyLaneId(enemy) != tdLaneEnemyCheckPlayer
		return
	if tdLaneEnemyCheckWave != 0 and tdEnemyWave(enemy) != tdLaneEnemyCheckWave
		return
	tdLaneEnemyCheckFound = true

function tdWaypointAdvanceEnum()
	let enemy = GetEnumUnit()
	tdAdvanceEnemyWaypoint(enemy)

// wave 0 queries all waves. ForGroup completes synchronously without yielding.
public function tdLaneHasLivingEnemies(int playerId, int wave) returns boolean
	tdLaneEnemyCheckPlayer = playerId
	tdLaneEnemyCheckWave = wave
	tdLaneEnemyCheckFound = false
	let g = CreateGroup()
	g.enumUnitsInRect(tdWorldRect)
	ForGroup(g, function tdLaneEnemyCheckEnum)
	g.destr()
	return tdLaneEnemyCheckFound

public function tdLaneHasLivingEnemies(int playerId) returns boolean
	return tdLaneHasLivingEnemies(playerId, 0)

function tdWaitForLaneToClear(int playerId, int wave, int epoch)
	doPeriodically(0.40) cb ->
		if epoch != tdFlowEpoch() or tdIsGameOver() or not tdIsLaneActive(playerId) or tdIsLaneDefeated(playerId) or tdIsWaveResolved(playerId, wave)
			destroy cb
		else if not tdLaneHasLivingEnemies(playerId, wave)
			destroy cb
			tdHandleWaveFinished(playerId, wave)

// 按时间间隔逐个刷出这一波的怪，等该路这一波的存活敌人都消失后，
// 再由 TDGame 决定发奖励还是开启下一波。
public function tdLaneCanReceiveSpawns(int playerId) returns boolean
	if not tdIsLanePlayer(playerId)
		return false
	return not tdIsGameOver() and tdIsLaneActive(playerId) and not tdIsLaneDefeated(playerId) and not tdIsLaneFinished(playerId)

public function tdSpawnWave(int playerId, int wave)
	if not tdLaneCanReceiveSpawns(playerId)
		return
	if tdIsPureBossWave(wave)
		return
	let epoch = tdFlowEpoch()
	let generation = tdFlowBeginSpawn(playerId)
	if generation == 0
		return
	let count = tdWaveEnemyCount(wave)
	let interval = tdWaveSpawnInterval(wave)
	tdPetWildOnWave(playerId, wave)
	doPeriodicallyCounted(interval, count) cb ->
		if not tdFlowSpawnCallbackValid(playerId, epoch, generation) or not tdLaneCanReceiveSpawns(playerId)
			tdFlowEndSpawn(playerId, generation)
			destroy cb
			return
		let typeId = tdWaveSpawnUnitId(wave, cb.getCount())
		tdCreateEnemy(playerId, wave, typeId)
		if cb.getCount() == 1
			tdFlowEndSpawn(playerId, generation)
	doAfter(interval * count + 0.25) ->
		if tdFlowSpawnCallbackValid(playerId, epoch, generation) and tdLaneCanReceiveSpawns(playerId)
			tdWaitForLaneToClear(playerId, wave, epoch)

public function tdStartLaneWaypointWatcher()
	let epoch = tdFlowEpoch()
	// 用轻量轮询检测区域进入，避免每个 waypoint 都单独创建触发器和状态。
	doPeriodically(0.20) cb ->
		if epoch != tdFlowEpoch()
			destroy cb
			return
		let g = CreateGroup()
		g.enumUnitsInRect(tdWorldRect)
		ForGroup(g, function tdWaypointAdvanceEnum)
		g.destr()
		tdEnemyMechanicsTick()
		if tdIsGameOver()
			destroy cb


