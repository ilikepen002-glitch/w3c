package TDPetData

public constant int TD_PET_CAPTURE_ABILITY_ID = 'Pcap'
public constant int TD_PET_COLLECTION_ABILITY_ID = 'Pcol'
public constant int TD_PET_DEPLOY_ABILITY_ID = 'Pdep'
public constant int TD_PET_BALL_ITEM_ID = 'Ibal'
public constant int TD_PET_DAMAGE_ID = 'Pdam'
public constant int TD_PET_COLLECTION_LIMIT = 20
public constant int TD_PET_BALL_LIMIT = 60
public constant int TD_PET_SPECIES_COUNT = 15

public function tdPetWildUnitId(int wave, int species) returns int
	if wave < 1 or wave > 32 or species < 1 or species > 15
		return 0
	let high = wave div 16
	let low = wave mod 16
	return 'p000' + (high >= 10 ? high + 7 : high) * 65536 + (low >= 10 ? low + 7 : low) * 256 + species + (species >= 10 ? 7 : 0)

public function tdPetVisualUnitId(int species) returns int
	if species < 1 or species > TD_PET_SPECIES_COUNT
		return 0
	return tdPetHexRawcode('pv00', species, 16)

function tdPetHexDigit(int ascii) returns int
	if ascii >= 48 and ascii <= 57
		return ascii - 48
	if ascii >= 65 and ascii <= 70
		return ascii - 55
	return -100

// Stable type identity in O(1), including after death settlement.
public function tdPetSpeciesForWildType(int typeId) returns int
	let species = tdPetHexDigit(typeId mod 256)
	if species < 1 or species > 15 or typeId div 16777216 != 112
		return 0
	let high = tdPetHexDigit((typeId div 65536) mod 256)
	let low = tdPetHexDigit((typeId div 256) mod 256)
	if high < 0 or high > 15 or low < 0 or low > 15
		return 0
	let wave = high * 16 + low
	return wave >= 1 and wave <= 32 ? species : 0
public function tdPetSpeciesElement(int species) returns int
	return species >= 1 and species <= 15 ? (species - 1) div 3 + 1 : 0

public function tdPetElementName(int element) returns string
	if element == 1
		return "金"
	if element == 2
		return "木"
	if element == 3
		return "水"
	if element == 4
		return "火"
	return element == 5 ? "土" : "未知"

