package TDPetActivePeriodic
import TDPetCastContext
import TDPetRouteSnapshot
import TDPetActiveVisuals
import TDPetActiveRules
import TDPetActiveDirect
import TDEnemySlowState
import TDAuraRules
import TDEnemyMechanicRuntime
import TDPetEffectTargetState
import TDWaves

function TDPetCastContext.area(vec2 point, real radius, real power)
	this.candidates.enumUnitsInRange(point, radius)
	var hits = 0
	for target in this.candidates
		if not this.valid()
			break
		if hits < 12 and this.aoeValid(target) and point.distanceTo(target.getPos()) <= radius
			this.hit(target, power)
			hits += 1

function TDPetCastContext.segment(vec2 point, real radius, real power, boolean roots)
	this.candidates.enumUnitsInRange(point, radius)
	var hits = 0
	for target in this.candidates
		if not this.valid()
			break
		if not this.aoeValid(target) or hits >= 12
			continue
		let index = this.remember(target)
		if index < 0 or this.hitCounts[index] >= 2
			continue
		this.hitCounts[index] = this.hitCounts[index] + 1
		if roots and not this.controlled[index] and this.controlCount < 6
			this.controlled[index] = true
			if this.control(target, 1, 0.35)
				this.controlCount += 1
		this.hit(target, power)
		hits += 1

function TDPetCastContext.zone(real now)
	// Sample the original <=12 enumeration order, then retain only live identities.
	// The borrowed scratch handles are cleared before any synchronous pulse damage.
	let identity = this.skill == 30 ? TD_AURA_PET_VORTEX : TD_AURA_PET_SEAL
	let radius = this.skill == 30 ? 280.0 : 260.0
	let power = this.skill == 30 ? 0.25 : 0.15
	this.candidates.enumUnitsInRange(this.center, radius)
	var sampleCount = 0
	for target in this.candidates
		if not this.valid()
			break
		if sampleCount < 12 and this.aoeValid(target)
			this.zoneSamples[sampleCount] = target
			this.zoneSampleRevisions[sampleCount] = this.revisionFor(target)
			this.zoneSamplePowers[sampleCount] = power * (tdIsBossUnitTypeId(GetUnitTypeId(target)) ? 0.5 : 1.0)
			sampleCount += 1
	var retainedIndex = 0
	while retainedIndex < this.victimCount
		var retained = false
		let position = this.targetPositions[retainedIndex]
		if position != null and position.target == this.victims[retainedIndex] and position.revision == this.revisions[retainedIndex]
			for sample = 0 to sampleCount - 1
				if this.victims[retainedIndex] == this.zoneSamples[sample] and this.zoneSlowPowers[retainedIndex] == this.zoneSamplePowers[sample] and tdPetZoneCoverageReusable(this.revisions[retainedIndex], this.zoneSampleRevisions[sample], position.retired)
					retained = true
					break
		if retained
			retainedIndex += 1
		else
			this.forgetZoneVictim(retainedIndex, identity)
	var committedCount = 0
	for sample = 0 to sampleCount - 1
		let target = this.zoneSamples[sample]
		let sampledPower = this.zoneSamplePowers[sample]
		this.zoneSamples[sample] = null
		this.zoneSampleRevisions[sample] = 0
		this.zoneSamplePowers[sample] = 0.0
		if this.valid() and this.aoeValid(target)
			let slot = this.remember(target)
			if slot >= 0
				// Swap every zone-owned field; legacy other-skill slots stay untouched.
				this.swapZoneVictimSlots(committedCount, slot)
				committedCount += 1
				this.slow(target, identity, this.skill == 30 ? 0.25 : 0.15, 0.30)
				this.zoneSlowPowers[committedCount - 1] = sampledPower
				if this.skill == 37 and this.valid()
					tdEnemyMechanicOfferStageWeakening(target, this.host, this castTo int, 0.30)
	while this.victimCount > committedCount
		this.forgetZoneVictim(this.victimCount - 1, identity)
	if this.skill == 30 and this.stage > 0 and this.stage mod 2 == 0
		this.visualVortexPulse()
		for index = 0 to this.victimCount - 1
			if not this.valid()
				break
			this.hit(this.victims[index], 0.20)
	this.stage += 1
	this.nextAt = this.createdAt + this.stage * 0.25

function TDPetCastContext.seed()
	if this.stage < 3
		if this.primaryValid()
			this.setLastPosition(0, this.primary.getPos())
			this.visualSeedPulse(this.primary.getPos())
			this.hitPrimary(0.35)
		this.stage += 1
		if this.stage < 3
			this.nextAt = this.createdAt + this.stage + 1.0
	if this.stage == 3
		// Propagation is a single, bounded generation at the planned end, even
		// if the original died. Dead trial replacements never become this origin.
		let point = this.lastPosition(0)
		this.visualSeedSpread(point)
		this.candidates.enumUnitsInRange(point, 240.0)
		for target in this.candidates
			if not this.valid()
				break
			if this.victimCount >= 4
				break
			if target != this.primary and this.aoeValid(target)
				this.remember(target)
				this.visualSeedBranch(point, target.getPos())
		this.stage = 4
		this.nextAt = this.createdAt + 4.0
	else if this.stage == 4 or this.stage == 5
		this.clearVisuals()
		for index = 1 to this.victimCount - 1
			if not this.valid()
				break
			if this.targetValid(this.victims[index], this.revisions[index])
				this.addVisual(TD_PET_VFX_POISON, this.victims[index].getPos())
				this.hit(this.victims[index], 0.15)
		this.stage += 1
		this.nextAt = this.createdAt + 5.0

function TDPetCastContext.fireChain()
	if this.stage >= this.markCount
		return
	let marked = this.victims[this.stage]
	let point = this.lastPosition(this.stage)
	this.visualChainBurst(point)
	// Reserve/consume the mark before damage may synchronously retire it.
	let ownIndex = this.stage
	this.stage += 1
	var hits = 0
	if this.targetValid(marked, this.revisions[ownIndex])
		this.hit(marked, 1.20)
		hits = 1
	this.candidates.enumUnitsInRange(point, 180.0)
	for target in this.candidates
		if not this.valid()
			break
		if target == marked or not this.aoeValid(target) or hits >= 12
			continue
		let index = this.remember(target)
		if index < 0 or this.hitCounts[index] >= 2
			continue
		this.hitCounts[index] = this.hitCounts[index] + 1
		this.hit(target, 0.25)
		hits += 1
	this.nextAt = this.createdAt + 0.60 + this.stage * 0.20

public function TDPetCastContext.stepPeriodic(real now) returns boolean
	if this.skill == 21
		if tdPetEffectDue(now, this.nextAt) and this.stage < 4
			if not this.primaryValid()
				return false
			this.visualSwordCut(this.primary.getPos())
			this.hitPrimary(0.60)
			this.stage += 1
			this.nextAt = this.createdAt + this.stage * 0.20
		return this.stage < 4
	if this.skill == 22
		if tdPetEffectDue(now, this.nextAt) and this.stage < 4
			this.visualSwordDrop()
			this.area(this.center, 260.0, 0.45)
			this.stage += 1
			this.nextAt = this.createdAt + this.stage + 1.0
		return this.stage < 4
	if this.skill == 24
		if tdPetEffectDue(now, this.nextAt)
			this.seed()
		return this.stage < 6
	if this.skill == 25
		if tdPetEffectDue(now, this.nextAt) and now < this.expiresAt
			for flower = 0 to 2
				if not this.valid() or this.victimCount >= 12
					break
				this.candidates.enumUnitsInRange(this.road.pointAt(flower), 100.0)
				for target in this.candidates
					if not this.valid() or this.victimCount >= 12
						break
					if this.aoeValid(target) and this.victimIndex(target) < 0 and this.victimCount < 12
						this.remember(target)
						this.visualFlowerContact(flower)
						this.hit(target, 1.0)
			this.stage += 1
			this.nextAt = this.createdAt + this.stage * 0.25
		return now < this.expiresAt
	if this.skill == 26 or this.skill == 38
		let cap = this.skill == 26 ? 3 : 4
		if tdPetEffectDue(now, this.nextAt) and this.stage < cap
			let current = this.stage
			this.stage += 1
			this.visualRoadSegment(current)
			this.segment(this.road.pointAt(current), this.skill == 26 ? 150.0 : 160.0, this.skill == 26 ? 0.70 : 0.85, this.skill == 26)
			this.nextAt = this.createdAt + this.stage * (this.skill == 26 ? 0.40 : 0.20)
		return now < this.expiresAt
	if this.skill == 30 or this.skill == 37
		if tdPetEffectDue(now, this.nextAt) and now <= this.expiresAt + 0.05
			this.zone(now)
		return now < this.expiresAt
	if this.skill == 31
		if tdPetEffectDue(now, this.nextAt) and this.stage < 4
			if not this.primaryValid()
				return false
			this.visualBrandPulse(this.primary.getPos())
			this.hitPrimary(0.35)
			this.stage += 1
			this.nextAt = this.createdAt + this.stage + 1.0
		return this.stage < 4
	if this.skill == 33
		if tdPetEffectDue(now, this.nextAt) and this.stage < 4
			this.visualMeteorImpact()
			this.area(this.center, 240.0, this.stage == 0 ? 1.30 : 0.25)
			this.stage += 1
			this.nextAt = this.createdAt + 0.75 + this.stage
		return this.stage < 4
	if this.skill == 34
		if tdPetEffectDue(now, this.nextAt) and this.stage < this.markCount
			this.fireChain()
		return this.stage < this.markCount
	return false
