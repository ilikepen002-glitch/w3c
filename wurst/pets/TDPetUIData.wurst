package TDPetUIData
import TDPetData
import TDPetHeroData
import TDPetHeroRules

// Full imported paths must use explicit object setters, never presetIcon.
function importedIcon(string name) returns string
	return "war3mapImported\\BTN" + name + ".blp"

public function tdPetCaptureIconPath() returns string
	return importedIcon("TDActionCaptureOrb")

public function tdPetMenuToolsIconPath() returns string
	return importedIcon("TDPetMenuTools")

public function tdPetCollectionIconPath() returns string
	return importedIcon("TDPetCollection")

public function tdPetDeployIconPath() returns string
	return importedIcon("TDPetDeploy")

public function tdPetUICommandIconPath(int command) returns string
	if command == 0
		return tdPetCollectionIconPath()
	if command == 1
		return importedIcon("TDPetPrevious")
	if command == 2
		return importedIcon("TDPetNext")
	if command == 3
		return importedIcon("TDPetReturnBuilder")
	if command == 4
		return tdPetDeployIconPath()
	if command == 5
		return importedIcon("TDPetRecall")
	if command == 6
		return importedIcon("TDPetCultivate")
	return importedIcon("TDPetInfo")

function tdPetSpeciesIconStem(int species) returns string
	return "TDPetSpecies" + (species < 10 ? "0" : "") + species.toString()

public function tdPetSpeciesIconPath(int species) returns string
	return importedIcon(tdPetSpeciesIconStem(species))

public function tdPetSpeciesQualityIconPath(int species, int quality) returns string
	return importedIcon(tdPetSpeciesIconStem(species) + "Q" + quality)

public function tdPetManagerCommandIconPath(int action) returns string
	if action <= 7
		return tdPetUICommandIconPath(action)
	if action == 8
		return importedIcon("TDPetNext")
	if action == 9
		return importedIcon("TDPetReturnBuilder")
	if action >= 10 and action <= 13
		return importedIcon("TDPetCultivate")
	if action == 14
		return importedIcon("TDPetEmptySlot")
	if action == 15 or action == 19
		return importedIcon("TDPetRelease")
	if action == 16 or action == 22
		return importedIcon("TDPetInfo")
	if action == 17
		return importedIcon("TDPetKeepOld")
	if action == 18
		return importedIcon("TDPetUseNew")
	if action == 20
		return importedIcon("TDPetKeep")
	if action == 21
		return importedIcon("TDPetCultivate")
	return importedIcon("TDPetAdopt")

public function tdPetSkillIconName(int skill) returns string
	if tdPetHeroDefined(skill)
		return tdPetHeroIconName(skill)
	if skill == 19
		return "BTNImpalingBolt"
	if skill == 20
		return "BTNTDPetSkillSunderingBlade"
	if skill == 21
		return "BTNTDPetSkillBladeRain"
	if skill == 22
		return "BTNTDPetSkillSwordFormation"
	if skill == 23
		return "BTNTDPetSkillVineBind"
	if skill == 24
		return "BTNTDPetSkillParasiticSeed"
	if skill == 25
		return "BTNTDPetSkillCorrosiveBlossom"
	if skill == 26
		return "BTNTDPetSkillAdvancingRoots"
	if skill == 27
		return "BTNColdArrows"
	if skill == 28
		return "BTNOrbOfFrost"
	if skill == 29
		return "BTNFrostNova"
	if skill == 30
		return "BTNTornado"
	if skill == 31
		return "BTNImmolationOn"
	if skill == 32
		return "BTNTDPetSkillCrimsonLotus"
	if skill == 33
		return "BTNInfernal"
	if skill == 34
		return "BTNTDPetSkillChainConflagration"
	if skill == 35
		return "BTNThunderClap"
	if skill == 36
		return "BTNTDPetSkillMountainShockwave"
	if skill == 37
		return "BTNDevotion"
	if skill == 38
		return "BTNTDPetSkillEarthFracture"
	if skill == 0
		return "BTNGauntletsOfOgrePower"
	if skill == 1
		return "BTNSteelMelee"
	if skill == 2
		return "BTNTDPetSkillSwiftAssault"
	if skill == 3
		return "BTNBrilliance"
	if skill == 4
		return "BTNCommand"
	if skill == 5
		return "BTNSlow"
	if skill == 6
		return "BTNFaerieFire"
	if skill == 7
		return "BTNTDPetSkillChargedHit"
	if skill == 8
		return "BTNCriticalStrike"
	if skill == 9
		return "BTNColdArrows"
	if skill == 10
		return "BTNDeathAndDecay"
	if skill == 11
		return "BTNBloodLust"
	if skill == 12
		return "BTNInnerFire"
	if skill == 13
		return "BTNChainLightning"
	if skill == 14
		return "BTNImmolationOn"
	if skill == TD_PET_SKILL_COMBO
		return "BTNTDPetSkillComboAttack"
	if skill == TD_PET_SKILL_RESOLVE
		return "BTNTDPetSkillResoluteStrike"
	if skill == TD_PET_SKILL_HEAVY
		return "BTNTDPetSkillHeavyBlow"
	return "BTNCyclone"

// Shared by collection slots and cultivation previews. Keep DISBTN native lookup
// intact while custom normal artwork uses its actual imported MPQ path.
public function tdPetSkillIconPath(int skill, boolean disabled) returns string
	let name = tdPetSkillIconName(skill)
	if disabled
		return "ReplaceableTextures\\CommandButtonsDisabled\\DIS" + name + ".blp"
	if SubString(name, 0, 13) == "BTNTDPetSkill"
		return "war3mapImported\\" + name + ".blp"
	return "ReplaceableTextures\\CommandButtons\\" + name + ".blp"

public function tdPetSlotIconPath(int variant) returns string
	if variant == TD_PET_SLOT_EMPTY
		return importedIcon("TDPetEmptySlot")
	return tdPetSkillIconPath(variant mod TD_PET_SKILL_COUNT, variant >= TD_PET_SKILL_COUNT)
