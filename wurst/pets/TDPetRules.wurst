package TDPetRules
import BitSet
import TDTooltipText

public function tdPetSkillCountForRoll(int roll) returns int
	return roll <= 55 ? 2 : (roll <= 90 ? 3 : 4)

public function tdPetQualityForRoll(int roll) returns int
	return roll <= 45 ? 1 : (roll <= 75 ? 2 : (roll <= 95 ? 3 : 4))

public function tdPetResonanceForWave(int wave) returns int
	return wave >= 8 ? 3 : (wave >= 4 ? 2 : 1)

public function tdPetUnlockedSlots(int level) returns int
	return level + 1

public function tdPetFixedEncounter(int wave) returns boolean
	return wave == 1 or wave == 3 or wave == 5 or wave == 7 or wave == 10 or wave == 13 or wave == 17 or wave == 19 or wave == 22 or wave == 25

public function tdPetStageStart(int stage) returns int
	return stage == 0 ? 1 : (stage == 1 ? 7 : (stage == 2 ? 13 : 19))

public function tdPetStageEnd(int stage) returns int
	return stage == 3 ? 25 : tdPetStageStart(stage) + 5

public function tdPetStageBallReward(int wave) returns int
	return wave == 4 or wave == 8 or wave == 13 or wave == 19 ? 6 : 0

public function tdPetSkillIsNumeric(int skill) returns boolean
	return skill >= 0 and skill <= 3

public function tdPetSkillIsActive(int skill) returns boolean
	return skill >= 11 and skill <= 15

public function tdPetSkillIsUniversal(int skill) returns boolean
	return skill >= 4 and skill != 9 and skill != 10

public function tdPetSkillAllowed(int skill, int slot, int usedMask, boolean hasActive) returns boolean
	if skill < 0 or skill >= 16 or bitset(usedMask).get(skill)
		return false
	if slot == 0
		return tdPetSkillIsNumeric(skill)
	// Use explicit short-circuit branches: the fixed JASS printer misgroups mixed and/or.
	if tdPetSkillIsNumeric(skill)
		return false
	if slot == 1 and not tdPetSkillIsUniversal(skill)
		return false
	if hasActive and tdPetSkillIsActive(skill)
		return false
	return true

public function tdPetSkillNameById(int skill) returns string
	if skill == 0
		return "坚韧之力"
	if skill == 1
		return "战意"
	if skill == 2
		return "疾攻"
	if skill == 3
		return "灵感"
	if skill == 4
		return "统御光环"
	if skill == 5
		return "迟滞领域"
	if skill == 6
		return "破甲印记"
	if skill == 7
		return "连击蓄能"
	if skill == 8
		return "处决追击"
	if skill == 9
		return "分裂霜箭"
	if skill == 10
		return "腐尸毒域"
	if skill == 11
		return "狂热"
	if skill == 12
		return "蓄力"
	if skill == 13
		return "雷链"
	if skill == 14
		return "火焰冲击"
	return "风缚"

public function tdPetQualityName(int quality) returns string
	return quality == 1 ? "|cffffffff白|r" : (quality == 2 ? "|cff40dd40绿|r" : (quality == 3 ? "|cff4090ff蓝|r" : "|cffc060ff紫|r"))

public function tdPetSkillPower(int skill, int quality) returns real
	if skill == 0
		return 8.0 * quality
	if skill == 1 or skill == 2 or skill == 3 or skill == 4
		return 0.06 * quality
	if skill == 5 or skill == 9
		return 0.08 + 0.04 * quality
	if skill == 6
		return quality * 2.0
	return 0.25 + quality * 0.15

public function tdPetSkillDescriptionById(int skill, int quality) returns string
	let power = tdPetSkillPower(skill, quality)
	if skill == 0
		return "附身塔攻击力+" + power.toInt().toString() + "。"
	if skill == 1
		return "附身塔基础攻击 +" + (power * 100.0 + 0.5).toInt().toString() + "%"
	if skill == 2
		return "附身塔攻击速度 +" + (power * 100.0 + 0.5).toInt().toString() + "%"
	if skill == 3
		return "附身塔的嗜血、剑刃风暴及精灵主动技能冷却缩短" + (power * 100.0 + 0.5).toInt().toString() + "%。|n嗜血、剑刃风暴与装备冷却缩减合计上限40%。"
	if skill == 4
		return "全队所有塔攻击速度 +" + (power * 100.0 + 0.5).toInt().toString() + "%；同类精灵光环取最强效果。"
	if skill == 5
		return "附身塔600范围内本路敌人移动速度降低 " + (power * 100.0 + 0.5).toInt().toString() + "%；精灵减速取最强效果。"
	if skill == 6
		return "普攻使目标护甲降低" + power.toInt().toString() + "，持续3秒。同类精灵破甲取最强效果。"
	if skill == 7
		return "附身塔每第4次普攻命中，追加本次普攻伤害的" + (power * 100.0 + 0.5).toInt().toString() + "%。"
	if skill == 8
		return "普攻命中生命值不高于30%的敌人时，追加本次普攻伤害的" + (power * 100.0 + 0.5).toInt().toString() + "%。"
	if skill == 9
		return "分裂箭命中后，敌人移动速度降低" + (power * 100.0 + 0.5).toInt().toString() + "%，持续3秒；精灵减速取最强效果。|n仅对拥有分裂箭的附身塔生效。"
	if skill == 10
		return "尸爆在原地留下180范围毒域，持续3秒，每秒对最多12名本路敌人造成" + tdTooltipNumber(36.0 * power) + "伤害。|n仅对拥有尸爆的附身塔生效；不随尸爆进化增伤。"
	if skill == 11
		return "普攻自动触发：附身塔攻击速度 +" + (power * 100.0 + 0.5).toInt().toString() + "%，持续6秒；基础冷却14秒，可受灵感缩短"
	if skill == 12
		return "普攻自动触发：附身塔基础攻击 +" + (power * 100.0 + 0.5).toInt().toString() + "%，持续6秒；基础冷却14秒，可受灵感缩短"
	if skill == 13
		return "普攻自动触发雷链：攻击目标周围450范围内最多3名本路敌人，各受本次普攻伤害的" + (power * 100.0 + 0.5).toInt().toString() + "%。|n基础冷却10秒，可受灵感缩短。"
	if skill == 14
		return "普攻自动触发火焰冲击：攻击目标周围220范围内最多12名本路敌人，各受本次普攻伤害的" + (power * 100.0 + 0.5).toInt().toString() + "%。|n基础冷却10秒，可受灵感缩短。"
	return "普攻自动触发风缚：攻击目标周围220范围内最多12名本路敌人移动速度降低" + (RMinBJ(0.75, power) * 100.0 + 0.5).toInt().toString() + "%，持续3秒；精灵减速取最强效果。|n基础冷却10秒，可受灵感缩短。"




// Same fixed independent 2% bucket as the former wild-kill material reward.
public function tdPetReleaseGetsSlotStone(int roll) returns boolean
	return roll >= 1 and roll <= 2

public function tdPetReleaseLifecycleAllows(boolean deployed, boolean released, boolean proposal) returns boolean
	return not deployed and not released and not proposal

// Stable collection numbers are independent of count and never compact on release.
public function tdPetCollectionNumber(int slot) returns string
	if slot < 0 or slot >= 20
		return "--"
	return slot < 9 ? "0" + (slot + 1) : (slot + 1).toString()

public function tdPetPageSlot(int page, int cell) returns int
	return page >= 0 and page <= 1 and cell >= 0 and cell < 10 ? page * 10 + cell : -1

public function tdPetStepSlot(int slot, int direction) returns int
	if slot < 0 or slot >= 20
		return -1
	if direction != -1 and direction != 1
		return -1
	return (slot + direction + 20) mod 20

// Include every owned skill, even resonance-locked ones. Candidate qualities are absent.
public function tdPetOwnedQuality(int count, int first, int second, int third, int fourth) returns int
	var quality = 1
	if count >= 1
		quality = IMaxBJ(quality, first)
	if count >= 2
		quality = IMaxBJ(quality, second)
	if count >= 3
		quality = IMaxBJ(quality, third)
	if count >= 4
		quality = IMaxBJ(quality, fourth)
	return IMinBJ(4, quality)
