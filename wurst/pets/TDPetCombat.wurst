import TDEquipmentTrialAoe
import TDWaveFlowState

boolean tdPetCombatReady = false

public function tdPetDamageSourceEligible(boolean codeDamage, boolean spellDamage, int eventId) returns boolean
	return not codeDamage and not spellDamage and eventId != 'Tspl' and eventId != TD_PET_DAMAGE_ID

// Stable across early/post, including lethal hits, no-pet hits and binding changes.
// Production abortCurrent is forbidden: the locked library would skip every post.
function tdPetOriginalPhaseEvent() returns boolean
	return tdPetDamageSourceEligible(DamageEvent.isCode(), DamageEvent.isSpell(), DamageEvent.getId()) and DamageEvent.getUnreducedOriginalAmount() > 0.0

public function tdPetBindingValid(TDPet pet, unit host, int generation) returns boolean
	return pet != null and not pet.released and pet.host == host and pet.generation == generation and not pet.paused and host != null and host.isAlive() and tdTowerChoiceForUnitTypeId(GetUnitTypeId(host)) != 0 and GetPlayerId(GetOwningPlayer(host)) == pet.lane and tdPetLaneCanAct(pet.lane)

public function tdPetSkillFitsAbilities(int skill, boolean hasSplitArrow, boolean hasCorpseExplosion) returns boolean
	if skill == 9
		return hasSplitArrow
	if skill == 10
		return hasCorpseExplosion
	return true

public function tdPetSkillFitsHost(int skill, unit host) returns boolean
	if host == null
		return false
	if skill == TD_PET_SKILL_RESOLVE
		return tdPetResolveFitsAbilities(host.getAbilityLevel(TD_ORC_CRIT_ABILITY_ID) > 0, host.getAbilityLevel(TD_ORC_PERFECT_CRIT_ABILITY_ID) > 0)
	return tdPetSkillFitsAbilities(skill, host.getAbilityLevel(TD_ARCHER_SPLIT_ARROW_ABILITY_ID) > 0, host.getAbilityLevel(TD_GHOUL_CORPSE_EXPLOSION_DISPLAY_ABILITY_ID) > 0)

public function tdPetProcReady(boolean pending, real now, real readyAt) returns boolean
	return not pending and now >= readyAt

function damage(TDPet pet, unit host, int generation, unit target, real amount)
	if not tdPetBindingValid(pet, host, generation) or not tdPetEnemyIsValid(target, pet.lane) or amount <= 0.0
		return
	DamageEvent.setNextDamageFromCode()
	DamageEvent.setNextDamageId(TD_PET_DAMAGE_ID)
	host.damageTarget(target, amount)

// Only spell procs use this wrapper; combo/execute derived attacks use damage.
function spellDamage(TDPet pet, unit host, int generation, unit target, real amount)
	damage(pet, host, generation, target, tdEnemyMechanicScaleSpellDamage(target, amount))

function setBonus(unit tower, int abilityId, int level)
	let clamped = IMinBJ(level, abilityId == TD_PET_ATTACK_BONUS_ID ? 512 : 150)
	if clamped <= 0
		tower.removeAbility(abilityId)
	else
		if tower.getAbilityLevel(abilityId) == 0
			tower.addPermanentAbility(abilityId, clamped)
		else if tower.getAbilityLevel(abilityId) != clamped
			tower.setAbilityLevel(abilityId, clamped)

public function tdPetRefreshHost(unit tower, real _aura)
	let pet = tdPetForHost(tower)
	var attack = 0.0
	var speed = 0.0
	if pet != null and tdPetBindingValid(pet, tower, pet.generation)
		let base = tdTowerBaseDamageForBranch(tdTowerChoiceForUnitTypeId(GetUnitTypeId(tower)), tdTowerLevelForUnitTypeId(GetUnitTypeId(tower)), tdTowerBranchForUnitTypeId(GetUnitTypeId(tower))).toReal()
		attack = pet.skillPower(0) + base * pet.skillPower(1)
		speed += pet.skillPower(2)
		if getElapsedGameTime() < pet.buffUntil
			if pet.buffSkill == 11
				speed += pet.buffPower
			else if pet.buffSkill == 12
				attack += base * pet.buffPower
	setBonus(tower, TD_PET_ATTACK_BONUS_ID, (attack + 0.5).toInt())
	setBonus(tower, TD_PET_SPEED_BONUS_ID, (speed * 100.0 + 0.5).toInt())
	// Existing inventory entry owns native equipment + pet cooldown aggregation.
	tdRefreshTowerEquipmentBonuses(tower)

public function tdPetOnSplitArrowImpact(unit source, unit target)
	let pet = tdPetForHost(source)
	if pet != null and tdPetBindingValid(pet, source, pet.generation) and tdPetEnemyIsValid(target, pet.lane) and tdPetSkillFitsHost(9, source)
		let power = pet.skillPower(9)
		if power > 0.0
			tdEnemySlowOfferTimed(target, source, TD_AURA_PET_FROST_ARROW, ((power - 0.08) / 0.04 + 0.5).toInt(), power, 3.0)

// Reuse the five-handle value snapshot; never retain a trial binding object.
function aoeVictimValid(unit target, int lane, tdTrialCombatContext context, tdEquipmentTrialAoeSnapshot snapshot) returns boolean
	if not context.fromTrial
		return tdTrialAoeTargetContextValid(target, lane, context)
	for slot = 0 to 4
		if snapshot.targetAt(slot) == target
			return tdEquipmentTrialAoeVictimValid(target, lane, context, snapshot.revisionAt(slot))
	return false

public function tdPetOnCorpseExplosion(unit source, vec2 center)
	let pet = tdPetForHost(source)
	if pet == null or not tdPetBindingValid(pet, source, pet.generation) or not tdPetSkillFitsHost(10, source)
		return
	let power = pet.skillPower(10)
	if power <= 0.0
		return
	let generation = pet.generation
	let amount = tdGhoulCorpseExplosionDamage() * power
	let context = tdTrialCurrentContext()
	let snapshot = tdCaptureEquipmentTrialAoe(pet.lane, context)
	doPeriodicallyCounted(1.0, 3) cb ->
		if not tdTrialContextValid(context) or not tdPetBindingValid(pet, source, generation)
			destroy cb
			return
		let poisonEffect = AddSpecialEffect("Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayDamage.mdl", center.x, center.y)
		DestroyEffect(poisonEffect)
		let targets = CreateGroup()
		targets.enumUnitsInRange(center, tdGhoulCorpseExplosionRadius())
		var hits = 0
		for target in targets
			if aoeVictimValid(target, pet.lane, context, snapshot) and tdPetEnemyIsValid(target, pet.lane) and hits < 12
				spellDamage(pet, source, generation, target, amount)
				hits += 1
		targets.destr()

function resolveActive(TDPet pet, unit host, int generation, vec2 center, int skill, real power, real base, tdTrialCombatContext context, tdEquipmentTrialAoeSnapshot snapshot)
	if skill == 11 or skill == 12
		pet.buffSkill = skill
		pet.buffPower = power
		pet.buffUntil = getElapsedGameTime() + 6.0
		tdPetRefreshHost(host, 0.0)
		return
	let targets = CreateGroup()
	targets.enumUnitsInRange(center, skill == 13 ? 450.0 : 220.0)
	var hits = 0
	for victim in targets
		if aoeVictimValid(victim, pet.lane, context, snapshot) and tdPetEnemyIsValid(victim, pet.lane) and hits < (skill == 13 ? 3 : 12)
			if skill == 15
				tdEnemySlowOfferTimed(victim, host, TD_AURA_PET_WIND, ((power - 0.25) / 0.15 + 0.5).toInt(), power, 3.0)
				victim.flashEffect("Abilities\\Spells\\Other\\Tornado\\TornadoElementalSmall.mdl", "origin")
			else
				victim.flashEffect(skill == 13 ? "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl" : "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", "origin")
				spellDamage(pet, host, generation, victim, base * power)
			hits += 1
	targets.destr()

function onAttack()
	if not tdPetDamageSourceEligible(DamageEvent.isCode(), DamageEvent.isSpell(), DamageEvent.getId())
		return
	let host = DamageEvent.getSource()
	let target = DamageEvent.getTarget()
	let pet = tdPetForHost(host)
	if pet == null or not tdPetBindingValid(pet, host, pet.generation) or not tdPetEnemyIsValid(target, pet.lane)
		return
	// Locked pre1.29 library: native post-armor value, immutable across early setAmount.
	let base = DamageEvent.getUnreducedOriginalAmount()
	if base <= 0.0 or DamageEvent.getAmount() <= 0.0
		return
	let preLife = target.getLife()
	let maxLife = GetUnitState(target, UNIT_STATE_MAX_LIFE)
	let generation = pet.generation
	let context = tdTrialCaptureContext(target)
	let snapshot = tdCaptureEquipmentTrialAoe(pet.lane, context)
	let binding = tdTrialBindingFor(target)
	let targetRevision = binding == null ? 0 : binding.revision
	let center = target.getPos()
	var armor = 0.0
	var slowQuality = 0
	var comboChance = 0.0
	var charge = 0.0
	var pursuit = 0.0
	var heavy = 0.0
	var resolve = 0.0
	var active = -1
	var power = 0.0
	// One four-slot scan. Every value is sampled before the decisive multiplier.
	for slot = 0 to IMinBJ(pet.skillCount, tdPetUnlockedSlots(pet.level)) - 1
		let skill = pet.skillAt(slot)
		let quality = pet.qualityAt(slot)
		let strength = tdPetSkillPower(skill, quality)
		if skill == 5
			slowQuality = quality
		else if skill == 6
			armor = strength
		else if skill == 7
			charge = strength
		else if skill == 8 and tdPetPursuitEligible(preLife, maxLife)
			pursuit = strength
		else if skill == TD_PET_SKILL_COMBO
			comboChance = strength
		else if skill == TD_PET_SKILL_RESOLVE and tdPetSkillFitsHost(skill, host)
			resolve = strength
		else if skill == TD_PET_SKILL_HEAVY and tdPetHeavyEligible(preLife, maxLife)
			heavy = strength
		else if tdPetSkillIsActive(skill)
			active = skill
			power = strength
	var combo = 0.0
	if comboChance > 0.0 and GetRandomReal(0.0, 1.0) < comboChance
		combo = 1.0
	if charge > 0.0
		pet.rotation = tdPetNextAttackCount(pet.rotation, 4)
		if pet.rotation != 0
			charge = 0.0
	let now = getElapsedGameTime()
	let proc = active >= 0 and tdPetProcReady(pet.pendingSkill, now, pet.readyAt)
	if proc
		pet.pendingSkill = true
		pet.pendingSerial += 1
	let pendingSerial = pet.pendingSerial
	tdPetApplyAttackDebuffs(pet, host, target, armor, slowQuality)
	// addUnreducedListener mutates the current native hit, never another segment.
	if resolve > 0.0
		pet.resolveRotation = tdPetNextAttackCount(pet.resolveRotation, 5)
		if pet.resolveRotation == 0
			DamageEvent.setAmount(DamageEvent.getAmount() * resolve)
	if combo <= 0.0 and charge <= 0.0 and pursuit <= 0.0 and heavy <= 0.0 and not proc
		return
	let comboSnapshot = combo
	let chargeSnapshot = charge
	let pursuitSnapshot = pursuit
	let heavySnapshot = heavy
	let activeSkill = active
	let activePower = power
	// The phase fence releases this captured packet only after EVERY pending
	// original hit has completed tower post priorities 0/1/2 and pet post3.
	tdPetQueueAttack(pet castTo int) ->
		if not tdTrialContextValid(context) or not tdPetBindingValid(pet, host, generation)
			if proc and pet.generation == generation and pet.pendingSerial == pendingSerial
				pet.pendingSkill = false
			return
		if proc
			if not pet.pendingSkill or pet.pendingSerial != pendingSerial
				return
			pet.pendingSkill = false
		// Each passive is at most one tagged segment. Dead targets cannot retarget.
		if tdTrialTargetContextValid(target, pet.lane, context, targetRevision)
			damage(pet, host, generation, target, base * comboSnapshot)
			damage(pet, host, generation, target, base * chargeSnapshot)
			damage(pet, host, generation, target, base * pursuitSnapshot)
			damage(pet, host, generation, target, base * heavySnapshot)
		if proc
			// Additional damage can synchronously end the match or recall the host.
			if not tdTrialContextValid(context) or not tdPetBindingValid(pet, host, generation)
				return
			// Buff and ground procs survive a primary kill; no replacement round targets.
			if activeSkill > 12
				let nearby = CreateGroup()
				nearby.enumUnitsInRange(center, activeSkill == 13 ? 450.0 : 220.0)
				var found = false
				for candidate in nearby
					if aoeVictimValid(candidate, pet.lane, context, snapshot) and tdPetEnemyIsValid(candidate, pet.lane)
						found = true
				nearby.destr()
				if not found
					return
			pet.readyAt = tdStartScriptActiveCooldown(host, tdActiveSkillDefinitionForPetSkill(activeSkill).key, getElapsedGameTime())
			resolveActive(pet, host, generation, center, activeSkill, activePower, base, context, snapshot)

public function tdPetSetupCombat()
	if tdPetCombatReady
		return
	tdPetCombatReady = true
	DamageEvent.addUnreducedListener(3) ->
		if tdPetOriginalPhaseEvent()
			tdPetBeginOriginalPhase()
		onAttack()
	DamageEvent.addListener(3) ->
		if tdPetOriginalPhaseEvent()
			tdPetEndOriginalPhase()
	doPeriodically(0.25) cb ->
		tdPetExpireAttackDebuffs()
		if tdIsGameOver()
			tdPetClearAttackQueue()
			destroy cb



init
	if not preloadAbility(TD_PET_ATTACK_BONUS_ID, TD_PET_SPEED_BONUS_ID, TD_PET_ARMOR_ID)
		error("Failed to preload pet host bonus/debuff abilities Pbat/Pbsp/Pbar.")


