package TDPetActiveVisuals
import TDPetCastContext
import TDPetRouteSnapshot
import TDPetActiveVisualData
import GameTimer

// Native 1.27 resources from the locked stdlib Abilities catalogue. Each stage
// reserves one of its <=8 slots for a core within the shared 40+88 budget; omitted art never gates
// selection, damage, control or cooldown. Only delivered terminal point/line
// handles may transfer to the existing short-visual expiry owner.
public constant string TD_PET_VFX_BLADE = "Abilities\\Weapons\\GlaiveMissile\\GlaiveMissile.mdx"
public constant string TD_PET_VFX_ARMOR = "Abilities\\Spells\\NightElf\\FaerieFire\\FaerieFireTarget.mdx"
public constant string TD_PET_VFX_SWORD = "Abilities\\Spells\\Other\\Cleave\\CleaveDamageTarget.mdx"
public constant string TD_PET_VFX_GOLD = "Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdx"
public constant string TD_PET_VFX_ROOT = "Abilities\\Spells\\NightElf\\EntanglingRoots\\EntanglingRootsTarget.mdx"
public constant string TD_PET_VFX_SEED = "Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdx"
public constant string TD_PET_VFX_POISON = "Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdx"
public constant string TD_PET_VFX_FLOWER = "Abilities\\Spells\\NightElf\\Tranquility\\TranquilityTarget.mdx"
public constant string TD_PET_VFX_THORN = "Abilities\\Spells\\Undead\\Impale\\ImpaleCaster.mdx"
public constant string TD_PET_VFX_COLD = "Abilities\\Spells\\Other\\FrostArrows\\NagaColdArrowMissile.mdx"
public constant string TD_PET_VFX_TIDE = "Abilities\\Spells\\Other\\BreathOfFrost\\BreathOfFrostMissile.mdx"
public constant string TD_PET_VFX_RETURN = "Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdx"
public constant string TD_PET_VFX_WARNING = "Abilities\\Spells\\Undead\\FrostArmor\\FrostArmorTarget.mdx"
public constant string TD_PET_VFX_FREEZE = "Abilities\\Spells\\Human\\Blizzard\\BlizzardTarget.mdx"
public constant string TD_PET_VFX_SHATTER = "Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdx"
public constant string TD_PET_VFX_VORTEX = "Abilities\\Spells\\Other\\Tornado\\TornadoElementalSmall.mdl"
public constant string TD_PET_VFX_BRAND = "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeDamageTarget.mdx"
public constant string TD_PET_VFX_LOTUS = "Abilities\\Spells\\Human\\FlameStrike\\FlameStrike1.mdx"
public constant string TD_PET_VFX_METEOR = "Abilities\\Spells\\Demon\\RainOfFire\\RainOfFireTarget.mdx"
public constant string TD_PET_VFX_GROUND_FIRE = "Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeEmbers.mdx"
public constant string TD_PET_VFX_MARK = "Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdx"
public constant string TD_PET_VFX_EXPLODE = "Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl"
public constant string TD_PET_VFX_ROCK = "Abilities\\Spells\\Human\\Thunderclap\\ThunderclapTarget.mdx"
public constant string TD_PET_VFX_FAN = "Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdx"
public constant string TD_PET_VFX_SEAL = "Abilities\\Spells\\Orc\\EarthQuake\\EarthquakeTarget.mdx"
public constant string TD_PET_VFX_RIFT = "Abilities\\Spells\\Undead\\Impale\\ImpaleHitTarget.mdx"

// These three shapes are authored MDX800 meshes, not recoloured Impale.
public constant string TD_PET_VFX_SWORD_ARRAY = "war3mapImported\\TDPetVfxSwordArray.mdx"
public constant string TD_PET_VFX_VERDANT_ROOT = "war3mapImported\\TDPetVfxVerdantRoot.mdx"
public constant string TD_PET_VFX_FAULT_RIDGE = "war3mapImported\\TDPetVfxFaultRidge.mdx"
public constant string TD_PET_VFX_METEOR_BODY = "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdx"
public constant string TD_PET_VFX_METAL_SPARK = "Abilities\\Weapons\\Rifle\\RifleImpact.mdx"
public constant string TD_PET_VFX_SEED_CORE = "Abilities\\Spells\\NightElf\\MoonWell\\MoonWellTarget.mdx"

// Neutral, immediate looping region cores. Native stage bursts remain below
// and run only from delivered battle callbacks, never from a baked model clock.
public constant string TD_PET_VFX_FROST_DOMAIN = "war3mapImported\\TDPetVfxFrostDomain.mdx"
public constant string TD_PET_VFX_STARFALL_DOMAIN = "war3mapImported\\TDPetVfxStarfallDomain.mdx"
public constant string TD_PET_VFX_SWORD_DOMAIN = "war3mapImported\\TDPetVfxSwordDomain.mdx"
public constant string TD_PET_VFX_VORTEX_DOMAIN = "war3mapImported\\TDPetVfxVortexDomain.mdx"
public constant string TD_PET_VFX_SEAL_DOMAIN = "war3mapImported\\TDPetVfxEarthSealDomain.mdx"
public constant string TD_PET_VFX_FLOWER_DOMAIN = "war3mapImported\\TDPetVfxFlowerBloomLoop.mdx"
public constant string TD_PET_VFX_LOTUS_DOMAIN = "war3mapImported\\TDPetVfxLotusBurstLoop.mdx"

function TDPetCastContext.visualCoreTrace(vec2 startPoint, vec2 endPoint, int element, real alpha)
	let lightningCode = element == 2 ? "DRAL" : (element == 4 ? "AFOD" : (element == 5 ? "SPLK" : "DRAM"))
	let red = element == 2 ? 0.25 : (element == 3 ? 0.50 : 1.0)
	let green = element == 4 ? 0.30 : (element == 5 ? 0.68 : 0.95)
	let blue = element == 1 ? 0.30 : (element == 2 ? 0.35 : (element == 3 ? 1.0 : 0.15))
	this.lineCore(lightningCode, startPoint.withTerrainZ(45.0), endPoint.withTerrainZ(45.0), red, green, blue, alpha)

public function TDPetCastContext.visualRing(string model, vec2 point, real radius)
	this.clearVisuals()
	this.addVisual(model, point)
	this.addVisual(model, point + vec2(radius, 0.0))
	this.addVisual(model, point + vec2(-radius, 0.0))
	this.addVisual(model, point + vec2(0.0, radius))
	this.addVisual(model, point + vec2(0.0, -radius))

public function TDPetCastContext.visualPoint(string model, vec2 point)
	this.clearVisuals()
	this.addVisual(model, point)

function TDPetCastContext.visualTrace(vec2 startPoint, vec2 endPoint, int element)
	let lightningCode = element == 2 ? "DRAL" : (element == 3 ? "DRAM" : (element == 4 ? "AFOD" : "SPLK"))
	let red = element == 2 ? 0.25 : (element == 3 ? 0.50 : 1.0)
	let green = element == 4 ? 0.30 : (element == 5 ? 0.68 : 0.95)
	let blue = element == 1 ? 0.30 : (element == 2 ? 0.35 : (element == 3 ? 1.0 : 0.15))
	this.addTimedLine(lightningCode, startPoint.withTerrainZ(45.0), endPoint.withTerrainZ(45.0), red, green, blue, 0.85, 0.20)

// Full-line feedback is emitted in the same step as the existing instant hit.
// There is no cosmetic flight that pretends to authorize a later impact.
public function TDPetCastContext.visualInstantLine(boolean returning)
	this.clearVisuals()
	let endpoint = this.origin + this.direction * (this.skill == 19 ? 650.0 : 600.0)
	this.visualCoreTrace(returning ? endpoint : this.origin, returning ? this.origin : endpoint, this.skill == 19 ? 1 : 3, 0.95)
	this.addVisual(this.skill == 19 ? TD_PET_VFX_BLADE : TD_PET_VFX_TIDE, returning ? this.origin : endpoint)
	this.addVisual(this.skill == 19 ? TD_PET_VFX_SWORD : TD_PET_VFX_RETURN, this.origin + this.direction * 300.0)

public function TDPetCastContext.visualStrike(vec2 point)
	this.clearVisuals()
	if this.skill == 20
		this.pointCore(TD_PET_VFX_ARMOR, point, this.primary)
		this.addVisual(TD_PET_VFX_SWORD, point)
		this.addVisual(TD_PET_VFX_METAL_SPARK, point + vec2(30.0, 0.0))
		this.addVisual(TD_PET_VFX_METAL_SPARK, point + vec2(-30.0, 0.0))
		this.visualTrace(point - this.direction * 120.0, point, 1)
	else if this.skill == 23
		this.pointCore(TD_PET_VFX_ROOT, point, this.primary)
		this.addVisual(TD_PET_VFX_POISON, point + vec2(35.0, 20.0))
		this.addVisual(TD_PET_VFX_POISON, point + vec2(-35.0, -20.0))
		this.addVisual(TD_PET_VFX_SEED_CORE, point)
	else if this.skill == 27
		this.pointCore(TD_PET_VFX_WARNING, point, this.primary)
		this.addVisual(TD_PET_VFX_COLD, point)
		this.visualTrace(this.origin, point, 3)
	else if this.skill == 35
		this.pointCore(TD_PET_VFX_FAULT_RIDGE, point, null)
		let movingCore = this.addMoving(0, TD_PET_VFX_FAULT_RIDGE, point.withTerrainZ(), this.direction.getAngle(), 0.60)
		this.addVisual(TD_PET_VFX_ROCK, point)
		this.addVisual(TD_PET_VFX_METAL_SPARK, point + vec2(55.0, 0.0))
		if movingCore
			this.addVisual(TD_PET_VFX_METAL_SPARK, point + vec2(-55.0, 0.0))

public function TDPetCastContext.visualSwordCut(vec2 point)
	this.clearVisuals()
	let start = point + tdPetVisualSwordOffset(this.stage)
	this.visualCoreTrace(start, point, 1, 0.95)
	this.addVisual(TD_PET_VFX_BLADE, start)
	this.addVisual(TD_PET_VFX_SWORD, point)

public function TDPetCastContext.visualSwordDrop()
	this.clearVisuals()
	this.addVisual(TD_PET_VFX_GOLD, this.center)
	for index = 0 to 3
		this.addVisual(TD_PET_VFX_SWORD, this.center + tdPetVisualSwordOffset(index))

public function TDPetCastContext.visualSeedPulse(vec2 point)
	// The third primary pulse shares its callback with one-generation spread.
	// Its combined core is emitted there once, rather than replaced immediately.
	if this.stage == 2
		return
	this.clearVisuals()
	if this.primaryValid()
		this.pointCore(TD_PET_VFX_SEED, point, this.primary)
	else
		// Area admission can legally start after the original primary died.
		this.pointCore(TD_PET_VFX_SEED_CORE, this.lastPosition(0), null)
	this.addVisual(TD_PET_VFX_SEED_CORE, point)
	this.addVisual(TD_PET_VFX_POISON, point + vec2(35.0, 0.0))
	this.addVisual(TD_PET_VFX_POISON, point + vec2(-35.0, 0.0))

public function TDPetCastContext.visualSeedSpread(vec2 point)
	this.clearVisuals()
	// The primary seed is over. The immutable captured spread origin, not a
	// live target or a new enemy, owns the remaining weak-generation subject.
	this.pointCore(TD_PET_VFX_SEED_CORE, point, null)

public function TDPetCastContext.visualSeedBranch(vec2 startPoint, vec2 endPoint)
	// The caller has already selected and remembered this exact weak seed.
	this.visualTrace(startPoint, endPoint, 2)
	this.addVisual(TD_PET_VFX_POISON, endPoint)

public function TDPetCastContext.visualFlowerContact(int flower)
	if not tdPetVisualFlowerAlreadyBloomed(this.visualFrame, flower)
		this.visualFrame += tdPetVisualFlowerBit(flower)
		this.addVisual(TD_PET_VFX_SEED_CORE, this.road.pointAt(flower))

public function TDPetCastContext.visualRoadSegment(int current)
	if this.skill == 38
		this.clearVisuals()
	let point = this.road.pointAt(current)
	let previous = current == 0 ? this.origin : this.road.pointAt(current - 1)
	let facing = tdPetVisualRoadFacing(previous, point, this.direction)
	let model = this.skill == 26 ? TD_PET_VFX_VERDANT_ROOT : TD_PET_VFX_FAULT_RIDGE
	let scale = this.skill == 26 ? 0.85 : 0.70
	// A bounded root/fault chord reuses its handle at the actual node. Optional
	// moving silhouettes cannot suppress it when the global eight Fx are busy.
	this.visualCoreTrace(point - facing.direction(this.skill == 26 ? 145.0 : 155.0), point + facing.direction(this.skill == 26 ? 145.0 : 155.0), this.skill == 26 ? 2 : 5, 0.95)
	if current == 0
		this.addMoving(0, model, point.withTerrainZ(), facing, scale)
	else
		this.moveMoving(0, point.withTerrainZ(), facing, scale)
	// Wood retains its three rooted silhouettes; rock leaves short Death rubble.
	this.addVisual(model, point)
	if this.skill == 26
		this.visualTrace(point - facing.direction(90.0), point + facing.direction(90.0), 2)
		this.addVisual(TD_PET_VFX_POISON, point)
	else
		this.addVisual(TD_PET_VFX_METAL_SPARK, point)
		if current == 3
			this.addVisual(TD_PET_VFX_ROCK, point)

public function TDPetCastContext.visualFreeze()
	this.clearVisuals()
	this.addVisual(TD_PET_VFX_FREEZE, this.center)
	this.moveMoving(0, (this.center + vec2(90.0, 0.0)).withTerrainZ(), this.direction.getAngle(), 0.55)
	this.moveMoving(1, (this.center - vec2(90.0, 0.0)).withTerrainZ(), this.direction.getAngle(), 0.55)

public function TDPetCastContext.visualIceBreak()
	this.clearMoving()
	this.visualRing(TD_PET_VFX_SHATTER, this.center, 180.0)

public function TDPetCastContext.visualVortexPulse()
	this.visualPulseAt = getElapsedGameTime()
	this.clearVisuals()
	this.addVisual(TD_PET_VFX_SHATTER, this.center)
	this.visualTrace(this.center + vec2(160.0, 0.0), this.center + vec2(0.0, 160.0), 3)
	this.visualTrace(this.center - vec2(160.0, 0.0), this.center - vec2(0.0, 160.0), 3)

public function TDPetCastContext.visualBrandPulse(vec2 point)
	this.clearVisuals()
	this.pointCore(TD_PET_VFX_BRAND, point, this.primary)
	this.addVisual(TD_PET_VFX_GROUND_FIRE, point + vec2(25.0, 0.0))
	this.addVisual(TD_PET_VFX_GROUND_FIRE, point - vec2(25.0, 0.0))

public function TDPetCastContext.visualLotus()
	this.clearVisuals()
	this.pointCore(TD_PET_VFX_LOTUS_DOMAIN, this.center, null)
	for index = 0 to 3
		this.addVisual(TD_PET_VFX_BRAND, this.center + tdPetVisualSwordOffset(index))
	this.visualTrace(this.center, this.center + vec2(120.0, 0.0), 4)
	this.visualTrace(this.center, this.center - vec2(120.0, 0.0), 4)

public function TDPetCastContext.visualMeteorImpact()
	if this.stage == 0
		this.clearMoving()
		this.clearVisuals()
		this.addVisual(TD_PET_VFX_METEOR, this.center)
		for index = 0 to 3
			this.addVisual(TD_PET_VFX_GROUND_FIRE, this.center + tdPetVisualSwordOffset(index))
	else
		this.visualRing(TD_PET_VFX_GROUND_FIRE, this.center, 100.0)

public function TDPetCastContext.visualChainBurst(vec2 point)
	this.clearVisuals()
	// This one central burst chord follows the consumed mark. The four marked
	// target meshes remain optional and never occupy four reserved core slots.
	this.visualCoreTrace(point - this.direction * 170.0, point + this.direction * 170.0, 4, 0.95)
	this.addVisual(TD_PET_VFX_EXPLODE, point)
	this.addVisual(TD_PET_VFX_GROUND_FIRE, point)
	if this.stage + 1 < this.markCount
		this.visualTrace(point, this.lastPosition(this.stage + 1), 4)

public function TDPetCastContext.visualRockFan()
	this.clearVisuals()
	let side = vec2(-this.direction.y, this.direction.x)
	this.visualCoreTrace(this.origin + this.direction * 40.0, this.origin + this.direction * 500.0, 5, 0.95)
	this.addMoving(0, TD_PET_VFX_FAULT_RIDGE, (this.origin + this.direction * 300.0).withTerrainZ(), this.direction.getAngle(), 0.60)
	for index = -1 to 1
		let point = this.origin + this.direction * 350.0 + side * (index * 200.0)
		this.addVisual(TD_PET_VFX_FAULT_RIDGE, point)
		this.visualTrace(this.origin, point, 5)

function TDPetCastContext.visualSealPulse()
	this.clearVisuals()
	this.addVisual(TD_PET_VFX_SEAL, this.center)
	for index = 0 to 3
		let startPoint = this.center + tdPetVisualSwordOffset(index) * 1.6
		let endPoint = this.center + tdPetVisualSwordOffset((index + 1) mod 4) * 1.6
		this.visualTrace(startPoint, endPoint, 5)

public function TDPetCastContext.visualPrepare()
	if this.skill == 22
		this.pointCore(TD_PET_VFX_SWORD_DOMAIN, this.center, null)
		this.visualFrame = 1
		if not this.addMoving(0, TD_PET_VFX_SWORD_ARRAY, this.center.withTerrainZ(260.0), this.direction.getAngle(), 0.75)
			this.visualFrame = 0
		for index = 0 to 3
			this.addVisual(TD_PET_VFX_METAL_SPARK, this.center + tdPetVisualSwordOffset(index))
	else if this.skill == 24
		this.visualSeedPulse(this.center)
	else if this.skill == 25
		this.visualFrame = 0
		// Only the first captured 100-radius flower is the guaranteed subject;
		// the other two independent real positions are decorative, never a fake
		// continuous field between separate damage circles.
		this.pointCore(TD_PET_VFX_FLOWER_DOMAIN, this.road.pointAt(0), null)
		for flower = 1 to 2
			this.addVisual(TD_PET_VFX_FLOWER, this.road.pointAt(flower))
	else if this.skill == 29
		this.pointCore(TD_PET_VFX_FROST_DOMAIN, this.center, null)
		this.visualFrame = 0
		if this.addMoving(0, TD_PET_VFX_FREEZE, (this.center + vec2(180.0, 0.0)).withTerrainZ(100.0), this.direction.getAngle(), 0.55)
			this.visualFrame += 1
		if this.addMoving(1, TD_PET_VFX_FREEZE, (this.center - vec2(180.0, 0.0)).withTerrainZ(100.0), this.direction.getAngle(), 0.55)
			this.visualFrame += 1
		if this.visualFrame < 2
			this.addVisual(TD_PET_VFX_FREEZE, this.center)
		for index = 0 to (this.visualFrame < 2 ? 2 : 3)
			this.addVisual(TD_PET_VFX_WARNING, this.center + tdPetVisualSwordOffset(index) * 1.5)
		this.visualTrace(this.center + vec2(180.0, 0.0), this.center + vec2(0.0, 180.0), 3)
		this.visualTrace(this.center - vec2(180.0, 0.0), this.center - vec2(0.0, 180.0), 3)
	else if this.skill == 30
		this.pointCore(TD_PET_VFX_VORTEX_DOMAIN, this.center, null)
		this.visualFrame = 1
		if not this.addMoving(0, TD_PET_VFX_VORTEX, this.center.withTerrainZ(), this.direction.getAngle(), 0.80)
			this.visualFrame = 0
	else if this.skill == 31
		this.pointCore(TD_PET_VFX_BRAND, this.center, this.primary)
	else if this.skill == 33
		this.pointCore(TD_PET_VFX_STARFALL_DOMAIN, this.center, null)
		let movingCore = this.addMoving(0, TD_PET_VFX_METEOR_BODY, this.center.withTerrainZ(520.0), this.direction.getAngle(), 1.10)
		if not movingCore
			this.addVisual(TD_PET_VFX_METEOR_BODY, this.center)
		for index = 0 to (movingCore ? 3 : 2)
			this.addVisual(TD_PET_VFX_MARK, this.center + tdPetVisualSwordOffset(index) * 1.25)
	else if this.skill == 34
		let point = this.lastPosition(0)
		this.visualCoreTrace(point - this.direction * 170.0, point + this.direction * 170.0, 4, 0.40)
		for index = 0 to this.markCount - 1
			this.addVisual(TD_PET_VFX_MARK, this.lastPosition(index))
	else if this.skill == 37
		this.pointCore(TD_PET_VFX_SEAL_DOMAIN, this.center, null)
		this.visualFrame = 0
		this.visualSealPulse()

public function TDPetCastContext.visualTick(real now)
	if this.visualCoreMode == 2 and not this.primaryValid()
		if this.skill == 24
			// The existing target-position owner captures death/removal before this
			// turn. Keep the continuing seed at that exact last known ground point.
			this.pointCore(TD_PET_VFX_SEED_CORE, this.lastPosition(0), null)
		else
			// Armor/root/cold/brand on a retired target are no longer real buffs.
			this.clearVisualCore()
	// Missing cores retry only inside this still-valid cast and its real expiry.
	this.retryVisualCore(now)
	let elapsed = now - this.createdAt
	if this.skill == 22
		this.moveMoving(0, this.center.withTerrainZ(tdPetVisualSwordHeight(elapsed, this.stage)), this.direction.getAngle(), 0.75)
	else if this.skill == 29 and this.stage == 0
		let radius = tdPetVisualMirrorRadius(elapsed)
		let height = 100.0 * (1.0 - tdPetVisualProgress(elapsed, 0.60))
		this.moveMoving(0, (this.center + vec2(radius, 0.0)).withTerrainZ(height), this.direction.getAngle(), 0.55)
		this.moveMoving(1, (this.center - vec2(radius, 0.0)).withTerrainZ(height), this.direction.getAngle(), 0.55)
	else if this.skill == 30
		this.moveMoving(0, this.center.withTerrainZ(), (elapsed * 180.0).asAngleDegrees(), 0.80 + 0.04 * Sin(elapsed * 6.283185))
	else if this.skill == 33 and this.stage == 0
		this.moveMoving(0, this.center.withTerrainZ(tdPetVisualMeteorHeight(elapsed)), this.direction.getAngle(), 1.10)
	else if this.skill == 37 and elapsed < 4.0
		let frame = elapsed.toInt()
		if this.visualFrame != frame
			this.visualFrame = frame
			this.visualSealPulse()

// No replacement native effect is created on completion. The scheduler still
// destroys combat ownership immediately; the expiry owner borrows only handles.
public function TDPetCastContext.visualFinish(real now)
	if this.valid() and tdPetVisualTerminal(this.skill, this.stage, this.markCount, now, this.expiresAt, this.visualPulseAt)
		this.retainVisuals(now + TD_PET_VISUAL_TERMINAL_DWELL)
