package TDPetUIState
import TDPetData
import TDPetRules
import TDPetState
import TDPetCultivation
import TDConfig

public constant int TD_PET_UI_CLOSED = -1
public constant int TD_PET_UI_LIST = 0
public constant int TD_PET_UI_DETAIL = 1
public constant int TD_PET_UI_CULTIVATE = 2
public constant int TD_PET_UI_PREVIEW = 3
public constant int TD_PET_UI_RELEASE = 4
public constant int TD_PET_UI_DIRECTED_SLOT = 5
public constant int TD_PET_UI_DIRECTED_CHOICES = 6
public constant int TD_PET_UI_DIRECTED_PREVIEW = 7
public constant int TD_PET_ACTION_PAGE = 8
public constant int TD_PET_ACTION_FARMER = 9
public constant int TD_PET_ACTION_REROLL_FIRST = 10
public constant int TD_PET_ACTION_OPEN = 14
public constant int TD_PET_ACTION_RELEASE = 15
public constant int TD_PET_ACTION_DETAIL = 16
public constant int TD_PET_ACTION_KEEP = 17
public constant int TD_PET_ACTION_ADOPT = 18
public constant int TD_PET_ACTION_CONFIRM = 19
public constant int TD_PET_ACTION_CANCEL = 20
public constant int TD_PET_ACTION_CONTINUE = 21
public constant int TD_PET_ACTION_PREVIEW_DETAIL = 22
public constant int TD_PET_ACTION_DIRECTED = 23
public constant int TD_PET_ACTION_DIRECTED_FIRST = 24
public constant int TD_PET_ACTION_DIRECTED_BACK = 28
public constant int TD_PET_ACTION_DIRECTED_NEXT = 29
public constant int TD_PET_ACTION_DIRECTED_PREVIOUS = 30
public constant int TD_PET_ACTION_DIRECTED_KEEP = 31
public constant int TD_PET_ACTION_DIRECTED_ADOPT = 32
public constant int TD_PET_COMMAND_INVALID = -1
public constant int TD_PET_COMMAND_STALE = -2
public constant int TD_PET_COMMAND_REFRESH = -3
public constant int TD_PET_COMMAND_EMPTY = -4

// Physical grid is the sole authority for object layout, mounting and admission.
public function tdPetActionCell(int mode, int action) returns int
	if mode == TD_PET_UI_LIST
		if action >= 100 and action < 110
			return action - 100
		if action == TD_PET_ACTION_PAGE
			return 10
		return action == TD_PET_ACTION_FARMER ? 11 : -1
	if mode == TD_PET_UI_DETAIL
		if action >= 0 and action <= 3
			return action
		if action >= 4 and action <= 6
			return action + 4
		return action == TD_PET_ACTION_RELEASE ? 11 : -1
	if mode == TD_PET_UI_CULTIVATE
		if action >= TD_PET_ACTION_REROLL_FIRST and action < TD_PET_ACTION_OPEN
			return action - TD_PET_ACTION_REROLL_FIRST
		if action == TD_PET_ACTION_OPEN or action == TD_PET_ACTION_DETAIL
			return action - TD_PET_ACTION_OPEN + 8
		if action == TD_PET_ACTION_DIRECTED
			return 9
		return action == TD_PET_ACTION_FARMER ? 11 : -1
	if mode == TD_PET_UI_PREVIEW
		if action == TD_PET_ACTION_KEEP
			return 4
		if action == TD_PET_ACTION_ADOPT
			return 7
		if action == TD_PET_ACTION_CONTINUE
			return 8
		return action == TD_PET_ACTION_PREVIEW_DETAIL ? 11 : -1
	if mode == TD_PET_UI_RELEASE
		if action == TD_PET_ACTION_CONFIRM or action == TD_PET_ACTION_CANCEL
			return action - TD_PET_ACTION_CONFIRM + 8
		return action == TD_PET_ACTION_FARMER ? 11 : -1
	if mode == TD_PET_UI_DIRECTED_SLOT
		if action >= TD_PET_ACTION_DIRECTED_FIRST and action < TD_PET_ACTION_DIRECTED_BACK
			return action - TD_PET_ACTION_DIRECTED_FIRST
		return action == TD_PET_ACTION_DIRECTED_BACK ? 11 : -1
	if mode == TD_PET_UI_DIRECTED_CHOICES
		if action >= 200 and action < 208
			return action - 200
		if action == TD_PET_ACTION_DIRECTED_NEXT or action == TD_PET_ACTION_DIRECTED_PREVIOUS
			return action - TD_PET_ACTION_DIRECTED_NEXT + 8
		return action == TD_PET_ACTION_DIRECTED_BACK ? 11 : -1
	if mode == TD_PET_UI_DIRECTED_PREVIEW
		if action == TD_PET_ACTION_DIRECTED_KEEP
			return 4
		if action == TD_PET_ACTION_DIRECTED_ADOPT
			return 7
		return action == TD_PET_ACTION_PREVIEW_DETAIL ? 11 : -1
	return -1

public function tdPetActionHotkey(int action) returns string
	if action == TD_PET_ACTION_DIRECTED
		return "L"
	if action >= TD_PET_ACTION_DIRECTED_FIRST and action < TD_PET_ACTION_DIRECTED_BACK
		return SubString("QWET", action - TD_PET_ACTION_DIRECTED_FIRST, action - TD_PET_ACTION_DIRECTED_FIRST + 1)
	if action == TD_PET_ACTION_DIRECTED_BACK
		return "R"
	if action == TD_PET_ACTION_DIRECTED_NEXT
		return "N"
	if action == TD_PET_ACTION_DIRECTED_PREVIOUS
		return "P"
	if action == TD_PET_ACTION_DIRECTED_KEEP
		return "Q"
	if action == TD_PET_ACTION_DIRECTED_ADOPT
		return "E"
	if action == 0
		return "I"
	if action == 1
		return "A"
	if action == 2
		return "D"
	if action == 3 or action == TD_PET_ACTION_FARMER or action == TD_PET_ACTION_PREVIEW_DETAIL
		return "R"
	if action == 4 or action == 12 or action == TD_PET_ACTION_ADOPT
		return "E"
	if action == 5 or action == 10 or action == TD_PET_ACTION_KEEP
		return "Q"
	if action == 6 or action == TD_PET_ACTION_PAGE or action == TD_PET_ACTION_DETAIL
		return "C"
	if action == 7 or action == 11 or action == TD_PET_ACTION_RELEASE or action == TD_PET_ACTION_CONTINUE
		return "W"
	if action == 13
		return "T"
	if action == TD_PET_ACTION_OPEN
		return "O"
	if action == TD_PET_ACTION_CONFIRM
		return "Y"
	return action == TD_PET_ACTION_CANCEL ? "N" : ""

public function tdPetListHotkey(int cell) returns string
	let keys = "QWETASDFZX"
	return cell >= 0 and cell < 10 ? SubString(keys, cell, cell + 1) : ""

// Dynamic admission only removes entries from the physical page whitelist.
public function tdPetPageActionAvailable(int mode, int action, int ownedCount, int skillSlot, int choicePage) returns boolean
	if mode == TD_PET_UI_DIRECTED_SLOT and action >= TD_PET_ACTION_DIRECTED_FIRST and action < TD_PET_ACTION_DIRECTED_BACK
		return action - TD_PET_ACTION_DIRECTED_FIRST < ownedCount
	if mode == TD_PET_UI_DIRECTED_CHOICES
		if action == TD_PET_ACTION_DIRECTED_PREVIOUS
			return choicePage > 0
		if action == TD_PET_ACTION_DIRECTED_NEXT
			return (choicePage + 1) * TD_PET_DIRECTED_CELLS < tdPetDirectedCatalogSize(skillSlot)
	return true

// A real session used by the event bridge and regression tests. Native events do
// not carry epoch: currentUnit identity in UI, not this serial, rejects old casts.
public class TDPetUISession
	int lane
	int mode = TD_PET_UI_CLOSED
	int page = 0
	int epoch = 0
	boolean active = false
	boolean dirty = false
	string detailHudText = ""
	int currentKey = 0
	int selectedSlot = -1
	TDPet pet = null
	int revision = 0
	int generation = 0
	int resonance = 0
	int ownedCount = 0
	boolean paused = false
	int proposalVersion = 0
	int proposalSlot = -1
	int proposalRevision = 0
	int proposalType = TD_PET_PROPOSAL_NONE
	int proposalSkill = -1
	int proposalQuality = 0
	int proposalOldSkill = -1
	int proposalOldQuality = 0
	int species = 0
	int matchEpoch = 0
	int directedSlot = -1
	int directedPage = 0
	int releaseNonce = 0
	int array[12] abilities
	int array[12] levels
	int array[12] actions
	int array[8] directedSkills
	TDPet array[10] listPets
	int array[10] listRevisions
	int array[10] listGenerations
	int array[10] listResonances
	int array[10] listOwnedCounts

	construct(int lane)
		this.lane = lane

	function close()
		detailHudText = ""
		active = false
		dirty = false
		currentKey = 0
		mode = TD_PET_UI_CLOSED
		pet = null
		releaseNonce = 0

	function mount(int cell, int abilityId, int level, int action)
		abilities[cell] = abilityId
		levels[cell] = level
		actions[cell] = action

	function open(int mode, int page, int slot, TDPet pet, int nonce, int unitKey) returns boolean
		close()
		if epoch >= 2147483647 or unitKey <= 0 or mode < TD_PET_UI_LIST or mode > TD_PET_UI_DIRECTED_PREVIEW or page < 0 or page > 1
			return false
		if mode != TD_PET_UI_LIST
			if pet == null or tdPetAt(lane, slot) != pet or pet.released or pet.lane != lane
				return false
		if mode == TD_PET_UI_RELEASE
			if nonce <= 0 or nonce != tdPetReleaseNonce(lane) or pet.host != null or pet.proposalSlot >= 0
				return false
		if mode == TD_PET_UI_DIRECTED_SLOT or mode == TD_PET_UI_DIRECTED_CHOICES
			if pet.proposalSlot >= 0
				return false
		if mode == TD_PET_UI_DIRECTED_CHOICES
			if directedSlot < 0 or directedSlot >= pet.skillCount or directedSlot > 3 or directedPage < 0 or directedPage > 6 or directedPage * TD_PET_DIRECTED_CELLS >= tdPetDirectedCatalogSize(directedSlot)
				return false
		epoch += 1
		this.mode = mode
		this.page = page
		selectedSlot = slot
		this.pet = pet
		currentKey = unitKey
		releaseNonce = nonce
		matchEpoch = tdPetMatchEpoch[lane]
		if pet != null
			species = pet.species
			revision = pet.revision
			generation = pet.generation
			resonance = pet.level
			ownedCount = pet.skillCount
			paused = pet.paused
			proposalVersion = pet.proposalVersion
			proposalSlot = pet.proposalSlot
			proposalRevision = pet.proposalRevision
			proposalType = pet.proposalType
			proposalSkill = pet.proposalSkill
			proposalQuality = pet.proposalQuality
			proposalOldSkill = pet.proposalOldSkill
			proposalOldQuality = pet.proposalOldQuality
		for cell = 0 to 11
			mount(cell, 0, 0, -1)
		for action = 0 to TD_PET_ACTION_DIRECTED_ADOPT
			let cell = tdPetActionCell(mode, action)
			if cell >= 0 and tdPetPageActionAvailable(mode, action, ownedCount, directedSlot, directedPage)
				mount(cell, tdPetManagerCommandId(action), 1, action)
		if mode == TD_PET_UI_LIST
			for cell = 0 to 9
				let record = tdPetAt(lane, tdPetPageSlot(page, cell))
				listPets[cell] = record
				listRevisions[cell] = record != null ? record.revision : 0
				listGenerations[cell] = record != null ? record.generation : 0
				listResonances[cell] = record != null ? record.level : 0
				listOwnedCounts[cell] = record != null ? record.skillCount : 0
				let abilityId = tdPetListAbilityId(cell, record != null ? record.species : 0, record != null ? record.quality() : 0, record != null ? record.skillCount : 0)
				if abilityId == 0
					close()
					return false
				mount(cell, abilityId, page + 1, 100 + cell)
		else if mode == TD_PET_UI_DETAIL or mode == TD_PET_UI_CULTIVATE
			for skillSlot = 0 to 3
				var variant = TD_PET_SLOT_EMPTY
				if skillSlot < pet.skillCount
					variant = pet.skillAt(skillSlot) + (skillSlot >= tdPetUnlockedSlots(pet.level) ? TD_PET_SKILL_COUNT : 0)
				mount(skillSlot + 4, tdPetSlotAbilityId(skillSlot, variant), variant == TD_PET_SLOT_EMPTY ? 1 : pet.qualityAt(skillSlot), -1)
		else if mode == TD_PET_UI_PREVIEW or mode == TD_PET_UI_DIRECTED_PREVIEW
			if pet.proposalSlot < 0 or pet.proposalOldSkill < 0 or pet.proposalSkill < 0
				close()
				return false
			if (mode == TD_PET_UI_PREVIEW and pet.proposalType != TD_PET_PROPOSAL_RANDOM) or (mode == TD_PET_UI_DIRECTED_PREVIEW and pet.proposalType != TD_PET_PROPOSAL_DIRECTED)
				close()
				return false
			mount(0, tdPetPreviewAbilityId(0, pet.proposalOldSkill), pet.proposalOldQuality, -1)
			mount(1, tdPetPreviewArrowAbilityId(0), 1, -1)
			mount(2, tdPetPreviewArrowAbilityId(1), 1, -1)
			mount(3, tdPetPreviewAbilityId(1, pet.proposalSkill), pet.proposalQuality, -1)
		else if mode == TD_PET_UI_DIRECTED_CHOICES
			for cell = 0 to TD_PET_DIRECTED_CELLS - 1
				let skill = tdPetDirectedCandidateAt(pet, directedSlot, directedPage * TD_PET_DIRECTED_CELLS + cell)
				directedSkills[cell] = skill
				if skill >= 0
					mount(cell, tdPetDirectedAbilityId(skill), 1, 200 + cell)
		active = true
		return true

	function matchesPet(TDPet current) returns boolean
		return current != null and current == pet and current.lane == lane and not current.released and current.species == species and current.revision == revision and current.generation == generation and current.level == resonance and current.skillCount == ownedCount and current.paused == paused and current.proposalVersion == proposalVersion and current.proposalSlot == proposalSlot and current.proposalRevision == proposalRevision and current.proposalType == proposalType and current.proposalSkill == proposalSkill and current.proposalQuality == proposalQuality and current.proposalOldSkill == proposalOldSkill and current.proposalOldQuality == proposalOldQuality and tdPetMatchEpoch[lane] == matchEpoch

	function matchesListCell(int cell) returns boolean
		if cell < 0 or cell >= 10
			return false
		let current = tdPetAt(lane, tdPetPageSlot(page, cell))
		if current != listPets[cell]
			return false
		if current == null
			return true
		return not current.released and current.revision == listRevisions[cell] and current.generation == listGenerations[cell] and current.level == listResonances[cell] and current.skillCount == listOwnedCounts[cell]

	function snapshotCurrent() returns boolean
		if tdPetMatchEpoch[lane] != matchEpoch
			return false
		if mode == TD_PET_UI_LIST
			for cell = 0 to 9
				if not matchesListCell(cell)
					return false
			return true
		return matchesPet(tdPetAt(lane, selectedSlot))

	function commandAction(int owner, int casterKey, int abilityId, int actualLevel) returns int
		if not active or owner != lane or casterKey <= 0 or casterKey != currentKey
			return -1
		for cell = 0 to 11
			if actions[cell] >= 0 and abilities[cell] == abilityId and levels[cell] == actualLevel and tdPetActionCell(mode, actions[cell]) == cell
				return actions[cell]
		return -1

	function consumeCommand(int owner, int casterKey, int abilityId, int actualLevel) returns int
		let action = commandAction(owner, casterKey, abilityId, actualLevel)
		if action >= 0
			detailHudText = ""
			active = false
			currentKey = 0
		return action

	// Native bridge and executable sequences use the same admission transaction.
	function admitCommand(int owner, int casterKey, int abilityId, int actualLevel) returns int
		let action = commandAction(owner, casterKey, abilityId, actualLevel)
		if action < 0
			return TD_PET_COMMAND_INVALID
		var stale = dirty or not snapshotCurrent()
		if mode == TD_PET_UI_RELEASE and releaseNonce != tdPetReleaseNonce(lane)
			stale = true
		if stale
			consumeCommand(owner, casterKey, abilityId, actualLevel)
			return TD_PET_COMMAND_STALE
		if action == 7
			return TD_PET_COMMAND_REFRESH
		if mode == TD_PET_UI_LIST and action >= 100 and action < 110 and listPets[action - 100] == null
			return TD_PET_COMMAND_EMPTY
		return consumeCommand(owner, casterKey, abilityId, actualLevel)

	function selectionCloses(int owner, int eventKey, int typeId, int unitOwner, boolean deselected) returns boolean
		if not active or owner != lane or currentKey <= 0 or eventKey <= 0
			return false
		if deselected
			return eventKey == currentKey
		if eventKey == currentKey or typeId == 0
			return false
		if tdPetIsDisplayType(typeId) and unitOwner == lane
			return false
		return true

public TDPetUISession array tdPetUISessions

// A derived display cache, never cooldown authority. Validate synchronously
// before the HUD's final local-player branch; stale sessions expose no text.
public function tdPetDetailHudTextForLane(int lane) returns string
	if not tdIsLanePlayer(lane)
		return ""
	let session = tdPetUISessions[lane]
	if session == null
		return ""
	if not session.active or session.dirty or session.mode != TD_PET_UI_DETAIL or not tdPetLaneCanManage(lane) or not session.snapshotCurrent()
		session.detailHudText = ""
	return session.detailHudText
