package TDPetWild
import public TDPetWildState
import TDPetData
import TDPetRules
import TDPetState
import TDConfig
import TDAuraState
import TDState
import TDWaves
import LinkedList
import ClosureTimers
import GameTimer
import Orders

public class TDPetWildRecord extends TDPetWildState
	unit creature
	int wave
	int species
	boolean tutorial = false
	real travelSpeed = 0.0
	int waypoint = 0
	texttag marker = null
	construct(unit creature, int lane, int wave, int species)
		super(lane, getElapsedGameTime())
		this.creature = creature
		this.wave = wave
		this.species = species
		this.tutorial = wave == 1 and not tdPetTutorialUsed[lane]

public LinkedList<TDPetWildRecord> tdPetWildRecords = new LinkedList<TDPetWildRecord>()
boolean ready = false
trigger deathTrigger = CreateTrigger()

public function tdPetWildFor(unit creature) returns TDPetWildRecord
	for record in tdPetWildRecords
		if record.creature == creature
			return record
	return null

// Type identity survives record cleanup and ordering of native death listeners.
public function tdPetIsWild(unit creature) returns boolean
	return creature != null and tdPetSpeciesForWildType(GetUnitTypeId(creature)) != 0

public function tdPetWildTransition(TDPetWildRecord record, int nextState) returns boolean
	if record == null
		return false
	let settled = record.settle(nextState, getElapsedGameTime())
	if record.state == TD_PET_WILD_ALIVE
		return false
	if record.marker != null
		DestroyTextTag(record.marker)
		record.marker = null
	return settled

public function tdPetWildCanCapture(TDPetWildRecord record, int lane) returns boolean
	return record != null and record.lane == lane and record.creature != null and record.canCapture(record.creature.isAlive(), getElapsedGameTime())

public function tdPetWildPlanLane(int lane)
	for stage = 0 to 3
		if GetRandomInt(1, 100) <= 50
			var count = 0
			for wave = tdPetStageStart(stage) to tdPetStageEnd(stage)
				if tdWaveBossEnemyCount(wave) == 0
					count += 1
			var rank = GetRandomInt(0, count - 1)
			for wave = tdPetStageStart(stage) to tdPetStageEnd(stage)
				if tdWaveBossEnemyCount(wave) == 0
					if rank == 0
						tdPetExtraEncounterWave[lane * 4 + stage] = wave
						rank = -1
					else if rank > 0
						rank -= 1

public function tdPetEncounterCount(int lane, int wave) returns int
	if not tdIsLanePlayer(lane) or wave < 1 or wave > 25 or tdWaveBossEnemyCount(wave) > 0
		return 0
	var count = tdPetFixedEncounter(wave) ? 1 : 0
	for stage = 0 to 3
		if tdPetExtraEncounterWave[lane * 4 + stage] == wave
			count += 1
	return count

public function tdPetWildTravelSpeed(int lane) returns real
	var distance = 0.0
	var previous = tdLaneSpawnPosition(lane)
	for index = 0 to tdLaneWaypointCount(lane) - 1
		let next = tdLaneWaypointPosition(lane, index)
		distance += previous.distanceTo(next)
		previous = next
	distance += previous.distanceTo(tdLaneExitPosition(lane))
	return RMaxBJ(1.0, RMinBJ(150.0, distance / 80.0))

public function tdPetWildHoldPosition(int lane) returns vec2
	let count = tdLaneWaypointCount(lane)
	let origin = count > 0 ? tdLaneWaypointPosition(lane, count - 1) : tdLaneSpawnPosition(lane)
	let exit = tdLaneExitPosition(lane)
	return exit + (origin - exit).norm() * RMinBJ(600.0, origin.distanceTo(exit))
public function tdPetSpawnWild(int lane, int wave, int species) returns TDPetWildRecord
	if not tdIsLanePlayer(lane) or wave < 1 or wave > 25 or tdWaveBossEnemyCount(wave) > 0 or species < 1 or species > TD_PET_SPECIES_COUNT
		return null
	let creature = createUnit(Player(PLAYER_NEUTRAL_PASSIVE), tdPetWildUnitId(wave, species), tdLaneSpawnPosition(lane), 0 .fromDeg())
	creature.setUserData(lane * 10000 + wave * 100)
	creature.setPathing(false)
	SetUnitCreepGuard(creature, false)
	creature.removeGuardPosition()
	SetUnitInvulnerable(creature, true)
	SetUnitMoveSpeed(creature, tdPetWildTravelSpeed(lane))
	let record = new TDPetWildRecord(creature, lane, wave, species)
	record.travelSpeed = tdPetWildTravelSpeed(lane)
	record.marker = CreateTextTag()
	SetTextTagPermanent(record.marker, true)
	SetTextTagText(record.marker, "野生精灵 60s · Q捕获", 0.022)
	SetTextTagPosUnit(record.marker, creature, 85.0)
	SetTextTagVisibility(record.marker, GetLocalPlayer() == Player(lane))
	tdPetWildRecords.add(record)
	tdAuraRegisterTarget(creature, false)
	creature.flashEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl", "origin")
	if GetLocalPlayer() == Player(lane)
		PingMinimapEx(creature.getPos().x, creature.getPos().y, 4.0, 255, 220, 50, false)
		StartSound(bj_questDiscoveredSound)
	DisplayTimedTextToPlayer(Player(lane), 0, 0, 7.0, "|cffffdd40野生" + tdPetSpeciesName(species) + "出现！|r保护60秒，Q普通球捕获。" + (record.tutorial ? " 教学首只第一次普通球必成。" : ""))
	return record

public function tdPetWildHasCaptureWindow() returns boolean
	let now = getElapsedGameTime()
	for record in tdPetWildRecords
		if tdIsLaneActive(record.lane) and not tdIsLaneDefeated(record.lane) and not tdIsLaneFinished(record.lane) and record.creature != null and record.canCapture(record.creature.isAlive(), now)
			return true
	return false

public function tdPetWildOnWave(int lane, int wave)
	if tdWaveBossEnemyCount(wave) > 0
		return
	if not tdPetClaimWildSpawn(lane, wave)
		return
	for _index = 1 to tdPetEncounterCount(lane, wave)
		tdPetSpawnWild(lane, wave, GetRandomInt(1, TD_PET_SPECIES_COUNT))

function onDeath()
	let record = tdPetWildFor(GetTriggerUnit())
	if record != null
		// Wild creatures never award materials, regardless of killer or deadline.
		tdPetWildTransition(record, TD_PET_WILD_EXPIRED)

public function tdPetSetupWild()
	if ready
		return
	ready = true
	deathTrigger.registerAnyUnitEvent(EVENT_PLAYER_UNIT_DEATH)
	deathTrigger.addAction(function onDeath)
	doPeriodically(0.25) cb ->
		let now = getElapsedGameTime()
		let iter = tdPetWildRecords.iterator()
		while iter.hasNext()
			let record = iter.next()
			if record.state == TD_PET_WILD_ALIVE
				if record.creature == null or not record.creature.isAlive() or tdPetPlayerHasLeft(record.lane) or now >= record.deadline or tdIsGameOver() or tdIsLaneDefeated(record.lane) or not tdIsLaneActive(record.lane)
					tdPetWildTransition(record, TD_PET_WILD_EXPIRED)
				else
					SetTextTagText(record.marker, "可捕获 " + IMaxBJ(0, (record.deadline - now).toInt()).toString() + "s", 0.022)
					SetTextTagPosUnit(record.marker, record.creature, 85.0)
					if record.waypoint < tdLaneWaypointCount(record.lane)
						let destination = tdLaneWaypointPosition(record.lane, record.waypoint)
						if record.creature.getPos().distanceTo(destination) < 32.0
							record.waypoint += 1
						else if record.creature.getCurrentOrder() != Orders.move
							record.creature.issuePointOrderById(Orders.move, destination)
					else
						let hold = tdPetWildHoldPosition(record.lane)
						if record.creature.getPos().distanceTo(hold) > 32.0
							record.creature.issuePointOrderById(Orders.move, hold)
						else
							record.creature.issueImmediateOrderById(Orders.stop)
			if record.state != TD_PET_WILD_ALIVE
				if record.creature != null
					record.creature.remove()
				iter.remove()
				destroy record
		iter.close()
		if tdIsGameOver()
			destroy cb





