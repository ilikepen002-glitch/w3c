package TDPetEffectState

// Narrow pure compatibility model for frost-arrow qualities0..3, wind4..7
// and stasis aura. Production uses source-aware TDEnemySlowState instead.
public class TDPetSlowState
	private real array[8] powers
	private real array[8] expiries
	private real aura = 0.0

	function clearAura()
		aura = 0.0

	function refreshAura(real power)
		aura = RMaxBJ(aura, power)

	function refresh(int channel, real power, real duration, real now)
		if channel < 0 or channel > 7 or duration <= 0.0
			return
		if now >= expiries[channel] or power >= powers[channel]
			powers[channel] = power
			expiries[channel] = RMaxBJ(expiries[channel], now + duration)

	function effectivePower(real now) returns real
		var frost = 0.0
		var wind = 0.0
		// Higher active quality replaces its own weaker rank, not other skills.
		for quality = 0 to 3
			if now < expiries[quality]
				frost = powers[quality]
			if now < expiries[quality + 4]
				wind = powers[quality + 4]
		return RMinBJ(0.75, frost + wind + aura)
