package TDPetWildState

public constant int TD_PET_WILD_ALIVE = 0
public constant int TD_PET_WILD_CAPTURED = 1
public constant int TD_PET_WILD_KILLED = 2
public constant int TD_PET_WILD_EXPIRED = 3

public class TDPetWildState
	int lane
	int state = TD_PET_WILD_ALIVE
	boolean hunting = false
	real deadline
	construct(int lane, real appearedAt)
		this.lane = lane
		deadline = appearedAt + 60.0

	function canCapture(boolean alive, real now) returns boolean
		return state == TD_PET_WILD_ALIVE and not hunting and alive and now < deadline

	function beginHunt(boolean alive, real now) returns boolean
		if not canCapture(alive, now)
			return false
		hunting = true
		return true

	function settle(int nextState, real now) returns boolean
		if state != TD_PET_WILD_ALIVE or nextState < 1 or nextState > 3
			return false
		if nextState != TD_PET_WILD_EXPIRED and now >= deadline
			state = TD_PET_WILD_EXPIRED
			return false
		if nextState == TD_PET_WILD_CAPTURED and hunting
			return false
		if nextState == TD_PET_WILD_KILLED and not hunting
			return false
		state = nextState
		return true
