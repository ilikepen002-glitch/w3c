package TDPetElementData
import TDPetData
import TDActiveSkillData
import TDTooltipText

public function tdPetElementSkill(int element, int quality) returns int
	if element < 1 or element > 5 or quality < 1 or quality > 4
		return -1
	return TD_PET_ELEMENT_SKILL_FIRST + (element - 1) * 4 + quality - 1

public function tdPetSkillElement(int skill) returns int
	return skill >= TD_PET_ELEMENT_SKILL_FIRST and skill <= TD_PET_ELEMENT_SKILL_LAST ? (skill - TD_PET_ELEMENT_SKILL_FIRST) div 4 + 1 : 0

public function tdPetSkillFixedQuality(int skill) returns int
	return tdPetSkillElement(skill) != 0 ? (skill - TD_PET_ELEMENT_SKILL_FIRST) mod 4 + 1 : 0

public function tdPetSkillQualityValid(int skill, int quality) returns boolean
	if quality < 1 or quality > 4
		return false
	let fixed = tdPetSkillFixedQuality(skill)
	return fixed == 0 or fixed == quality

public function tdPetElementSkillName(int skill) returns string
