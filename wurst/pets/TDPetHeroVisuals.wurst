package TDPetHeroVisuals
import TDPetHeroRules
import TDCombatVisualRuntime
import TDTrialIdentity
import GameTimer

// Hero procs only: never called by the generic possessed-tower attack path.
// Reuse the bounded cosmetic owner; no new timer, scan, damage or orders.
function tdPetHeroVisualModel(int skill) returns string
	if skill == TD_PET_HERO_FROST
		return "Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdx"
	if skill == TD_PET_HERO_MOON
		return "Abilities\\Spells\\NightElf\\Starfall\\StarfallTarget.mdx"
	if skill == TD_PET_HERO_BOSS or skill == TD_PET_HERO_HUNT
		return "Abilities\\Spells\\Orc\\Bloodlust\\BloodLustSpecial.mdx"
	if skill == TD_PET_HERO_STORM
		return "Abilities\\Spells\\Other\\Tornado\\TornadoElementalSmall.mdx"
	if skill == TD_PET_HERO_JUDGEMENT or skill == TD_PET_HERO_RELAY
		return "Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdx"
	if skill == TD_PET_HERO_POISON or skill == TD_PET_HERO_EPIDEMIC
		return "Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdx"
	return skill == TD_PET_HERO_ROOT ? "Abilities\\Spells\\NightElf\\EntanglingRoots\\EntanglingRootsTarget.mdx" : ""

function tdPetHeroVisualPoint(unit host, int lane, string model, vec2 point, tdTrialCombatContext context)
	if host == null or GetUnitTypeId(host) == 0 or not host.isAlive() or model == "" or not tdTrialContextValid(context) or not tdCombatVisualAcquireCast()
		return
	let art = AddSpecialEffect(model, point.x, point.y)
	// Keep Stand visible instead of immediately jumping to the native Death track.
	if not tdCombatVisualAdoptPetPoint(tdCombatVisualNewSerial(), host, lane, art, getElapsedGameTime() + 0.45, context)
		if art != null
			DestroyEffect(art)
		tdCombatVisualReleaseCast()

// The tail hit is instantaneous: show the whirlwind and four outward blades
// together at its real completion, not a cosmetic projectile that delays damage.
public function tdPetHeroVisual(unit host, int lane, int skill, vec2 point, tdTrialCombatContext context)
	tdPetHeroVisualPoint(host, lane, tdPetHeroVisualModel(skill), point, context)
	if skill == TD_PET_HERO_STORM
		let blade = "Abilities\\Weapons\\GlaiveMissile\\GlaiveMissile.mdx"
		tdPetHeroVisualPoint(host, lane, blade, point + vec2(140.0, 0.0), context)
		tdPetHeroVisualPoint(host, lane, blade, point + vec2(-140.0, 0.0), context)
		tdPetHeroVisualPoint(host, lane, blade, point + vec2(0.0, 140.0), context)
		tdPetHeroVisualPoint(host, lane, blade, point + vec2(0.0, -140.0), context)

// A brief chest glow means a charge/mark was accepted, not that damage landed.
public function tdPetHeroVisualReady(unit host, int lane, tdTrialCombatContext context)
	if host == null or GetUnitTypeId(host) == 0 or not host.isAlive() or not tdTrialContextValid(context) or not tdCombatVisualAcquireCast()
		return
	let art = AddSpecialEffectTarget("Abilities\\Spells\\Human\\InnerFire\\InnerFireTarget.mdx", host, "chest")
	if not tdCombatVisualAdoptPetPoint(tdCombatVisualNewSerial(), host, lane, art, getElapsedGameTime() + 0.45, context)
		if art != null
			DestroyEffect(art)
		tdCombatVisualReleaseCast()
