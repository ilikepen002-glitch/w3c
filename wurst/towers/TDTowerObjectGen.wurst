package TDTowerObjectGen
import TDConfig
import TDTooltipText
import TDWaves
import TDTowerEvolutionState
import TDTowerData
import TDItemData
import ChannelAbilityPreset
import Icons
import ObjEditingNatives
import TDPetData
import TDEquipmentObjectGen

function tdGeneratePassiveDisplay(int abilityId, string name, string icon, int buttonX, int levels) returns AbilityDefinitionBladeMasterCriticalStrike
	let definition = new AbilityDefinitionBladeMasterCriticalStrike(abilityId)
	definition
	..setName(name)
	..setLevels(levels)
	..setIconNormal(icon)
	..setIconResearch(icon)
	..presetButtonPosNormal(buttonX, 1)
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)
	for level = 1 to levels
		definition.setTooltipNormal(level, name)
		definition.setChancetoCriticalStrike(level, 0.0)
		definition.setDamageMultiplier(level, 1.0)
		definition.setDamageBonus(level, 0.0)
		definition.setNeverMiss(level, false)
	return definition

@compiletime function tdGenerateHiddenPassiveDisplays()
	let slow = tdGeneratePassiveDisplay(TD_DRYAD_SLOW_DISPLAY_ABILITY_ID, "缓速藤蔓", tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_DRYAD), 1, 61)
	let wideSlow = tdGeneratePassiveDisplay(TD_DRYAD_WIDE_SLOW_DISPLAY_ABILITY_ID, "宽域缓速藤蔓", tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_DRYAD), 1, 61)
	let evolvedSlow = tdGeneratePassiveDisplay(TD_DRYAD_EVOLVED_SLOW_DISPLAY_ABILITY_ID, "进化缓速藤蔓", tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_DRYAD), 1, 61)
	for level = 1 to 61
		slow.setTooltipNormalExtended(level, "被动：周围225范围敌军移动速度降低" + tdPreciseBonusPercentString(tdEquipmentSlowAuraReduction(false, level)) + "。")
		wideSlow.setTooltipNormalExtended(level, "被动：周围265范围敌军移动速度降低" + tdPreciseBonusPercentString(tdEquipmentSlowAuraReduction(false, level)) + "。")
		evolvedSlow.setTooltipNormalExtended(level, "被动：周围265范围敌军移动速度降低" + tdPreciseBonusPercentString(tdEquipmentSlowAuraReduction(true, level)) + "。")
	let frenzy = tdGeneratePassiveDisplay(TD_GHOUL_FRENZY_DISPLAY_ABILITY_ID, "狂热", tdTowerBaseSkillIconPath(TD_TOWER_CHOICE_GHOUL), 0, 1)
	frenzy.setTooltipNormalExtended(1, "被动：攻击速度提高" + tdBonusPercentString(tdGhoulFrenzyAttackSpeedBonus()) + "。")
	let evolvedFrenzy = tdGeneratePassiveDisplay(TD_GHOUL_PERFECT_FRENZY_DISPLAY_ABILITY_ID, "进化狂热", tdTowerPerfectSkillIconPath(TD_TOWER_CHOICE_GHOUL), 0, 1)
	evolvedFrenzy.setTooltipNormalExtended(1, "被动：攻击速度提高" + tdPreciseBonusPercentString(tdGhoulFrenzyAttackSpeedBonus() * tdEvolutionSkillMultiplier()) + "。")
	let swordDance = tdGeneratePassiveDisplay(TD_ORC_SWORD_DANCE_DISPLAY_ABILITY_ID, "剑舞", tdOrcSwordDanceIconPath(), 1, 1)
	swordDance.setTooltipNormalExtended(1, "被动：攻击速度提高" + tdBonusPercentString(tdOrcSwordDanceAttackSpeedBonus()) + "。")

function BuildingDefinition.tdApplyPlacementRules() returns BuildingDefinition
	// pre1.29 placement wrappers are reversed; UnitMetaData.slk defines these fields.
	this.def.setString("upar", tdTowerPlacementRequires())
	this.def.setString("upap", tdTowerPlacementPreventedBy())
	return this

function BuildingDefinition.tdApplyTowerBuildingStats(int towerChoice, int level, int branch, string abilities) returns BuildingDefinition
	this
	..setName(tdTowerDisplayNameForBranch(towerChoice, level, branch))
	..setTooltipBasic(tdTowerDisplayNameForBranch(towerChoice, level, branch))
	..setTooltipExtended(tdTowerTooltipExtendedForBranch(towerChoice, level, branch))
	..setDescription(tdTowerLoreForBranch(towerChoice, level, branch))
	..setHitPointsMaximumBase(tdTowerBaseHitPointsForBranch(towerChoice, level, branch))
	..setDefenseBase(tdTowerBaseArmorForBranch(towerChoice, level, branch))
	..setAttack1DamageBase(tdTowerBaseDamageForBranch(towerChoice, level, branch))
	..setAttack1DamageNumberofDice(1)
	..setAttack1DamageSidesperDie(6 + level)
	..setAttack1CooldownTime(tdTowerBaseCooldownForBranch(towerChoice, level, branch))
	..setAttack1Range(tdTowerObjectAttackRangeForBranch(towerChoice, level, branch))
	..setAttack1RangeMotionBuffer(tdTowerAttackRangeMotionBuffer())
	..setAttacksEnabled(1)
	..setAttack1AttackType(tdTowerAttackType(towerChoice))
	..setAttack1WeaponType(tdTowerWeaponType(towerChoice))
	..setAttack1ProjectileArt(tdTowerProjectileArt(towerChoice))
	..setAttack1ProjectileSpeed(tdTowerProjectileSpeed(towerChoice))
	..setAttack1ProjectileHomingEnabled(tdTowerWeaponType(towerChoice) == WeaponType.Missile)
	..setModelFile(tdTowerModelPath(towerChoice, level))
	..setIsaBuilding(true)
	..setMovementType(MovementType.None)
	..setSpeedBase(0)
	..setSpeedMinimum(0)
	..setSpeedMaximum(0)
	..setCanFlee(false)
	..setCollisionSize(tdTowerCollisionSize())
	..setPathingMap(tdTowerPathingMap())
	..setAcquisitionRange(tdTowerAcquisitionRangeForBranch(towerChoice, level, branch))
	..setAttack1TargetsAllowed("enemy,ground,air,organic")
	..setGoldCost(tdTowerGoldCostForLevelBranch(towerChoice, level, branch))
	..setLumberCost(0)
	..setFoodCost(tdTowerFoodCostForObjectGen())
	..setFoodProduced(0)
	..setBuildTime(2 + level)
	..setRepairGoldCost(0)
	..setRepairLumberCost(0)
	..setRequirements(tdTowerRequirementsRawcodes(towerChoice, level))
	..setRequirementsLevels(tdTowerRequirementsLevelsRawcodes(towerChoice, level))
	..setDependencyEquivalents(tdTowerDependencyEquivalentsRawcodes(towerChoice, level))
	..setUpgradesUsed(tdTowerUpgradesUsedRawcodes(towerChoice, level))
	..setRace(tdTowerRaceForObjectGen())
	..tdApplyPlacementRules()
	..setUnitsTrained("")
	..setResearchesAvailable("")
	..setItemsMade("")
	..setGroundTexture(tdTowerGroundTexture())
	..setNormalAbilities(abilities + "," + TD_TOWER_INVENTORY_ABILITY_ID.toRawCode() + "," + TD_TOWER_SELL_ABILITY_ID.toRawCode() + "," + TD_TOWER_EVOLUTION_PROGRESS_ABILITY_ID.toRawCode())
	..setIconGameInterface(tdTowerIconPathForBranch(towerChoice, level, branch))
	..setIconScoreScreen(tdTowerIconPathForBranch(towerChoice, level, branch))
	..setPointValue(40 + level * 10)
	..setSelectionScale(tdTowerSelectionScale(towerChoice, level))
	..setSelectionCircleOnWater(true)
	..setScalingValue(0.95 + level * 0.03)
	..setButtonPositionX(tdTowerLevelButtonX(towerChoice, level, branch))
	..setButtonPositionY(tdTowerLevelButtonY(towerChoice, level, branch))
	..setHotkey(tdTowerHotkeyForLevelBranch(towerChoice, level, branch))
	return this

function tdGenerateDryadPoisonAbility(int abilityId, string name, string tooltip, string iconPath, real baseDamagePerSecond, real moveFactor, real attackFactor)
	let poison = new AbilityDefinitionSlowPoison(abilityId)
	poison
	..setName(name)
	..setTooltipNormal(1, name)
	..setTooltipNormalExtended(1, tooltip)
	..setIconNormal(iconPath)
	..setIconResearch(iconPath)
	..presetButtonPosNormal(0, 1)
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)
	tdConfigureEquipmentPoison(poison, baseDamagePerSecond, moveFactor, attackFactor)
	poison.presetTooltipNormal(lvl -> name)
	// Per-level poison text is generated alongside the actual control values.

// 这些 compiletime 定义会直接生成最终地图里的物编数据，
// 也就是把塔的平衡和技能配置放在代码里维护，而不是靠手改 WE。
@compiletime function tdGenerateTowerAbilities()
	new AbilityDefinitionMoonPriestessTrueshotAura(TD_ARCHER_TRUESHOT_ABILITY_ID)
	..setName("白虎战吼")
	..setTooltipNormal(1, "白虎战吼")
	..setTooltipNormalExtended(1, "900范围内友塔获得" + tdBonusPercentString(tdArcherAuraDamageBonus()) + "攻击力加成。")
	..setIconResearch(tdArcherAuraIconPath())
	..setIconNormal(tdArcherAuraIconPath())
	..setButtonPositionNormalX(1)
	..setButtonPositionNormalY(1)
	..setLevels(1)
	..setAreaofEffect(1, 900.0)
	..setDamageBonus(1, 0.0) // Source display only; shared registry applies one native self carrier.
	..setRangedBonus(1, true)
	..setMeleeBonus(1, true)
	..setFlatBonus(1, false)
	..setTargetsAllowed(1, "self")
	..setBuffs(1, "")
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)

	let splitArrow = tdGeneratePassiveDisplay(TD_ARCHER_SPLIT_ARROW_ABILITY_ID, "分裂箭", tdTowerBaseSkillIconPath(TD_TOWER_CHOICE_ARCHER), 0, 2)
	splitArrow.setTooltipNormalExtended(1, "普通攻击会同时射出多支箭，每支箭造成相同伤害。1级总计2个目标，每升1级额外+1个目标，5级总计6个、6级两分支总计7个目标。")
	splitArrow.setTooltipNormal(2, "进化分裂箭")
	splitArrow.setTooltipNormalExtended(2, "进化：6阶总计7个目标，仅额外箭伤害提高20%，主箭伤害不变。")

	new AbilityDefinitionBladeMasterCriticalStrike(TD_ORC_CRIT_ABILITY_ID)
	..setName("致命一击")
	..setTooltipNormal(1, "致命一击")
	..setTooltipNormalExtended(1, "被动：有" + tdBonusPercentString(tdOrcCriticalStrikeChance()) + "概率造成" + tdTooltipNumber(tdOrcCriticalStrikeMultiplier()) + "倍伤害，并额外附加" + tdOrcCriticalStrikeDamageBonus().toInt().toString() + "点伤害。")
	..setIconNormal(tdTowerBaseSkillIconPath(TD_TOWER_CHOICE_ORC))
	..setIconResearch(tdTowerBaseSkillIconPath(TD_TOWER_CHOICE_ORC))
	..presetButtonPosNormal(0, 1)
	..setChancetoCriticalStrike(1, tdOrcCriticalStrikeChance() * 100.0)
	..setDamageMultiplier(1, tdOrcCriticalStrikeMultiplier())
	..setDamageBonus(1, tdOrcCriticalStrikeDamageBonus())
	..setNeverMiss(1, true)
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)

	new AbilityDefinitionAttackSpeedIncrease(TD_ORC_SWORD_DANCE_ABILITY_ID)
	..setName("剑舞")
	..setTooltipNormal(1, "剑舞")
	..setTooltipNormalExtended(1, "被动：攻击速度提高" + tdBonusPercentString(tdOrcSwordDanceAttackSpeedBonus()) + "。")
	..setIconNormal(tdOrcSwordDanceIconPath())
	..setIconResearch(tdOrcSwordDanceIconPath())
	..presetButtonPosNormal(1, 1)
	..setAttackSpeedIncrease(1, tdOrcSwordDanceAttackSpeedBonus())
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)

	let equipmentBloodlust = new AbilityDefinitionBloodlust(TD_ORC_BLOODLUST_ABILITY_ID)
	equipmentBloodlust
	..setName("嗜血")
	..setTooltipNormal(1, "嗜血")
	..setTooltipNormalExtended(1, "主动：可设为自动施放。剑圣为自己灌注嗜血，在" + tdOrcBloodlustDuration().toString() + "秒内提高" + tdBonusPercentString(tdOrcBloodlustAttackSpeedBonus()) + "攻击速度。")
	..setIconNormal(tdOrcBloodlustIconPath())
	..setIconResearch(tdOrcBloodlustIconPath())
	..setIconTurnOff(tdOrcBloodlustIconPath())
	..presetButtonPosNormal(tdOrcUltimateSkillButtonX(), tdOrcUltimateSkillButtonY())
	..setButtonPositionTurnOffX(tdOrcUltimateSkillButtonX())
	..setButtonPositionTurnOffY(tdOrcUltimateSkillButtonY())
	..setHotkeyNormal(tdOrcUltimateSkillHotkey())
	..setHotkeyTurnOff(tdOrcUltimateSkillHotkey())
	..setMovementSpeedIncrease(1, tdOrcBloodlustMoveSpeedBonus())
	..setAttackSpeedIncrease(1, tdOrcBloodlustAttackSpeedBonus())
	..setScalingFactor(1, 1.0)
	..presetDurationNormal(lvl -> tdOrcBloodlustDuration())
	..presetDurationHero(lvl -> tdOrcBloodlustDuration())
	..presetManaCost(lvl -> 0)
	..presetCastRange(lvl -> 0.0)
	..setTargetsAllowed(1, tdTowerBloodlustTargetsAllowed())
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)
	tdConfigureEquipmentBloodlust(equipmentBloodlust)

	let equipmentBladestorm = new AbilityDefinitionSlow(TD_ORC_BLADESTORM_ABILITY_ID)
	equipmentBladestorm
	..setName("剑刃风暴")
	..setTooltipNormal(1, "剑刃风暴")
	..setTooltipNormalExtended(1, "主动：可设为自动施放。锁定附近敌人后原地旋身" + tdOrcBladestormDuration().toString() + "秒，对自身周围" + tdOrcBladestormRadius().toInt().toString() + "范围内的敌军持续造成伤害。技能范围固定，不受装备射程加成影响。")
	..setTooltipTurnOff(1, "剑刃风暴")
	..setTooltipTurnOffExtended(1, "自动施放关闭：手动选择时再释放剑刃风暴。")
	..setIconNormal(tdOrcBladestormIconPath())
	..setIconResearch(tdOrcBladestormIconPath())
	..setIconTurnOff(tdOrcBladestormIconPath())
	..presetButtonPosNormal(tdOrcUltimateSkillButtonX(), tdOrcUltimateSkillButtonY())
	..setButtonPositionTurnOffX(tdOrcUltimateSkillButtonX())
	..setButtonPositionTurnOffY(tdOrcUltimateSkillButtonY())
	..setHotkeyNormal(tdOrcUltimateSkillHotkey())
	..setHotkeyTurnOff(tdOrcUltimateSkillHotkey())
	// Aslo is only an autocast carrier; its native reductions must be zero.
	..setMovementSpeedFactor(1, 0.0)
	..setAttackSpeedFactor(1, 0.0)
	..setAlwaysAutocast(1, true)
	..presetManaCost(lvl -> 0)
	..presetCastRange(lvl -> tdOrcBladestormRadius())
	..setTargetsAllowed(1, "enemy,ground,air,organic")
	..setBuffs(1, "")
	..presetDurationNormal(lvl -> 0.0)
	..presetDurationHero(lvl -> 0.0)
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)
	tdConfigureEquipmentBladestorm(equipmentBladestorm)

	let equipmentBash = new AbilityDefinitionMountainKingBash(TD_FOOT_BASH_ABILITY_ID)
	equipmentBash
	..setName("盾击")
	..setTooltipNormal(1, "盾击")
	..setTooltipNormalExtended(1, "被动：有" + tdBonusPercentString(tdFootmanBashChance()) + "概率触发脚本短晕盾击，不附加伤害。")
	..setIconNormal(tdTowerBaseSkillIconPath(TD_TOWER_CHOICE_FOOTMAN))
	..setIconResearch(tdTowerBaseSkillIconPath(TD_TOWER_CHOICE_FOOTMAN))
	..presetButtonPosNormal(0, 1)
	..setChancetoBash(1, 0.0)
	..setDamageMultiplier(1, tdFootmanBashDamageMultiplier())
	..setDamageBonus(1, tdFootmanBashDamageBonus())
	..setNeverMiss(1, true)
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)
	tdConfigureEquipmentBash(equipmentBash, false)

	new AbilityDefinitionItemAuraCommand(TD_FOOT_COMMAND_ABILITY_ID)
	..setName("统帅光环")
	..setTooltipNormal(1, "统帅光环")
	..setTooltipNormalExtended(1, "900范围内友塔获得" + tdBonusPercentString(tdFootmanCommandAuraDamageBonus()) + "攻击力加成。")
	..setIconNormal(tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_FOOTMAN))
	..setIconResearch(tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_FOOTMAN))
	..presetButtonPosNormal(1, 1)
	..setLevels(1)
	..setAreaofEffect(1, 900.0)
	..setAttackDamageIncrease(1, 0.0) // Source must not add a second native range aura.
	..setRangedBonus(1, true)
	..setMeleeBonus(1, true)
	..setFlatBonus(1, false)
	..setTargetsAllowed(1, "self")
	..setBuffs(1, "")
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)

	tdGenerateDryadPoisonAbility(
		TD_DRYAD_POISON_ABILITY_ID,
		"毒镖",
		"被动：普通攻击附带持续毒伤，并对单个目标施加" + tdSlowPercentString(tdDryadSlowFactor()) + "移动减速。",
		tdTowerBaseSkillIconPath(TD_TOWER_CHOICE_DRYAD),
		tdDryadPoisonDps(),
		tdDryadSlowFactor(),
		tdDryadAttackSlowFactor()
	)

	let equipmentSlowAura = new AbilityDefinitionAuraSlow(TD_DRYAD_SLOW_AURA_ABILITY_ID)
	equipmentSlowAura
	..setName("缓速藤蔓")
	..setTooltipNormal(1, "缓速藤蔓")
	..setTooltipNormalExtended(1, "被动：周围敌军移动速度降低" + tdSlowPercentString(tdDryadAuraSlowFactor()) + "。")
	..setIconResearch(tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_DRYAD))
	..setIconNormal(tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_DRYAD))
	..setButtonPositionNormalX(1)
	..setButtonPositionNormalY(1)
	..setAreaofEffect(1, tdDryadAuraSlowRadius())
	..setTargetsAllowed(1, "enemy,ground,air,organic")
	// Aasl stores a signed additive change; positive values speed enemies up.
	..setMovementSpeedFactor(1, tdDryadAuraSlowFactor() - 1.0)
	..setAttackSpeedFactor(1, 0.0)
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)
	tdConfigureEquipmentSlowAura(equipmentSlowAura, false, tdDryadAuraSlowRadius())

	let wideSlowAura = new AbilityDefinitionAuraSlow(TD_DRYAD_WIDE_SLOW_ABILITY_ID)
	wideSlowAura
	..setName("宽域缓速藤蔓")
	..setHeroAbility(false)
	..setItemAbility(false)
	..setIconNormal(tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_DRYAD))
	..setIconResearch(tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_DRYAD))
	..presetButtonPosNormal(1, 1)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)
	tdConfigureEquipmentSlowAura(wideSlowAura, false, tdDryadWideAuraSlowRadius())

	new AbilityDefinitionAttackSpeedIncrease(TD_GHOUL_FRENZY_ABILITY_ID)
	..setName("狂热")
	..setTooltipNormal(1, "狂热")
	..setTooltipNormalExtended(1, "被动：攻击速度提高" + tdBonusPercentString(tdGhoulFrenzyAttackSpeedBonus()) + "。")
	..setIconNormal(tdTowerBaseSkillIconPath(TD_TOWER_CHOICE_GHOUL))
	..setIconResearch(tdTowerBaseSkillIconPath(TD_TOWER_CHOICE_GHOUL))
	..presetButtonPosNormal(0, 1)
	..setAttackSpeedIncrease(1, tdGhoulFrenzyAttackSpeedBonus())
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)

	let corpseExplosion = tdGeneratePassiveDisplay(TD_GHOUL_CORPSE_EXPLOSION_DISPLAY_ABILITY_ID, "尸爆", tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_GHOUL), 1, 2)
	corpseExplosion.setTooltipNormalExtended(1, "普攻击杀攻击前生命值不高于" + tdBonusPercentString(tdGhoulCorpseExplosionLifeThreshold()) + "的敌人时，对其周围180范围内其他敌人造成36伤害。")
	corpseExplosion.setTooltipNormal(2, "进化尸爆")
	corpseExplosion.setTooltipNormalExtended(2, "普攻击杀攻击前生命值不高于" + tdBonusPercentString(tdGhoulCorpseExplosionLifeThreshold()) + "的敌人时，对其周围180范围内其他敌人造成43.2伤害。")

	new AbilityDefinitionMoonPriestessTrueshotAura(TD_ARCHER_PERFECT_TRUESHOT_ABILITY_ID)
	..setName("进化白虎战吼")
	..setTooltipNormal(1, "进化白虎战吼")
	..setTooltipNormalExtended(1, "900范围内友塔攻击力提高21.6%。")
	..setIconResearch(tdArcherPerfectAuraIconPath())
	..setIconNormal(tdArcherPerfectAuraIconPath())
	..setButtonPositionNormalX(1)
	..setButtonPositionNormalY(1)
	..setLevels(1)
	..setAreaofEffect(1, 900.0)
	..setDamageBonus(1, 0.0) // Highest-rank native self carrier owns this percentage.
	..setRangedBonus(1, true)
	..setMeleeBonus(1, true)
	..setFlatBonus(1, false)
	..setTargetsAllowed(1, "self")
	..setBuffs(1, "")
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)

	new AbilityDefinitionBladeMasterCriticalStrike(TD_ORC_PERFECT_CRIT_ABILITY_ID)
	..setName("进化致命一击")
	..setTooltipNormal(1, "进化致命一击")
	..setTooltipNormalExtended(1, "普攻有25%概率造成2.64倍伤害，并追加21.6伤害。")
	..setIconNormal(tdTowerPerfectSkillIconPath(TD_TOWER_CHOICE_ORC))
	..setIconResearch(tdTowerPerfectSkillIconPath(TD_TOWER_CHOICE_ORC))
	..presetButtonPosNormal(0, 1)
	..setChancetoCriticalStrike(1, tdOrcCriticalStrikeChance() * 100.0)
	..setDamageMultiplier(1, tdOrcCriticalStrikeMultiplier() * tdEvolutionSkillMultiplier())
	..setDamageBonus(1, tdOrcCriticalStrikeDamageBonus() * 1.20)
	..setNeverMiss(1, true)
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)

	let equipmentPerfectBash = new AbilityDefinitionMountainKingBash(TD_FOOT_PERFECT_BASH_ABILITY_ID)
	equipmentPerfectBash
	..setName("完美盾击")
	..setTooltipNormal(1, "完美盾击")
	..setTooltipNormalExtended(1, "被动：更高概率打出强化盾击。")
	..setIconNormal(tdTowerPerfectSkillIconPath(TD_TOWER_CHOICE_FOOTMAN))
	..setIconResearch(tdTowerPerfectSkillIconPath(TD_TOWER_CHOICE_FOOTMAN))
	..presetButtonPosNormal(0, 1)
	..setChancetoBash(1, 0.0)
	..setDamageMultiplier(1, tdFootmanBashDamageMultiplier())
	..setDamageBonus(1, tdFootmanBashDamageBonus() * 1.20)
	..setNeverMiss(1, true)
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)
	tdConfigureEquipmentBash(equipmentPerfectBash, true)

	tdGenerateDryadPoisonAbility(
		TD_DRYAD_PERFECT_POISON_ABILITY_ID,
		"进化毒镖",
		"进化：持续毒伤+20%，减速保留当前装备强化。",
		tdTowerPerfectSkillIconPath(TD_TOWER_CHOICE_DRYAD),
		tdDryadPoisonDps() * tdEvolutionSkillMultiplier(),
		tdDryadSlowFactor(),
		tdDryadAttackSlowFactor()
	)

	new AbilityDefinitionAttackSpeedIncrease(TD_GHOUL_PERFECT_FRENZY_ABILITY_ID)
	..setName("进化狂热")
	..setTooltipNormal(1, "进化狂热")
	..setTooltipNormalExtended(1, "被动：攻击速度提高" + tdPreciseBonusPercentString(tdGhoulFrenzyAttackSpeedBonus() * tdEvolutionSkillMultiplier()) + "。")
	..setIconNormal(tdTowerPerfectSkillIconPath(TD_TOWER_CHOICE_GHOUL))
	..setIconResearch(tdTowerPerfectSkillIconPath(TD_TOWER_CHOICE_GHOUL))
	..presetButtonPosNormal(0, 1)
	..setAttackSpeedIncrease(1, tdGhoulFrenzyAttackSpeedBonus() * tdEvolutionSkillMultiplier())
	..setHeroAbility(false)
	..setItemAbility(false)
	..setRequirements("")
	..setRequirementsLevels("")
	..setCheckDependencies(false)

	let wageAbility = new ChannelAbilityPreset(TD_FARMER_WAGE_ABILITY_ID, 1, true)
	wageAbility
	..setName("工资")
	..setTooltipNormal(1, "工资")
	..setTooltipNormalExtended(1, "领取当前波次+随机4至6金币。|n第1波开始后可用，冷却180秒。")
	..setIconNormal(tdFarmerWageIconPath())
	..setIconResearch(tdFarmerWageIconPath())
	..presetHotkey("G")
	..presetButtonPosNormal(3, 1)
	..presetTargetTypes(Targettype.NONE)
	..makeUnitSpell(0, tdFarmerWageCooldown())
	..setCheckDependencies(false)

	new AbilityDefinitionItemAuraCommand(TD_FOOT_EVOLVED_COMMAND_ABILITY_ID)
	..setName("进化统帅光环")
	..setLevels(1)
	..setAreaofEffect(1, 900.0)
	..setAttackDamageIncrease(1, 0.0) // Highest-rank native self carrier owns this percentage.
	..setRangedBonus(1, true)
	..setMeleeBonus(1, true)
	..setFlatBonus(1, false)
	..setTargetsAllowed(1, "self")
	..setBuffs(1, "")
	..setHeroAbility(false)
	..setItemAbility(false)
	..setIconNormal(tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_FOOTMAN))
	..setIconResearch(tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_FOOTMAN))
	..presetButtonPosNormal(1, 1)
	..setTooltipNormal(1, "进化统帅光环")
	..setTooltipNormalExtended(1, "周围900范围友塔攻击力提高19.2%。")

	let evolvedSlow = new AbilityDefinitionAuraSlow(TD_DRYAD_EVOLVED_SLOW_ABILITY_ID)
	evolvedSlow
	..setName("进化缓速藤蔓")
	..setHeroAbility(false)
	..setItemAbility(false)
	..setIconNormal(tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_DRYAD))
	..setIconResearch(tdTowerSupportSkillIconPath(TD_TOWER_CHOICE_DRYAD))
	..presetButtonPosNormal(1, 1)
	tdConfigureEquipmentSlowAura(evolvedSlow, true, tdDryadWideAuraSlowRadius())

	let progress = new AbilityDefinitionBladeMasterCriticalStrike(TD_TOWER_EVOLUTION_PROGRESS_ABILITY_ID)
	progress
	..setName("累计击杀")
	..setLevels(tdMatchEnemyCountPerLane() + 1)
	..setHeroAbility(false)
	..setItemAbility(false)
	..setIconNormal(tdTowerEvolutionProgressIconPath())
	..setIconResearch(tdTowerEvolutionProgressIconPath())
	..presetButtonPosNormal(2, 2)
	..presetTooltipNormal(lvl -> "累计击杀：" + (lvl - 1).toString())
	..presetTooltipNormalExtended(lvl -> "本塔累计击杀：" + (lvl - 1).toString() + "。升级继承统计；进化后继续累计。达到" + TD_EVOLUTION_KILL_REQUIREMENT.toString() + "击杀且完成6阶升级后自动进化，全局仅一座。")
	for level = 1 to tdMatchEnemyCountPerLane() + 1
		progress.setChancetoCriticalStrike(level, 0.0)
		progress.setDamageMultiplier(level, 1.0)
		progress.setDamageBonus(level, 0.0)
		progress.setNeverMiss(level, false)

	let status = new AbilityDefinitionBladeMasterCriticalStrike(TD_TOWER_EVOLUTION_STATUS_ABILITY_ID)
	status
	..setName("击杀进化")
	..setLevels(3)
	..setHeroAbility(false)
	..setItemAbility(false)
	..setIconNormal(tdTowerEvolutionStatusIconPath())
	..setIconResearch(tdTowerEvolutionStatusIconPath())
	..presetButtonPosNormal(3, 2)
	..presetTooltipNormal(lvl -> lvl == 3 ? "名额已用" : (lvl == 2 ? "已进化" : "等待完成6阶"))
	..presetTooltipNormalExtended(lvl -> lvl == 3 ? "其他塔已使用本局唯一进化名额，此塔无法进化。击杀数仍会累计。" : (lvl == 2 ? "此塔已进化，当前分支技能已强化。|n出售或失守不返还全局进化名额。" : "完成6阶升级且累计" + TD_EVOLUTION_KILL_REQUIREMENT.toString() + "击杀后自动进化，强化当前分支技能。|n全局仅1座；出售或失守不返还名额。具体强化见分支说明。"))
	for level = 1 to 3
		status.setChancetoCriticalStrike(level, 0.0)
		status.setDamageMultiplier(level, 1.0)
		status.setDamageBonus(level, 0.0)
		status.setNeverMiss(level, false)

	new ChannelAbilityPreset(TD_TOWER_SELL_ABILITY_ID, 1, true)
	..setName("卖塔")
	..setTooltipNormal(1, "卖塔 (V)")
	..setTooltipNormalExtended(1, tdTowerSellTooltip())
	..setIconNormal(tdTowerSellIconPath())
	..setIconResearch(tdTowerSellIconPath())
	..presetHotkey("V")
	..presetButtonPosNormal(tdTowerSellButtonX(), tdTowerSellButtonY())
	..presetTargetTypes(Targettype.NONE)
	..makeUnitSpell(0, 0.0)
	..setCheckDependencies(false)

// 在编译期生成农民单位对应的物编数据，
// 这样地图就不依赖于编辑器里手工做好的自定义单位。
@compiletime function tdGenerateBuilderObjects()
	new UnitDefinition(TD_FARMER_UNIT_ID, 'hpea')
	..setName("TD农民")
	..setTooltipBasic("TD农民")
	..setTooltipExtended("空中建造工人，可穿越障碍。发起建造后建筑自行施工；U 范围升级地面装备，C 打开背包合成。")
	..setDescription("TD工人")
	..setRace(tdFarmerRaceForObjectGen())
	// Remove Human repair atomically with switching the native build mode.
	..setDefaultActiveAbility("")
	..setNormalAbilities(TD_FARMER_BUILD_ABILITY_ID.toRawCode() + "," + TD_FARMER_WAGE_ABILITY_ID.toRawCode() + "," + TD_FARMER_INVENTORY_ABILITY_ID.toRawCode() + "," + TD_FARMER_EQUIPMENT_BOOK_ABILITY_ID.toRawCode() + "," + TD_FARMER_GROUND_UPGRADE_ABILITY_ID.toRawCode() + "," + TD_PET_CAPTURE_ABILITY_ID.toRawCode() + "," + TD_PET_COLLECTION_ABILITY_ID.toRawCode() + "," + TD_PET_DEPLOY_ABILITY_ID.toRawCode())
	..setStructuresBuilt(tdFarmerBuildMenuRawcodes())
	..setGoldCost(0)
	..setLumberCost(0)
	..setFoodCost(tdFarmerFoodCostForObjectGen())
	..setFoodProduced(0)
	..setAttacksEnabled(0)
	..setAcquisitionRange(0)
	..setCanFlee(false)
	..setMovementType(MovementType.Fly)
	..setMovementHeight(275.0)
	..setMovementHeightMinimum(275.0)
	..setSpeedBase(tdFarmerBaseMoveSpeed())
	..setSpeedMinimum(tdFarmerBaseMoveSpeed())
	..setSpeedMaximum(tdFarmerBaseMoveSpeed())
	..setHotkey("B")

function tdGenerateTowerLevelObject(int towerChoice, int level, int branch)
	let definition = new BuildingDefinition(tdTowerUnitIdForLevelBranch(towerChoice, level, branch), tdTowerObjectParentId(towerChoice, level))
	definition
	..tdApplyTowerBuildingStats(towerChoice, level, branch, tdTowerNormalAbilitiesRawcodesForBranch(towerChoice, level, branch))
	definition.setUpgradesTo(tdTowerUpgradeRawcode(towerChoice, level))

function tdGenerateTowerFamilyObjects(int towerChoice)
	for level = 1 to 5
		tdGenerateTowerLevelObject(towerChoice, level, TD_TOWER_BRANCH_A)
	tdGenerateTowerLevelObject(towerChoice, 6, TD_TOWER_BRANCH_A)
	tdGenerateTowerLevelObject(towerChoice, 6, TD_TOWER_BRANCH_B)

// 在编译期根据代码里的数值批量生成所有塔的等级和升级链。
@compiletime function tdGenerateTowerObjects()
	for towerChoice = 1 to TD_TOWER_CHOICE_COUNT
		tdGenerateTowerFamilyObjects(towerChoice)

