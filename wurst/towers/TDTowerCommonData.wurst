public function tdBonusPercentString(real bonus) returns string
	return (bonus * 100.0 + 0.5).toInt().toString() + "%"

public function tdSlowPercentString(real remainingFactor) returns string
	return ((1.0 - remainingFactor) * 100.0 + 0.5).toInt().toString() + "%"

public function tdPreciseBonusPercentString(real bonus) returns string
	// Three fractional percentage digits cover all 61 control levels exactly.
	let scaled = R2I(bonus * 100000.0 + 0.5)
	let whole = scaled div 1000
	let fraction = scaled mod 1000
	if fraction == 0
		return whole.toString() + "%"
	var digits = (fraction + 1000).toString().substring(1, 4)
	while digits.substring(digits.length() - 1, digits.length()) == "0"
		digits = digits.substring(0, digits.length() - 1)
	return whole.toString() + "." + digits + "%"
