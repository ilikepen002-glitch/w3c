public function tdTowerBaseSkillIconPath(int towerChoice) returns string
	if towerChoice == TD_TOWER_CHOICE_ARCHER
		return "war3mapImported\\BTNTDTowerSplitShot.blp"
	if towerChoice == TD_TOWER_CHOICE_ORC
		return tdOrcCriticalStrikeIconPath()
	if towerChoice == TD_TOWER_CHOICE_FOOTMAN
		return "war3mapImported\\BTNTDTowerShieldBash.blp"
	if towerChoice == TD_TOWER_CHOICE_DRYAD
		return "war3mapImported\\BTNTDTowerPoisonDart.blp"
	if towerChoice == TD_TOWER_CHOICE_GHOUL
		return "war3mapImported\\BTNTDTowerFrenzy.blp"
	return ""

public function tdTowerSupportSkillIconPath(int towerChoice) returns string
	if towerChoice == TD_TOWER_CHOICE_ARCHER
		return tdArcherAuraIconPath()
	if towerChoice == TD_TOWER_CHOICE_ORC
		return tdOrcBladestormIconPath()
	if towerChoice == TD_TOWER_CHOICE_FOOTMAN
		return "war3mapImported\\BTNTDTowerCommandAura.blp"
	if towerChoice == TD_TOWER_CHOICE_DRYAD
		return "war3mapImported\\BTNTDTowerVinesAura.blp"
	if towerChoice == TD_TOWER_CHOICE_GHOUL
		return "war3mapImported\\BTNTDTowerCorpseExplosion.blp"
	return ""

public function tdTowerPerfectSkillIconPath(int towerChoice) returns string
	if towerChoice == TD_TOWER_CHOICE_ARCHER
		return tdArcherPerfectAuraIconPath()
	if towerChoice == TD_TOWER_CHOICE_ORC
		return tdOrcCriticalStrikeIconPath()
	if towerChoice == TD_TOWER_CHOICE_FOOTMAN
		return "war3mapImported\\BTNTDTowerShieldBash.blp"
	if towerChoice == TD_TOWER_CHOICE_DRYAD
		return "war3mapImported\\BTNTDTowerPoisonDart.blp"
	if towerChoice == TD_TOWER_CHOICE_GHOUL
		return "war3mapImported\\BTNTDTowerFrenzy.blp"
	return ""

public function tdArcherSplitArrowTargetCount(int level) returns int
	if level < 1
		return 0
	var clampedLevel = level
	if level > TD_MAX_TOWER_LEVEL
		clampedLevel = TD_MAX_TOWER_LEVEL
	return clampedLevel + 1

public function tdArcherHasSplitArrowAtLevelBranch(int level, int _branch) returns boolean
	return level >= 1 and level <= TD_MAX_TOWER_LEVEL

public function tdArcherSplitArrowDamageMultiplier(int level, int branch, boolean evolved) returns real
	return evolved and level == TD_MAX_TOWER_LEVEL and branch == TD_TOWER_BRANCH_A ? tdEvolutionSkillMultiplier() : 1.0

public function tdGhoulCorpseExplosionDamageForBranch(int level, int branch, boolean evolved) returns real
	return tdGhoulCorpseExplosionDamage() * (evolved and level == TD_MAX_TOWER_LEVEL and branch == TD_TOWER_BRANCH_B ? tdEvolutionSkillMultiplier() : 1.0)

