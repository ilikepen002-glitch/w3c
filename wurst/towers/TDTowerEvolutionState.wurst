package TDTowerEvolutionState

public constant int TD_EVOLUTION_QUALIFY_WAVE = 24

// Kills are a statistic only. Qualification and payment belong to each lane.
public function tdEvolutionProgressLevel(int kills) returns int
	return kills + 1

public function tdEvolutionStatusLevel(boolean qualified, boolean evolved, boolean spent) returns int
	return evolved ? 3 : (spent ? 4 : (qualified ? 2 : 1))

public class TDTowerEvolutionLane
	private boolean qualified = false
	private boolean spent = false

	function isQualified() returns boolean
		return qualified

	function isSpent() returns boolean
		return spent

	function creditWave(int wave, boolean eligible, boolean resolved) returns boolean
		if qualified or not eligible or not resolved or wave != TD_EVOLUTION_QUALIFY_WAVE
			return false
		qualified = true
		return true

	function tryClaim(int level, boolean eligible, boolean working, boolean evolved) returns boolean
		if not qualified or spent or working or evolved or not eligible or level != 6
			return false
		spent = true
		return true

public function tdEvolutionKillEligible(boolean enemyOwned, boolean leaked, boolean towerAlive, int towerChoice, int towerOwner, int enemyLane) returns boolean
	return enemyOwned and not leaked and towerAlive and towerChoice > 0 and towerOwner == enemyLane
