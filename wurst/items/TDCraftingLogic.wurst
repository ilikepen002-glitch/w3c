package TDCraftingLogic
import TDItemData

public constant int TD_CRAFT_MODE_NONE = 0
public constant int TD_CRAFT_MODE_THREE = 3

public function tdCraftModeForQualities(int quality1, int quality2, int quality3) returns int
	if quality1 >= TD_ITEM_QUALITY_WHITE and quality1 < TD_ITEM_QUALITY_PURPLE and quality1 == quality2 and quality2 == quality3
		return TD_CRAFT_MODE_THREE
	return TD_CRAFT_MODE_NONE

public function tdCraftConsumesSlot(int quality1, int quality2, int quality3, int slot) returns boolean
	return tdCraftModeForQualities(quality1, quality2, quality3) == TD_CRAFT_MODE_THREE and slot >= 0 and slot <= 2

public function tdCraftSucceeds(int mode, int _rollPercent) returns boolean
	return mode == TD_CRAFT_MODE_THREE

public function tdCraftResultQuality(int sourceQuality) returns int
	if sourceQuality < TD_ITEM_QUALITY_WHITE or sourceQuality >= TD_ITEM_QUALITY_PURPLE
		return 0
	return sourceQuality + 1
