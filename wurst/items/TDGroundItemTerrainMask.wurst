function tdGroundTerrainCell(real coordinate) returns int
	return ((coordinate - TD_GROUND_TERRAIN_ORIGIN) / TD_GROUND_TERRAIN_CELL_SIZE).floor()

function tdGroundTerrainCellInMap(int cellX, int cellY) returns boolean
	return cellX >= 0 and cellY >= 0 and cellX < TD_GROUND_TERRAIN_CELLS and cellY < TD_GROUND_TERRAIN_CELLS

public function tdGroundSortSourceLane(real x, real y) returns int
	let cellX = tdGroundTerrainCell(x)
	let cellY = tdGroundTerrainCell(y)
	if not tdGroundTerrainCellInMap(cellX, cellY)
		return -1
	let value = SubString(tdGroundSourceMaskRow(cellY), cellX, cellX + 1)
	if value == "0"
		return 0
	if value == "1"
		return 1
	if value == "2"
		return 2
	if value == "3"
		return 3
	return -1

public function tdGroundPointSafeForItem(real x, real y) returns boolean
	let cellX = tdGroundTerrainCell(x)
	let cellY = tdGroundTerrainCell(y)
	if not tdGroundTerrainCellInMap(cellX, cellY)
		return false
	return SubString(tdGroundSafeLayerRow(cellY), cellX, cellX + 1) != "-"

public function tdGroundSortDestinationAllowed(int lane, real x, real y) returns boolean
	if lane < 0 or lane >= 4
		return false
	let pointLane = x < 0.0 ? (y >= 0.0 ? 0 : 3) : (y >= 0.0 ? 1 : 2)
	if pointLane != lane
		return false
	let cellX = tdGroundTerrainCell(x)
	let cellY = tdGroundTerrainCell(y)
	if not tdGroundTerrainCellInMap(cellX, cellY)
		return false
	return SubString(tdGroundSafeLayerRow(cellY), cellX, cellX + 1) == "1"

public function tdGroundSortSourceMin(int lane) returns vec2
	if lane == 0
		return vec2(-3072.0, 128.0)
	if lane == 1
		return vec2(1024.0, 384.0)
	if lane == 2
		return vec2(896.0, -3200.0)
	if lane == 3
		return vec2(-2944.0, -3200.0)
	return vec2(0.0, 0.0)

public function tdGroundSortSourceMax(int lane) returns vec2
	if lane == 0
		return vec2(-1024.0, 2816.0)
	if lane == 1
		return vec2(2816.0, 2816.0)
	if lane == 2
		return vec2(2816.0, -512.0)
	if lane == 3
		return vec2(-896.0, -512.0)
	return vec2(0.0, 0.0)
