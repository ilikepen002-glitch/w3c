package TDShieldRuntime
import TDShieldRules
import TDEquipmentSpecialObjectIds
import TDEquipmentCombat
import TDItemData
import TDItemCatalogConfig
import TDTowerData
import TDWaves
import TDState
import DummyCaster
import Orders
import GameTimer
import ClosureTimers
import LinkedList
import Table

class TDShieldEnemyWindow
	unit enemy
	TDShieldWindow window = new TDShieldWindow()
	construct(unit enemy)
		this.enemy = enemy
	ondestroy
		destroy window

constant Table tdShieldByHandle = new Table()
LinkedList<TDShieldEnemyWindow> tdShieldWindows = new LinkedList<TDShieldEnemyWindow>()
boolean tdShieldRuntimeReady = false

function tdShieldWindowFor(unit enemy) returns TDShieldEnemyWindow
	if tdShieldByHandle.hasInt(enemy.getHandleId())
		return tdShieldByHandle.loadInt(enemy.getHandleId()) castTo TDShieldEnemyWindow
	let record = new TDShieldEnemyWindow(enemy)
	tdShieldByHandle.saveInt(enemy.getHandleId(), record castTo int)
	tdShieldWindows.add(record)
	return record

function tdTryShieldStun(unit source, unit enemy, int lane, int controlLevel) returns boolean
	if not tdEquipmentEnemyValid(enemy, lane) or not tdEquipmentSourceValid(source, lane)
		return false
	let boss = tdIsBossUnitTypeId(GetUnitTypeId(enemy))
	let record = tdShieldWindowFor(enemy)
	let now = getElapsedGameTime()
	let control = (controlLevel - 1) / 100.0
	// Shared enemy window is reserved BEFORE issuing the potentially reentrant order.
	let previous = record.window.reserve(now, boss, control)
	if previous < 0.0
		return false
	let caster = new DummyCaster()
	caster.origin(enemy.getPos())
	caster.owner(GetOwningPlayer(source))
	caster.delay(tdShieldStunDuration(boss, control) + tdConfiguredShieldCastMargin() + 0.25)
	let dummy = caster.castTarget(boss ? TD_SHIELD_BOSS_STUN_ID : TD_SHIELD_NORMAL_STUN_ID, boss ? 1 : controlLevel, Orders.thunderbolt, enemy)
	if dummy == null
		record.window.rollback(previous)
		return false
	// Accepted order is the transaction success boundary, not observed native stun.
	return true

public function tdEquipmentHasSpecial(unit tower, int specialization) returns boolean
	for slot = 0 to 2
		if tdItemSpecialization(tdEquipmentItemId(tower, slot)) == specialization
			return true
	return false

public function tdTryEquipmentShieldProc(unit source, unit target, int lane)
	var level = source.getAbilityLevel(TD_FOOT_PERFECT_BASH_ABILITY_ID)
	let perfect = level > 0
	if not perfect
		level = source.getAbilityLevel(TD_FOOT_BASH_ABILITY_ID)
	if level <= 0 or GetRandomReal(0.0, 1.0) >= tdShieldProcChance(perfect)
		return
	if not tdTryShieldStun(source, target, lane, level)
		return
	if not tdEquipmentHasSpecial(source, TD_ITEM_SPECIAL_SHIELD_SPREAD)
		return
	if tdIsBossUnitTypeId(GetUnitTypeId(target))
		// Baseline Boss short stun above; purple only adds armor, never extra CC.
		tdApplyEquipmentArmor(target, lane, tdConfiguredShieldBossArmor(), tdConfiguredShieldBossArmorDuration())
		return
	let center = target.getPos()
	let radius = tdConfiguredSpecialRadius(TD_ITEM_SPECIAL_SHIELD_SPREAD)
	let targets = CreateGroup()
	targets.enumUnitsInRange(center, radius)
	var additional = 0
	for victim in targets
		if additional >= tdConfiguredSpecialTargetCap(TD_ITEM_SPECIAL_SHIELD_SPREAD)
			break
		if victim == target or not tdEquipmentEnemyValid(victim, lane) or tdIsBossUnitTypeId(GetUnitTypeId(victim))
			continue
		if center.distanceTo(victim.getPos()) > radius
			continue
		if tdTryShieldStun(source, victim, lane, level)
			additional += 1
	targets.destr()

public function tdForgetEquipmentShieldEnemy(unit enemy)
	if enemy == null or not tdShieldByHandle.hasInt(enemy.getHandleId())
		return
	let record = tdShieldByHandle.loadInt(enemy.getHandleId()) castTo TDShieldEnemyWindow
	tdShieldByHandle.removeInt(enemy.getHandleId())
	tdShieldWindows.remove(record)
	destroy record

public function tdSetupShieldRuntime()
	if tdShieldRuntimeReady
		return
	tdShieldRuntimeReady = true
	doPeriodically(0.10) cb ->
		let now = getElapsedGameTime()
		let iter = tdShieldWindows.iterator()
		while iter.hasNext()
			let record = iter.next()
			if GetUnitTypeId(record.enemy) == 0 or not record.enemy.isAlive() or now >= record.window.readyAt or tdIsGameOver()
				tdShieldByHandle.removeInt(record.enemy.getHandleId())
				iter.remove()
				destroy record
		destroy iter
		if tdIsGameOver() and tdShieldWindows.isEmpty()
			destroy cb
