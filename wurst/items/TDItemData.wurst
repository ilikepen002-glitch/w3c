package TDItemData
import public TDItemCatalogSchema
import public TDItemCatalogIds
import TDItemCatalogConfig

public constant int TD_FARMER_INVENTORY_ABILITY_ID = 'A117'
public constant int TD_TOWER_INVENTORY_ABILITY_ID = 'A118'
public constant int TD_FARMER_CRAFT_ABILITY_ID = 'A119'
public constant int TD_FARMER_EQUIPMENT_BOOK_ABILITY_ID = 'Geqb'
public constant int TD_FARMER_GROUND_UPGRADE_ABILITY_ID = 'Gupg'
public constant int TD_TOWER_EQUIPMENT_ATTACK_BONUS_ABILITY_ID = 'A128'
public constant int TD_TOWER_EQUIPMENT_ATTACK_SPEED_BONUS_ABILITY_ID = 'A129'
public constant int TD_TOWER_EQUIPMENT_ATTACK_BONUS_MAX_LEVEL = 128
public constant int TD_TOWER_EQUIPMENT_ATTACK_SPEED_MAX_LEVEL = 120
public constant int TD_TOWER_EQUIPMENT_POISON_BONUS_MAX_LEVEL = 60
public constant real TD_TOWER_EQUIPMENT_RANGE_CAP = 500.0

constant int TD_ITEM_POOL_STRIDE = 32
boolean tdItemCatalogInitialized = false
int tdItemDefinitionTotal = 0
int array tdItemCatalog
int array tdItemQualitySizes
int array tdItemQualityPools
string array tdItemNames
int array tdItemQualities
int array tdItemPrimaryEffectKinds
real array tdItemPrimaryEffectValues
int array tdItemSecondaryEffectKinds
real array tdItemSecondaryEffectValues
int array tdItemLines
int array tdItemNextIds
int array tdItemAuraKinds
real array tdItemAuraValues
real array tdItemAuraRadii
int array tdItemSpecializations

function tdItemQualityPoolKey(int quality, int index) returns int
	return quality * TD_ITEM_POOL_STRIDE + index

function tdRegisterEquipment(tdEquipmentDefinition definition)
	tdItemDefinitionTotal += 1
	let index = tdItemDefinitionTotal
	tdItemCatalog[index] = definition.rawcode
	tdItemNames[index] = definition.name
	tdItemQualities[index] = definition.quality
	tdItemPrimaryEffectKinds[index] = definition.primaryKind
	tdItemPrimaryEffectValues[index] = definition.primaryValue
	tdItemSecondaryEffectKinds[index] = definition.secondaryKind
	tdItemSecondaryEffectValues[index] = definition.secondaryValue
	tdItemLines[index] = definition.line
	tdItemNextIds[index] = definition.nextId
	tdItemAuraKinds[index] = definition.auraKind
	tdItemAuraValues[index] = definition.auraValue
	tdItemAuraRadii[index] = definition.auraRadius
	tdItemSpecializations[index] = definition.specialization
	tdItemQualitySizes[definition.quality] += 1
	tdItemQualityPools[tdItemQualityPoolKey(definition.quality, tdItemQualitySizes[definition.quality])] = definition.rawcode

function tdEnsureItemCatalog()
	if tdItemCatalogInitialized
		return
	tdItemCatalogInitialized = true
	for index = 1 to 40
		tdRegisterEquipment(tdConfiguredEquipment(index))

function tdItemDefinitionIndex(int itemId) returns int
	// Rawcodes collide in Jass arrays, so item metadata must be resolved through the catalog.
	if itemId <= 0
		return 0
	for index = 1 to tdItemDefinitionTotal
		if tdItemCatalog[index] == itemId
			return index
	return 0

public function tdItemDefinitionCount() returns int
	tdEnsureItemCatalog()
	return tdItemDefinitionTotal

public function tdItemQualityCount(int quality) returns int
	tdEnsureItemCatalog()
	return tdItemQualitySizes[quality]

public function tdNextItemQuality(int quality) returns int
	if quality < TD_ITEM_QUALITY_WHITE
		return TD_ITEM_QUALITY_WHITE
	if quality >= TD_ITEM_QUALITY_PURPLE
		return TD_ITEM_QUALITY_PURPLE
	return quality + 1

public function tdItemIsEquipment(int itemId) returns boolean
	tdEnsureItemCatalog()
	return tdItemDefinitionIndex(itemId) > 0

public function tdItemName(int itemId) returns string
	tdEnsureItemCatalog()
	let definitionIndex = tdItemDefinitionIndex(itemId)
	if definitionIndex == 0
		return ""
	return tdItemNames[definitionIndex]

public function tdItemQuality(int itemId) returns int
	tdEnsureItemCatalog()
	let definitionIndex = tdItemDefinitionIndex(itemId)
	if definitionIndex == 0
		return 0
	return tdItemQualities[definitionIndex]

public function tdItemLine(int itemId) returns int
	tdEnsureItemCatalog()
	return tdItemLines[tdItemDefinitionIndex(itemId)]

public function tdItemFixedNextId(int itemId) returns int
	tdEnsureItemCatalog()
	return tdItemNextIds[tdItemDefinitionIndex(itemId)]

public function tdItemAuraKind(int itemId) returns int
	tdEnsureItemCatalog()
	return tdItemAuraKinds[tdItemDefinitionIndex(itemId)]

public function tdItemAuraDefinition(int itemId) returns tdEquipmentAuraDefinition
	tdEnsureItemCatalog()
	let index = tdItemDefinitionIndex(itemId)
	return tdEquipmentAuraDefinition(tdItemAuraKinds[index], tdItemQualities[index], tdItemAuraValues[index], tdItemAuraRadii[index])

public function tdItemAuraValue(int itemId) returns real
	tdEnsureItemCatalog()
	return tdItemAuraValues[tdItemDefinitionIndex(itemId)]

public function tdItemAuraRadius(int itemId) returns real
	tdEnsureItemCatalog()
	return tdItemAuraRadii[tdItemDefinitionIndex(itemId)]

public function tdItemSpecialization(int itemId) returns int
	tdEnsureItemCatalog()
	return tdItemSpecializations[tdItemDefinitionIndex(itemId)]

public function tdItemSpecialCount(int itemId) returns int
	return tdConfiguredSpecialCount(tdItemSpecialization(itemId))

public function tdItemSpecialTargetCap(int itemId) returns int
	return tdConfiguredSpecialTargetCap(tdItemSpecialization(itemId))

public function tdItemSpecialDamageFactor(int itemId) returns real
	return tdConfiguredSpecialDamageFactor(tdItemSpecialization(itemId))

public function tdItemSpecialRadius(int itemId) returns real
	return tdConfiguredSpecialRadius(tdItemSpecialization(itemId))

public function tdItemWarAttackSpeed() returns real
	return tdConfiguredWarAttackSpeed()

public function tdItemWarDuration() returns real
	return tdConfiguredWarDuration()

public function tdItemShieldBossArmor() returns real
	return tdConfiguredShieldBossArmor()

public function tdItemShieldBossArmorDuration() returns real
	return tdConfiguredShieldBossArmorDuration()

public function tdItemPrimaryEffectKind(int itemId) returns int
	tdEnsureItemCatalog()
	let definitionIndex = tdItemDefinitionIndex(itemId)
	if definitionIndex == 0
		return TD_ITEM_EFFECT_NONE
	return tdItemPrimaryEffectKinds[definitionIndex]

public function tdItemPrimaryEffectValue(int itemId) returns real
	tdEnsureItemCatalog()
	let definitionIndex = tdItemDefinitionIndex(itemId)
	if definitionIndex == 0
		return 0.0
	return tdItemPrimaryEffectValues[definitionIndex]

public function tdItemSecondaryEffectKind(int itemId) returns int
	tdEnsureItemCatalog()
	let definitionIndex = tdItemDefinitionIndex(itemId)
	if definitionIndex == 0
		return TD_ITEM_EFFECT_NONE
	return tdItemSecondaryEffectKinds[definitionIndex]

public function tdItemSecondaryEffectValue(int itemId) returns real
	tdEnsureItemCatalog()
	let definitionIndex = tdItemDefinitionIndex(itemId)
	if definitionIndex == 0
		return 0.0
	return tdItemSecondaryEffectValues[definitionIndex]

public function tdItemIdForCatalogIndex(int index) returns int
	tdEnsureItemCatalog()
	return tdItemCatalog[index]

public function tdItemIdForQualityRoll(int quality, int roll) returns int
	tdEnsureItemCatalog()
	let size = tdItemQualityCount(quality)
	if size <= 0
		return 0
	var clampedRoll = roll
	if clampedRoll < 1
		clampedRoll = 1
	if clampedRoll > size
		clampedRoll = size
	return tdItemQualityPools[tdItemQualityPoolKey(quality, clampedRoll)]

public function tdRandomItemIdForQuality(int quality) returns int
	tdEnsureItemCatalog()
	return tdItemIdForQualityRoll(quality, GetRandomInt(1, tdItemQualityCount(quality)))

public function tdItemQualityName(int quality) returns string
	if quality == TD_ITEM_QUALITY_WHITE
		return "白装"
	if quality == TD_ITEM_QUALITY_GREEN
		return "绿装"
	if quality == TD_ITEM_QUALITY_BLUE
		return "蓝装"
	if quality == TD_ITEM_QUALITY_PURPLE
		return "紫装"
	return "未知"

public function tdItemQualityTitleColor(int quality) returns string
	if quality == TD_ITEM_QUALITY_WHITE
		return "|cffffffff"
	if quality == TD_ITEM_QUALITY_GREEN
		return "|cff00ff00"
	if quality == TD_ITEM_QUALITY_BLUE
		return "|cff3399ff"
	if quality == TD_ITEM_QUALITY_PURPLE
		return "|cffcc66ff"
	return "|cffffffff"

public function tdItemTitleName(int itemId) returns string
	return tdItemQualityTitleColor(tdItemQuality(itemId)) + tdItemName(itemId) + "|r"

function tdItemEffectText(int effectKind, real value) returns string
	if effectKind == TD_ITEM_EFFECT_ATTACK
		return "攻击 +" + R2I(value + 0.5).toString()
	if effectKind == TD_ITEM_EFFECT_RANGE
		return "射程 +" + R2I(value + 0.5).toString() + "（装备加成上限500）"
	if effectKind == TD_ITEM_EFFECT_ATTACK_SPEED
		return "攻速 +" + R2I(value * 100.0 + 0.5).toString() + "%"
	if effectKind == TD_ITEM_EFFECT_COOLDOWN
		return "主动技能冷却缩短" + R2I(value * 100.0 + 0.5).toString() + "%（包括附身精灵的主动技能；与精灵灵感、有效冷却光环合计上限40%）"
	if effectKind == TD_ITEM_EFFECT_KILL_GOLD
		return "击杀金币：普通 +" + R2I(value / 2.0 + 0.5).toString() + "，精英击杀金币 +" + R2I(value + 0.5).toString() + "；取最高，首领无效。每波上限：非首领基础击杀收入。"
	if effectKind == TD_ITEM_EFFECT_ARMOR_SHRED
		return "普攻使目标护甲降低" + R2I(value + 0.5).toString() + "，持续3秒；装备破甲取最强，最多降低30护甲。"
	if effectKind == TD_ITEM_EFFECT_EXECUTE
		return "主目标生命不高于50%时，普攻追加" + R2I(value * 100.0 + 0.5).toString() + "%伤害；同类取最高。"
	if effectKind == TD_ITEM_EFFECT_POISON
		return "普攻附毒，每秒" + R2I(value + 0.5).toString() + "伤害，持续3秒；装备毒伤取最强。"
	if effectKind == TD_ITEM_EFFECT_CONTROL_POWER
		return "毒镖、藤蔓减速及盾击对非首领的眩晕时间提高" + R2I(value * 100.0 + 0.5).toString() + "%；同类取最高，上限60%。"
	if effectKind == TD_ITEM_EFFECT_DROP_BONUS
		return "本路非首领掉落额外抽取" + R2I(value + 0.5).toString() + "次品质，取最好结果；同类取最高，不增加件数。"
	if effectKind == TD_ITEM_EFFECT_BOSS_DAMAGE
		return "首领或金币试炼主目标普攻 +" + R2I(value * 100.0 + 0.5).toString() + "%伤害；同类最高，半血追加相加。法术、副箭、精灵及击杀不触发。"
	return ""

// Shared by the ground-item selection panel (ides) and inventory hover (utub).
// Gameplay values remain owned by the equipment catalog, never duplicated here.
public function tdItemTooltip(int itemId) returns string
	tdEnsureItemCatalog()
	let primaryKind = tdItemPrimaryEffectKind(itemId)
	let secondaryKind = tdItemSecondaryEffectKind(itemId)
	let primary = tdItemEffectText(primaryKind, tdItemPrimaryEffectValue(itemId))
	let secondary = tdItemEffectText(secondaryKind, tdItemSecondaryEffectValue(itemId))
	var tooltip = tdItemQualityName(tdItemQuality(itemId))
	if primary != ""
		tooltip += "|n" + primary
	if secondary != ""
		tooltip += "|n" + secondary
	if primaryKind == TD_ITEM_EFFECT_EXECUTE or secondaryKind == TD_ITEM_EFFECT_EXECUTE
		tooltip += "|n仅主目标普攻；半血与首领追加比例相加。法术、副箭、精灵伤害不触发；普攻击杀不追加。"
	let auraKind = tdItemAuraKind(itemId)
	if auraKind != TD_ITEM_AURA_NONE
		let value = tdItemAuraValue(itemId)
		var auraText = ""
		if auraKind == TD_ITEM_AURA_ATTACK
			auraText = "攻击光环：增加基础攻击的" + R2I(value * 100.0 + 0.5) + "%攻击力。"
		else if auraKind == TD_ITEM_AURA_ATTACK_SPEED
			auraText = "攻速光环：攻击速度 +" + R2I(value * 100.0 + 0.5) + "%（与装备攻速合计上限120%）。"
		else if auraKind == TD_ITEM_AURA_COOLDOWN
			auraText = "冷却光环：主动技能冷却缩短" + R2I(value * 100.0 + 0.5) + "%（包括附身精灵的主动技能）；装备、灵感合计上限40%，不重置冷却。"
		else if auraKind == TD_ITEM_AURA_ARMOR_ON_HIT
			auraText = "破甲光环：普攻主目标破甲" + R2I(value + 0.5) + "，持续3秒；与装备破甲取最高。"
		else if auraKind == TD_ITEM_AURA_ENEMY_SLOW
			auraText = "寒霜领域：本路敌人移动速度降低" + R2I(value * 100.0 + 0.5) + "%；减速合计上限75%。"
		tooltip += "|n" + auraText + "|n光环范围" + R2I(tdItemAuraRadius(itemId)) + "，不受装备射程影响；同名取最高等级，异名叠加。"
		if auraKind != TD_ITEM_AURA_ENEMY_SLOW
			tooltip += "本路己方塔，含自身。"
	let special = tdItemSpecialization(itemId)
	if special == TD_ITEM_SPECIAL_ARCHER_ARROW
		tooltip += "|n弓手专精：分裂箭额外增加" + tdItemSpecialCount(itemId) + "支副箭。"
	else if special == TD_ITEM_SPECIAL_WAR_INTENT
		tooltip += "|n剑圣同目标" + tdItemSpecialCount(itemId) + "次普攻：攻速 +" + R2I(tdItemWarAttackSpeed() * 100.0 + 0.5) + "%持续" + R2I(tdItemWarDuration()) + "秒，不叠层不续时；换目标或停攻" + R2I(tdConfiguredWarInactivity()) + "秒清层。"
	else if special == TD_ITEM_SPECIAL_CORPSE_BURST or special == TD_ITEM_SPECIAL_POISON_BURST
		let title = special == TD_ITEM_SPECIAL_CORPSE_BURST ? "食尸鬼" : "树妖"
		tooltip += "|n" + title + "：每" + tdItemSpecialCount(itemId) + "次普攻命中，目标周围" + R2I(tdItemSpecialRadius(itemId)) + "范围最多" + tdItemSpecialTargetCap(itemId) + "名敌人，本次普攻伤害的" + R2I(tdItemSpecialDamageFactor(itemId) * 100.0) + "%。副箭、毒伤不计。"
		if special == TD_ITEM_SPECIAL_POISON_BURST
			tooltip += "同目标；换目标或停攻" + R2I(tdConfiguredPoisonBurstInactivity()) + "秒清零。"
	else if special == TD_ITEM_SPECIAL_SHIELD_SPREAD
		tooltip += "|n步兵专精：盾击额外眩晕目标周围" + R2I(tdItemSpecialRadius(itemId)) + "范围最多" + tdItemSpecialTargetCap(itemId) + "名非首领。首领只受破甲" + R2I(tdItemShieldBossArmor()) + "，持续" + R2I(tdItemShieldBossArmorDuration()) + "秒，不受额外眩晕。"
	tooltip += "|n塔可装备；同塔同名限1件。"
	if tdItemQuality(itemId) < TD_ITEM_QUALITY_PURPLE
		tooltip += "三件同品质可由工人合成。"
	else
		tooltip += "紫装不能合成。"
	return tooltip

public function tdItemLevel(int itemId) returns int
	let quality = tdItemQuality(itemId)
	if quality == TD_ITEM_QUALITY_WHITE
		return 1
	if quality == TD_ITEM_QUALITY_GREEN
		return 3
	if quality == TD_ITEM_QUALITY_BLUE
		return 5
	if quality == TD_ITEM_QUALITY_PURPLE
		return 7
	return 1

