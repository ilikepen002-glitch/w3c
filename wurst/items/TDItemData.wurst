public function tdItemPassiveAbilityRawcodes(int _itemId) returns string
	tdEnsureItemCatalog()
	// 塔装备的实际效果统一走运行时汇总，避免让建筑库存同时吃到原生物品被动和脚本同步效果。
	return ""


public function tdItemPickupSummary(int itemId, int slot) returns string
	var primary = tdItemEffectText(tdItemPrimaryEffectKind(itemId), tdItemPrimaryEffectValue(itemId))
	if primary == "" and tdItemAuraKind(itemId) != TD_ITEM_AURA_NONE
		let kind = tdItemAuraKind(itemId)
		let label = kind == TD_ITEM_AURA_ATTACK ? "攻击光环" : (kind == TD_ITEM_AURA_ATTACK_SPEED ? "攻速光环" : (kind == TD_ITEM_AURA_COOLDOWN ? "冷却光环" : (kind == TD_ITEM_AURA_ARMOR_ON_HIT ? "普攻破甲光环" : "敌方寒霜领域")))
		primary = label + " " + tdItemQuality(itemId) + "级 · " + (kind == TD_ITEM_AURA_ARMOR_ON_HIT ? R2I(tdItemAuraValue(itemId)) + "破甲" : R2I(tdItemAuraValue(itemId) * 100.0 + 0.5) + "%")
	// Feedback is one short line; detailed reward limits belong in the tooltip.
	var lineEnd = StringLength(primary)
	for index = 0 to StringLength(primary) - 1
		if SubString(primary, index, index + 1) == "\n"
			lineEnd = index
			break
	return tdItemTitleName(itemId) + " · " + tdItemQualityName(tdItemQuality(itemId)) + " · 装备位 " + slot.toString() + " · " + SubString(primary, 0, lineEnd)

