package TDCraftingNativeBackend
import TDCraftingPlan
import TDCraftingTransaction
import TDItemData
import TDConfig
import TDState
import TDItemPlacement
import TDGroundItemRules
import LinkedList
import HashMap

Table tdCraftWatchedPickups = new Table()
boolean tdCraftPickupWatchReady = false

function tdCraftTrackPickup()
	let itm = GetManipulatedItem()
	if itm == null
		return
	let key = GetHandleId(itm)
	if tdCraftWatchedPickups.hasInt(key)
		tdCraftWatchedPickups.saveInt(key, tdCraftWatchedPickups.loadInt(key) + 1)

public function tdSetupCraftPickupWatch()
	if tdCraftPickupWatchReady
		return
	tdCraftPickupWatchReady = true
	let watch = CreateTrigger()
	watch.registerAnyUnitEvent(EVENT_PLAYER_UNIT_PICKUP_ITEM)
	watch.addAction(function tdCraftTrackPickup)

class TDCraftNativeIngredient
	item itemHandle
	int handleKey
	int rawcode
	int slot
	construct(item itemHandle, int slot)
		this.itemHandle = itemHandle
		this.handleKey = GetHandleId(itemHandle)
		this.rawcode = GetItemTypeId(itemHandle)
		this.slot = slot
		tdCraftWatchedPickups.saveInt(handleKey, 0)
	ondestroy
		tdCraftWatchedPickups.removeInt(handleKey)
		itemHandle = null

public class TDCraftNativeBackend implements TDCraftCommitBackend
	private LinkedList<TDCraftNativeIngredient> inputs = new LinkedList<TDCraftNativeIngredient>()
	private HashMap<int, TDCraftNativeIngredient> records = new HashMap<int, TDCraftNativeIngredient>()
	private HashMap<int, TDCraftNativeIngredient> handles = new HashMap<int, TDCraftNativeIngredient>()
	private unit farmer
	private player caster
	private int lane
	private vec2 origin
	private boolean inventory
	private item output = null
	private int outputId = 0
	private int outputKey = 0
	private int array[5] pileCounts
	int deliveryExceptions = 0

	construct(unit farmer, int lane, vec2 origin, boolean inventory)
		this.farmer = farmer
		this.caster = GetOwningPlayer(farmer)
		this.lane = lane
		this.origin = origin
		this.inventory = inventory

	function capture(TDCraftPlan plan, item itm, int slot) returns boolean
		if itm == null or GetItemTypeId(itm) == 0 or not tdItemIsEquipment(GetItemTypeId(itm))
			return false
		if handles.has(GetHandleId(itm))
			return false
		let key = inputs.size() + 1
		if not plan.capture(key, GetItemTypeId(itm))
			return false
		let record = new TDCraftNativeIngredient(itm, slot)
		inputs.add(record)
		records.put(key, record)
		handles.put(record.handleKey, record)
		return true

	override function available(int key, int rawcode) returns boolean
		if tdIsGameOver() or farmer == null or not farmer.isAlive() or GetUnitTypeId(farmer) != TD_FARMER_UNIT_ID or GetOwningPlayer(farmer) != caster
			return false
		if not records.has(key)
			return false
		let record = records.get(key)
		let itm = record.itemHandle
		if itm == null or GetItemTypeId(itm) != rawcode or record.rawcode != rawcode
			return false
		if not tdCraftWatchedPickups.hasInt(record.handleKey) or tdCraftWatchedPickups.loadInt(record.handleKey) != 0
			return false
		if inventory
			return UnitItemInSlot(farmer, record.slot) == itm
		if IsItemOwned(itm) or not IsItemVisible(itm)
			return false
		let point = tdItemActualPosition(itm)
		return tdGroundItemLane(point.x, point.y) == lane and tdGroundPointInUpgradeCircle(point.x, point.y, origin.x, origin.y)

	override function prepareResult(int rawcode) returns int
		if output != null or not tdItemIsEquipment(rawcode)
			return 0
		output = CreateItem(rawcode, origin.x, origin.y)
		if output == null
			return 0
		SetItemVisible(output, false)
		var placed = false
		if GetItemTypeId(output) == rawcode
			if inventory
				placed = tdTryPlaceItemNear(output, lane, origin, false)
			else
				// Prepare at the final next-quality pile before consuming anything.
				// Source terrain is irrelevant; reuse the checked native pile placement.
				let quality = tdItemQuality(rawcode)
				let index = tdTryPlaceItemInPile(output, lane, quality, pileCounts[quality])
				if index >= 0
					pileCounts[quality] = index + 1
					placed = true
		if not placed
			RemoveItem(output)
			output = null
			return 0
		outputId = rawcode
		outputKey += 1
		return outputKey

	override function consumeThree(int first, int second, int third) returns boolean
		if not tdGroundItemHandleValid(output) or GetItemTypeId(output) != outputId or not tdItemGroundPointSafe(lane, tdItemActualPosition(output))
			return false
		if not inventory and not tdItemActualInPile(output, lane, tdItemQuality(outputId))
			return false
		if first == second or first == third or second == third
			return false
		if not records.has(first) or not records.has(second) or not records.has(third)
			return false
		let one = records.get(first)
		let two = records.get(second)
		let three = records.get(third)
		if not available(first, one.rawcode) or not available(second, two.rawcode) or not available(third, three.rawcode)
			return false
		// No yields and no UnitRemoveItem/drop event between ingredient removals.
		// All three exact handles are valid before the irreversible native phase.
		RemoveItem(one.itemHandle)
		RemoveItem(two.itemHandle)
		RemoveItem(three.itemHandle)
		return true

	override function publishResult(int resultKey)
		if resultKey != outputKey or output == null
			return
		let result = output
		output = null
		SetItemVisible(result, true)
		if inventory
			if UnitAddItem(farmer, result)
				for slot = 0 to 5
					if UnitItemInSlot(farmer, slot) == result
						return
			// Failed inventory delivery preserves this exact output on legal ground.
			if not tdTryPlaceItemNear(result, lane, origin, false)
				deliveryExceptions += 1
				DisplayTimedTextToPlayer(caster, 0, 0, 6.0, "合成产物未删除，但交付落点异常，请收取物品句柄 " + GetHandleId(result) + "（" + tdItemName(outputId) + "）。")
			else
				DisplayTimedTextToPlayer(caster, 0, 0, 4.0, "背包交付未完成，产物已保留在合成操作附近。")

	override function discardResult(int resultKey)
		if resultKey == outputKey and output != null
			RemoveItem(output)
			output = null

	ondestroy
		if output != null
			RemoveItem(output)
		for record in inputs
			destroy record
		destroy inputs
		destroy records
		destroy handles
		farmer = null
		caster = null
