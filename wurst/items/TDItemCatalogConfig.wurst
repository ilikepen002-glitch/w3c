public function tdConfiguredSpecialCount(int specialization) returns int
	if specialization == TD_ITEM_SPECIAL_ARCHER_ARROW
		return 1
	if specialization == TD_ITEM_SPECIAL_WAR_INTENT
		return 4
	if specialization == TD_ITEM_SPECIAL_CORPSE_BURST
		return 6
	if specialization == TD_ITEM_SPECIAL_POISON_BURST
		return 3
	return 0

public function tdConfiguredSpecialDamageFactor(int specialization) returns real
	if specialization == TD_ITEM_SPECIAL_CORPSE_BURST or specialization == TD_ITEM_SPECIAL_POISON_BURST
		return 0.50
	return 0.0

public function tdConfiguredSpecialRadius(int specialization) returns real
	if specialization == TD_ITEM_SPECIAL_CORPSE_BURST
		return 180.0
	if specialization == TD_ITEM_SPECIAL_POISON_BURST
		return 220.0
	if specialization == TD_ITEM_SPECIAL_SHIELD_SPREAD
		return 200.0
	return 0.0

public function tdConfiguredSpecialTargetCap(int specialization) returns int
	if specialization == TD_ITEM_SPECIAL_CORPSE_BURST or specialization == TD_ITEM_SPECIAL_POISON_BURST
		return 4
	if specialization == TD_ITEM_SPECIAL_SHIELD_SPREAD
		return 2
	return 0

public function tdConfiguredWarAttackSpeed() returns real
	return 0.20

public function tdConfiguredWarDuration() returns real
	return 3.0

public function tdConfiguredShieldBossArmor() returns real
	return 4.0

public function tdConfiguredShieldBossArmorDuration() returns real
	return 3.0

// Script shield values. Normal/Hero durations are deliberately identical per
// candidate; Boss is a separate .25-second native ability and shared window.
public function tdConfiguredShieldNormalStunDuration() returns real
	return 0.60
public function tdConfiguredShieldNormalStunCap() returns real
	return 0.90
public function tdConfiguredShieldNormalProtection() returns real
	return 0.60
public function tdConfiguredShieldBossStunDuration() returns real
	return 0.25
public function tdConfiguredShieldBossProtection() returns real
	return 1.75
public function tdConfiguredShieldCastMargin() returns real
	return 0.08

public function tdConfiguredWarInactivity() returns real
	return 3.0

public function tdConfiguredPoisonBurstInactivity() returns real
	return 3.0
