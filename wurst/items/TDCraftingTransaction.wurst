package TDCraftingTransaction
import TDCraftingCatalog
import TDCraftingPlan

public constant int TD_CRAFT_COMMIT_CANCELLED = 0
public constant int TD_CRAFT_COMMIT_SUCCESS = 1
public constant int TD_CRAFT_COMMIT_RESULT_FAILED = 2
public constant int TD_CRAFT_COMMIT_ALREADY_ATTEMPTED = 3

// Synchronous borrowed-backend contract; native callbacks can reenter.
// available validates exact source rawcode/handle/slot/owner and pickup snapshot.
// prepareResult owns one hidden new output; inventory has no ground prerequisite,
// while ground prepares its final next-quality pile. It never consumes materials.
// consumeThree first delivers and verifies inventory output after all callbacks,
// then removes three exact sources consecutively. Failure never deletes originals;
// one full-inventory temporary source may be independently pending recovery.
// publishResult is only the accepted output's visibility/ownership handoff.
// discardResult may delete only this transaction's uncommitted new output.
// No timer, yield or user input occurs within this commit.
public interface TDCraftCommitBackend
	function available(int key, int rawcode) returns boolean
	function prepareResult(int rawcode) returns int
	function consumeThree(int first, int second, int third) returns boolean
	function publishResult(int resultKey)
	function discardResult(int resultKey)

function tdCraftBatchAvailable(TDCraftBatch batch, TDCraftCommitBackend backend) returns boolean
	for slot = 0 to 2
		let ingredient = batch.ingredient(slot)
		if not backend.available(ingredient.getKey(), ingredient.getRawcode())
			return false
	return true

public function tdCommitCraftBatch(TDCraftPlan plan, int index, TDCraftCatalog catalog, TDCraftCommitBackend backend, int roll) returns int
	if plan == null or catalog == null or backend == null or not plan.isFrozen() or not plan.usesCatalog(catalog)
		return TD_CRAFT_COMMIT_CANCELLED
	let batch = plan.batch(index)
	if batch == null
		return TD_CRAFT_COMMIT_CANCELLED
	// Invalid or failed groups are terminal for this snapshot, never re-filled.
	if not batch.beginAttempt()
		return TD_CRAFT_COMMIT_ALREADY_ATTEMPTED
	if not tdCraftBatchAvailable(batch, backend)
		return TD_CRAFT_COMMIT_CANCELLED
	let resultId = batch.result(catalog, roll)
	if resultId == 0 or catalog.quality(resultId) != batch.sourceQuality() + 1
		return TD_CRAFT_COMMIT_RESULT_FAILED
	let resultKey = backend.prepareResult(resultId)
	if resultKey == 0
		return TD_CRAFT_COMMIT_RESULT_FAILED
	// Revalidate after preparation; the native backend rechecks after delivery too.
	if not tdCraftBatchAvailable(batch, backend)
		backend.discardResult(resultKey)
		return TD_CRAFT_COMMIT_CANCELLED
	if not backend.consumeThree(batch.ingredient(0).getKey(), batch.ingredient(1).getKey(), batch.ingredient(2).getKey())
		backend.discardResult(resultKey)
		return TD_CRAFT_COMMIT_CANCELLED
	backend.publishResult(resultKey)
	return TD_CRAFT_COMMIT_SUCCESS
