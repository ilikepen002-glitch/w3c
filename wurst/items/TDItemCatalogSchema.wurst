public constant int TD_ITEM_EFFECT_ATTACK = 1
public constant int TD_ITEM_EFFECT_RANGE = 2
public constant int TD_ITEM_EFFECT_ATTACK_SPEED = 3
public constant int TD_ITEM_EFFECT_COOLDOWN = 4
public constant int TD_ITEM_EFFECT_KILL_GOLD = 5
public constant int TD_ITEM_EFFECT_ARMOR_SHRED = 6
public constant int TD_ITEM_EFFECT_EXECUTE = 7
public constant int TD_ITEM_EFFECT_POISON = 8
public constant int TD_ITEM_EFFECT_CONTROL_POWER = 9
public constant int TD_ITEM_EFFECT_DROP_BONUS = 10
public constant int TD_ITEM_EFFECT_BOSS_DAMAGE = 11

public constant int TD_ITEM_AURA_NONE = 0
public constant int TD_ITEM_AURA_ATTACK = 1
public constant int TD_ITEM_AURA_ATTACK_SPEED = 2
public constant int TD_ITEM_AURA_COOLDOWN = 3
