public tuple tdEquipmentDefinition(int rawcode, int quality, int line, int nextId, string name, int primaryKind, real primaryValue, int secondaryKind, real secondaryValue, int auraKind, real auraValue, real auraRadius, int specialization)

public function tdItemPersonalEffectStacks(int kind) returns boolean
	return kind == TD_ITEM_EFFECT_ATTACK or kind == TD_ITEM_EFFECT_ATTACK_SPEED or kind == TD_ITEM_EFFECT_RANGE
