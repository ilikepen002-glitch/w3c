package TDEquipmentObjectGen
import TDTooltipText
import TDEquipmentRules
import TDShieldRules
import TDItemCatalogConfig
import TDTowerData
import ChannelAbilityPreset

public function tdConfigureEquipmentBloodlust(AbilityDefinitionBloodlust definition)
	definition.setLevels(41)
	for level = 1 to 41
		definition.setTooltipNormal(level, "嗜血")
		definition.setTooltipNormalExtended(level, "自身攻击速度提高" + tdBonusPercentString(tdOrcBloodlustAttackSpeedBonus()) + "，持续" + tdTooltipNumber(tdOrcBloodlustDuration()) + "秒。|n冷却" + tdTooltipNumber((tdOrcBloodlustCooldown() * (1.0 - (level - 1) / 100.0))) + "秒；可自动施放，获得时默认开启，可手动关闭。")
		definition.setMovementSpeedIncrease(level, tdOrcBloodlustMoveSpeedBonus())
		definition.setAttackSpeedIncrease(level, tdOrcBloodlustAttackSpeedBonus())
		definition.setScalingFactor(level, 1.0)
		definition.setDurationNormal(level, tdOrcBloodlustDuration())
		definition.setDurationHero(level, tdOrcBloodlustDuration())
		definition.setCooldown(level, tdOrcBloodlustCooldown() * (1.0 - (level - 1) / 100.0))
		definition.setManaCost(level, 0)
		definition.setCastRange(level, 0.0)
		definition.setTargetsAllowed(level, tdTowerBloodlustTargetsAllowed())
		definition.setBuffs(level, "Bblo")

public function tdConfigureEquipmentBladestorm(AbilityDefinitionSlow definition)
	definition.setLevels(41)
	for level = 1 to 41
		definition.setTooltipNormal(level, "剑刃风暴")
		definition.setTooltipNormalExtended(level, "原地旋转" + tdTooltipNumber(tdOrcBladestormDuration()) + "秒，对自身" + tdOrcBladestormRadius().toInt().toString() + "范围内敌人每秒造成" + tdOrcBladestormDamagePerSecond().toInt().toString() + "伤害。|n冷却" + tdTooltipNumber((tdOrcBladestormCooldown() * (1.0 - (level - 1) / 100.0))) + "秒；可自动施放。范围不受装备射程影响。")
		definition.setTooltipTurnOff(level, "剑刃风暴")
		definition.setTooltipTurnOffExtended(level, "关闭自动施放，改为手动释放剑刃风暴。")
		definition.setMovementSpeedFactor(level, 0.0)
		definition.setAttackSpeedFactor(level, 0.0)
		definition.setAlwaysAutocast(level, true)
		definition.setCooldown(level, tdOrcBladestormCooldown() * (1.0 - (level - 1) / 100.0))
		definition.setManaCost(level, 0)
		definition.setCastRange(level, tdOrcBladestormRadius())
		definition.setTargetsAllowed(level, "enemy,ground,air,organic")
		definition.setBuffs(level, "")
		definition.setDurationNormal(level, 0.0)
		definition.setDurationHero(level, 0.0)

public function tdConfigureEquipmentPoison(AbilityDefinitionSlowPoison definition, real dps, real moveFactor, real attackFactor)
	definition.setLevels(61)
	for level = 1 to 61
		definition.setTooltipNormalExtended(level, "普攻附毒，每秒" + tdTooltipNumber(dps) + "伤害，持续5秒（英雄1秒）。|n移动速度降低" + tdPreciseBonusPercentString(tdEquipmentControlReduction(1.0 - moveFactor, level)) + "，攻击速度降低" + tdPreciseBonusPercentString(1.0 - attackFactor) + "。")
		definition.setDamagePerSecond(level, dps)
		definition.setMovementSpeedFactor(level, 0.0) // Unified script move slow; Aspo poison/attack-slow stay native.
		definition.setAttackSpeedFactor(level, 1.0 - attackFactor)
		// Preserve Aspo's verified 1.27a parent duration and both native buffs.
		definition.setDurationNormal(level, 5.0)
		definition.setDurationHero(level, 1.0)
		definition.setTargetsAllowed(level, "air,ground,organic")
		definition.setBuffs(level, "Bspo,Bssd")
		definition.setStackingType(level, 1)

public function tdEquipmentSlowAuraReduction(boolean evolved, int level) returns real
	return tdEquipmentControlReduction((1.0 - tdDryadAuraSlowFactor()) * (evolved ? tdEvolutionSkillMultiplier() : 1.0), level)

public function tdConfigureEquipmentSlowAura(AbilityDefinitionAuraSlow definition, boolean evolved, real radius)
	definition.setLevels(61)
	for level = 1 to 61
		definition.setTooltipNormal(level, evolved ? "进化缓速藤蔓" : (radius > tdDryadAuraSlowRadius() ? "宽域缓速藤蔓" : "缓速藤蔓"))
		definition.setTooltipNormalExtended(level, "被动：周围" + radius.toInt().toString() + "范围敌军移动速度降低" + tdPreciseBonusPercentString(tdEquipmentSlowAuraReduction(evolved, level)) + "。")
		definition.setMovementSpeedFactor(level, 0.0) // Movement owned solely by the shared slow state.
		definition.setAttackSpeedFactor(level, 0.0)
		definition.setAreaofEffect(level, radius)
		definition.setTargetsAllowed(level, "enemy,ground,air,organic")
		definition.setBuffs(level, "") // Only the highest identity/rank receives the real state Buff.
		definition.setDurationNormal(level, 0.0)
		definition.setDurationHero(level, 0.0)

public function tdConfigureEquipmentBash(AbilityDefinitionMountainKingBash definition, boolean perfect)
	definition.setLevels(61)
	for level = 1 to 61
		let normalDuration = tdShieldStunDuration(false, (level - 1) / 100.0)
		definition.setTooltipNormal(level, perfect ? "进化盾击" : "盾击")
		definition.setTooltipNormalExtended(level, "有效主普攻有" + tdPreciseBonusPercentString(tdShieldProcChance(perfect)) + "概率盾击。普通敌人眩晕" + tdTooltipNumber(normalDuration) + "秒，上限" + tdTooltipNumber(tdConfiguredShieldNormalStunCap()) + "秒，结束后保护" + tdTooltipNumber(tdConfiguredShieldNormalProtection()) + "秒；真正首领眩晕" + tdTooltipNumber(tdConfiguredShieldBossStunDuration()) + "秒，结束后保护" + tdTooltipNumber(tdConfiguredShieldBossProtection()) + "秒。不同塔共享每名敌人的盾击窗口；失败施放不扩散。")
		// Display/evolution ID stays native. Actual zero-damage AHtb is script only.
		definition.setChancetoBash(level, 0.0)
		definition.setDamageMultiplier(level, 1.0)
		definition.setDamageBonus(level, 0.0)
		definition.setNeverMiss(level, false)
		definition.setDurationNormal(level, 0.0)
		definition.setDurationHero(level, 0.0)
		definition.setTargetsAllowed(level, "ground,air")
		definition.setBuffs(level, "")

@compiletime function tdGenerateEquipmentArmorShred()
	let definition = new AbilityDefinitionDefenseBonusPlus1(TD_EQUIPMENT_ARMOR_SHRED_ABILITY_ID)
	definition.setName("装备破甲")
	definition.setLevels(TD_EQUIPMENT_ARMOR_MAX)
	definition.setItemAbility(true)
	definition.setCheckDependencies(false)
	for level = 1 to TD_EQUIPMENT_ARMOR_MAX
		definition.setDefenseBonus(level, -level)

