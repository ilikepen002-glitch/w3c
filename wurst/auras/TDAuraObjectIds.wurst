public function tdAuraBuff(int identity, int rank) returns buffTuple
	if identity == 1 and rank == 1
		return tdAuraBuff1_1
	if identity == 1 and rank == 2
		return tdAuraBuff1_2
	if identity == 2 and rank == 1
		return tdAuraBuff2_1
	if identity == 2 and rank == 2
		return tdAuraBuff2_2
	if identity == 3 and rank == 1
		return tdAuraBuff3_1
	if identity == 3 and rank == 2
		return tdAuraBuff3_2
	if identity == 3 and rank == 3
		return tdAuraBuff3_3
	if identity == 3 and rank == 4
		return tdAuraBuff3_4
	if identity == 4 and rank == 1
		return tdAuraBuff4_1
	if identity == 4 and rank == 2
		return tdAuraBuff4_2
	if identity == 4 and rank == 3
		return tdAuraBuff4_3
	if identity == 4 and rank == 4
		return tdAuraBuff4_4
	if identity == 5 and rank == 4
		return tdAuraBuff5_4
	if identity == 6 and rank == 4
		return tdAuraBuff6_4
	if identity == 7 and rank == 1
		return tdAuraBuff7_1
	if identity == 7 and rank == 2
		return tdAuraBuff7_2
	if identity == 7 and rank == 3
		return tdAuraBuff7_3
	if identity == 7 and rank == 4
		return tdAuraBuff7_4
	if identity == 10 and rank == 1
		return tdAuraBuff10_1
	if identity == 10 and rank == 2
		return tdAuraBuff10_2
	if identity == 11 and rank == 1
		return tdAuraBuff11_1
	if identity == 11 and rank == 2
		return tdAuraBuff11_2
	if identity == 12 and rank == 1
		return tdAuraBuff12_1
	if identity == 12 and rank == 2
		return tdAuraBuff12_2
	if identity == 12 and rank == 3
		return tdAuraBuff12_3
	if identity == 12 and rank == 4
		return tdAuraBuff12_4
	if identity == 13 and rank == 1
		return tdAuraBuff13_1
	if identity == 13 and rank == 2
		return tdAuraBuff13_2
	if identity == 13 and rank == 3
		return tdAuraBuff13_3
	if identity == 13 and rank == 4
		return tdAuraBuff13_4
	if identity == 14 and rank == 1
		return tdAuraBuff14_1
	return buffTuple(0, 0)

