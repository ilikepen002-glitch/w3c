package TDEnemyMechanicObjectGen
import TDEnemyMechanicData
import AbilityObjEditing

@compiletime function tdGenerateEnemyMechanicObjects()
	// This independent native item bonus composes with equipment/pets/bloodlust.
	new AbilityDefinitionAttackSpeedIncrease(TD_BOSS_DARK_TIDE_ABILITY_ID)
	..setName("暗潮攻速削减")
	..setAttackSpeedIncrease(1, TD_BOSS_DARK_TIDE_ATTACK_SPEED)
	..setItemAbility(true)
	..setCheckDependencies(false)
