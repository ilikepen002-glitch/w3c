package TDCombatVisualData

public constant int TD_VISUAL_SHORT_LIMIT = 128
public constant int TD_VISUAL_HIT_LIMIT = 32
public constant int TD_VISUAL_NEW_PER_SECOND = 120
public constant int TD_VISUAL_LANE_GROUPS_PER_SECOND = 10
public constant int TD_VISUAL_MOVING_LIMIT = 8

// Mesh-only five-element impacts. Complete fade lives in Stand; transparent
// Death cannot leave an uncounted visible tail after the shared owner releases.
public function tdCombatVisualHitModel(int element) returns string
	if element == 1
		return "war3mapImported\\TDPetHitGoldCrescent.mdx"
	if element == 2
		return "war3mapImported\\TDPetHitWoodThorns.mdx"
	if element == 3
		return "war3mapImported\\TDPetHitWaterShards.mdx"
	if element == 4
		return "war3mapImported\\TDPetHitFireCrown.mdx"
	return element == 5 ? "war3mapImported\\TDPetHitEarthFault.mdx" : ""

public function tdCombatVisualHitDuration(int element) returns real
	if element == 1
		return 0.18
	if element == 3
		return 0.26
	return element == 4 ? 0.23 : 0.28

public function tdCombatVisualGearProfile(int choice, int item1, int item2, int item3) returns int
	var required = 0
	if choice == 1
		required = 'iP01'
	else if choice == 2
		required = 'iP02'
	else if choice == 3
		required = 'iP03'
	else if choice == 4
		required = 'iP05'
	else if choice == 5
		required = 'iP04'
	if required != 0
		if item1 == required or item2 == required or item3 == required
			return choice
	return 0

public function tdCombatVisualGearModel(int profile) returns string
	if profile == 1
		return "Abilities\\Spells\\NightElf\\TrueshotAura\\TrueshotAura.mdx"
	if profile == 2
		return "Abilities\\Spells\\Orc\\Bloodlust\\BloodLustTarget.mdx"
	if profile == 3
		return "Abilities\\Spells\\Human\\DevotionAura\\DevotionAura.mdx"
	if profile == 4
		return "Abilities\\Spells\\NightElf\\ThornsAura\\ThornsAura.mdx"
	return profile == 5 ? "Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdx" : ""

public function tdCombatVisualHitBudget(real now, real readyAt, int sourceCount, int laneGroups, int hits, int total, int created) returns boolean
	return now >= readyAt and sourceCount < 2 and laneGroups < TD_VISUAL_LANE_GROUPS_PER_SECOND and hits < TD_VISUAL_HIT_LIMIT and total < TD_VISUAL_SHORT_LIMIT and created < TD_VISUAL_NEW_PER_SECOND

// Optional automatic buff feedback; the locked classic Abilities catalogue
// contains both paths. These are separate from the equipment attachment.
public function tdCombatVisualPetBuffModel(int skill) returns string
	if skill == 11
		return "Abilities\\Spells\\Orc\\Bloodlust\\BloodLustTarget.mdx"
	return skill == 12 ? "Abilities\\Spells\\Human\\InnerFire\\InnerFireTarget.mdx" : ""

public function tdCombatVisualPetBuffStartModel(int skill) returns string
	if skill == 11
		return "Abilities\\Spells\\Orc\\Bloodlust\\BloodLustSpecial.mdx"
	return skill == 12 ? "Abilities\\Spells\\NightElf\\BattleRoar\\RoarCaster.mdx" : ""
