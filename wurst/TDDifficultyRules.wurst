package TDDifficultyRules

public constant int TD_DIFFICULTY_NORMAL = 1
public constant int TD_DIFFICULTY_COUNT = 4

public function tdDifficultyValid(int difficulty) returns boolean
	return difficulty >= 1 and difficulty <= TD_DIFFICULTY_COUNT

public function tdDifficultyHealthMultiplier(int difficulty) returns real
	if difficulty == 2
		return 1.30
	if difficulty == 3
		return 1.70
	if difficulty == 4
		return 2.20
	return 1.0

public function tdDifficultyName(int difficulty) returns string
	if difficulty == 2
		return "困难"
	if difficulty == 3
		return "噩梦"
	if difficulty == 4
		return "传奇"
	return "普通"

public function tdDifficultyLabel(int difficulty) returns string
	if difficulty == 2
		return "困难 · 生命×1.3"
	if difficulty == 3
		return "噩梦 · 生命×1.7"
	if difficulty == 4
		return "传奇 · 生命×2.2"
	return "普通 · 生命×1"

public function tdDifficultyHitPoints(int baseHitPoints, int difficulty) returns int
	return baseHitPoints + R2I(baseHitPoints * (tdDifficultyHealthMultiplier(difficulty) - 1.0) + 0.5)
