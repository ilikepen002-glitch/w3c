package TDDamageHud
import TDDamageState
import TDConfig
import TDState
import TDHudProjection

public constant int TD_DAMAGE_HUD_ROWS = 16
public constant int TD_DAMAGE_HUD_COLUMNS = 4
public constant int TD_DAMAGE_TOWER_TOP_COUNT = 10

// Fixed scalar storage keeps one synchronized snapshot without another class.
string array tdDamageHudCells
int tdDamageVisibleRows = 0

public function tdDamageHudCell(int row, int column) returns string
	if row < 0 or row >= TD_DAMAGE_HUD_ROWS or column < 0 or column >= TD_DAMAGE_HUD_COLUMNS
		return ""
	return tdDamageHudCells[row * TD_DAMAGE_HUD_COLUMNS + column]

function tdDamageSetHudCell(int row, int column, string value)
	tdDamageHudCells[row * TD_DAMAGE_HUD_COLUMNS + column] = value

function tdDamageSetPlayerHud(TDDamageLedger ledger, int lane, boolean p0, boolean p1, boolean p2, boolean p3)
	let total = ledger.playerTotal(lane)
	let rank = tdDamagePlayerRank(total, lane, ledger.playerTotal(0), p0, ledger.playerTotal(1), p1, ledger.playerTotal(2), p2, ledger.playerTotal(3), p3)
	tdDamageSetHudCell(1 + rank, 0, "P" + (lane + 1).toString())
	tdDamageSetHudCell(1 + rank, 1, tdDamageText(total))

public function tdDamagePrepareHud(TDDamageLedger ledger, boolean p0, boolean p1, boolean p2, boolean p3)
	// Clear every cell, including the unused player and tower tails.
	for index = 0 to TD_DAMAGE_HUD_ROWS * TD_DAMAGE_HUD_COLUMNS - 1
		tdDamageHudCells[index] = ""
	tdDamageSetHudCell(0, 0, "玩家ID")
	tdDamageSetHudCell(0, 1, "累计伤害")
	if p0
		tdDamageSetPlayerHud(ledger, 0, p0, p1, p2, p3)
	if p1
		tdDamageSetPlayerHud(ledger, 1, p0, p1, p2, p3)
	if p2
		tdDamageSetPlayerHud(ledger, 2, p0, p1, p2, p3)
	if p3
		tdDamageSetPlayerHud(ledger, 3, p0, p1, p2, p3)
	tdDamageSetHudCell(5, 0, "排名")
	tdDamageSetHudCell(5, 1, "玩家ID")
	tdDamageSetHudCell(5, 2, "防御塔 Top10")
	tdDamageSetHudCell(5, 3, "累计伤害")
	for rank = 0 to TD_DAMAGE_TOWER_TOP_COUNT - 1
		let record = ledger.ranked(rank)
		if record != null
			let row = 6 + rank
			tdDamageSetHudCell(row, 0, (rank + 1).toString())
			tdDamageSetHudCell(row, 1, "P" + (record.getLane() + 1).toString())
			tdDamageSetHudCell(row, 2, record.label + (record.retired ? " [退场]" : ""))
			tdDamageSetHudCell(row, 3, tdDamageText(record.getTotal()))

	tdDamageVisibleRows = 0
	for visibleRow = 0 to TD_DAMAGE_HUD_ROWS - 1
		if tdDamageHudRowVisible(visibleRow)
			tdDamageVisibleRows += 1

// Compact only the presentation; the fixed snapshot and all ranking keys stay intact.
public function tdDamageHudRowVisible(int row) returns boolean
	if row == 5
		return tdDamageHudCell(6, 0) != ""
	return tdDamageHudCell(row, 0) != ""

public function tdDamageHudVisibleRows() returns int
	return tdDamageVisibleRows

public function tdDamageRefreshHud(multiboard board, int firstRow)
	// Prepared once by the HUD owner before sizing the board.
	tdHudProjectionBind(TD_HUD_DAMAGE_SECTION, board, firstRow, tdDamageHudVisibleRows(), TD_DAMAGE_HUD_COLUMNS)
	var target = 0
	for row = 0 to TD_DAMAGE_HUD_ROWS - 1
		if tdDamageHudRowVisible(row)
			for column = 0 to TD_DAMAGE_HUD_COLUMNS - 1
				tdHudProjectionSetValue(TD_HUD_DAMAGE_SECTION, target, column, tdDamageHudCell(row, column))
			target += 1
