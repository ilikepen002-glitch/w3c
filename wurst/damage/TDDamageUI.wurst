package TDDamageUI
import TDDamageState
import TDDamageData
import TDDamageRuntime
import TDConfig
import TDState
import TDHud
import RegisterEvents
import Dialog
import Table

constant int TD_DAMAGE_DIALOG_BUTTON_LIMIT = 8
dialog array tdDamageDialogs
button array tdDamageDialogButtons
int array tdDamageDialogButtonCount
constant Table tdDamageDialogActions = new Table()
trigger tdDamageDialogTrigger = CreateTrigger()
boolean tdDamageUIReady = false

function tdDamageClearDialog(int viewer)
	for index = 0 to tdDamageDialogButtonCount[viewer] - 1
		let key = viewer * TD_DAMAGE_DIALOG_BUTTON_LIMIT + index
		tdDamageDialogActions.removeInt(tdDamageDialogButtons[key].getHandleId())
		tdDamageDialogButtons[key] = null
	tdDamageDialogButtonCount[viewer] = 0
	tdDamageDialogs[viewer].clear()

function tdDamageAddDialogButton(int viewer, string label, int action)
	let clicked = tdDamageDialogs[viewer].addButton(label)
	tdDamageDialogActions.saveInt(clicked.getHandleId(), action)
	tdDamageDialogButtons[viewer * TD_DAMAGE_DIALOG_BUTTON_LIMIT + tdDamageDialogButtonCount[viewer]] = clicked
	tdDamageDialogButtonCount[viewer] += 1

public function tdDamageShowPage(int viewer)
	if not tdIsLaneActive(viewer) or tdDamageDialogs[viewer] == null
		return
	tdDamageRefreshCatalog()
	tdDamageClearDialog(viewer)
	let lane = tdDamageViewerLane(viewer)
	let count = tdDamageLedger.count(lane)
	let page = tdDamageClampedPage(tdDamageViewerPage(viewer), count)
	var text = "伤害统计 · " + tdDamagePageTitle(viewer)
	text += "|n精灵协战计入宿主塔；点击按钮切换右上角榜单。"
	if count == 0
		text += "|n暂无已完工防御塔。"
	for slot = 0 to TD_DAMAGE_PAGE_SIZE - 1
		let record = tdDamageLedger.ranked(lane, page * TD_DAMAGE_PAGE_SIZE + slot)
		if record != null
			text += "|nP" + (record.getLane() + 1).toString() + " #" + record.getSerial().toString() + " " + record.label + (record.retired ? " [退场]" : "") + "：" + tdDamageText(record.getTotal())
	tdDamageDialogs[viewer].setMessage(text)
	tdDamageAddDialogButton(viewer, "全部玩家总榜", TD_DAMAGE_ACTION_ALL)
	for playerId = 0 to TD_ACTIVE_PLAYER_COUNT - 1
		if tdIsLaneActive(playerId)
			tdDamageAddDialogButton(viewer, "玩家" + (playerId + 1).toString() + " · " + tdDamageText(tdDamageLedger.playerTotal(playerId)), TD_DAMAGE_ACTION_PLAYER_BASE + playerId)
	tdDamageAddDialogButton(viewer, "上一页", TD_DAMAGE_ACTION_PREVIOUS)
	tdDamageAddDialogButton(viewer, "下一页", TD_DAMAGE_ACTION_NEXT)
	tdDamageAddDialogButton(viewer, "关闭", TD_DAMAGE_ACTION_CLOSE)
	tdDamageDialogs[viewer].display(Player(viewer), true)

function tdDamageHandleDialog()
	let viewer = GetPlayerId(GetTriggerPlayer())
	if not tdIsLaneActive(viewer) or GetClickedDialog() != tdDamageDialogs[viewer]
		return
	let key = GetClickedButton().getHandleId()
	if not tdDamageDialogActions.hasInt(key)
		return
	let action = tdDamageDialogActions.loadInt(key)
	tdDamageDialogs[viewer].display(Player(viewer), false)
	if not tdDamageApplyPageAction(viewer, action)
		return
	tdRefreshStatusBoard()
	if action == TD_DAMAGE_ACTION_CLOSE
		tdDamageClearDialog(viewer)
	else
		tdDamageShowPage(viewer)

function tdDamageHandleStatisticsSpell() returns boolean
	let farmer = GetTriggerUnit()
	if farmer != null and GetUnitTypeId(farmer) == TD_FARMER_UNIT_ID
		tdDamageShowPage(GetPlayerId(GetOwningPlayer(farmer)))
	return false

public function tdSetupDamageUI()
	if tdDamageUIReady or compiletime
		return
	tdDamageUIReady = true
	for viewer = 0 to TD_ACTIVE_PLAYER_COUNT - 1
		tdDamageDialogs[viewer] = DialogCreate()
		TriggerRegisterDialogEvent(tdDamageDialogTrigger, tdDamageDialogs[viewer])
	tdDamageDialogTrigger.addAction(function tdDamageHandleDialog)
	registerSpellEffectEvent(TD_FARMER_DAMAGE_STATISTICS_ABILITY_ID, function tdDamageHandleStatisticsSpell)
