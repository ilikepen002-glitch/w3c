		return tdActiveSkillDefinition(22, TD_ACTIVE_DRIVER_PET_PROC, 0, 33, 14.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
	if index == 19
		return tdActiveSkillDefinition(23, TD_ACTIVE_DRIVER_PET_PROC, 0, 34, 18.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
