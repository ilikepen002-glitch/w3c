public constant int TD_ACTIVE_DRIVER_NATIVE_ABILITY = 1
public constant int TD_ACTIVE_DRIVER_PET_PROC = 2
public constant int TD_ACTIVE_AUTOCAST_UNKNOWN = 0
public constant int TD_ACTIVE_AUTOCAST_ON = 1
public constant int TD_ACTIVE_AUTOCAST_OFF = 2
public constant int TD_ACTIVE_BLOODLUST = 1
public constant int TD_ACTIVE_BLADESTORM = 2
public constant int TD_ACTIVE_PET_FRENZY = 3
