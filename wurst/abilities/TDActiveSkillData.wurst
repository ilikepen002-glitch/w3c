		return tdActiveSkillDefinition(18, TD_ACTIVE_DRIVER_PET_PROC, 0, 29, 14.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
	if index == 15
		return tdActiveSkillDefinition(19, TD_ACTIVE_DRIVER_PET_PROC, 0, 30, 18.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
	if index == 16
		return tdActiveSkillDefinition(20, TD_ACTIVE_DRIVER_PET_PROC, 0, 31, 10.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
	if index == 17
		return tdActiveSkillDefinition(21, TD_ACTIVE_DRIVER_PET_PROC, 0, 32, 12.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
