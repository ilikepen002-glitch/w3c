	if index == 8
		return tdActiveSkillDefinition(12, TD_ACTIVE_DRIVER_PET_PROC, 0, 23, 10.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
	if index == 9
		return tdActiveSkillDefinition(13, TD_ACTIVE_DRIVER_PET_PROC, 0, 24, 12.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
	if index == 10
		return tdActiveSkillDefinition(14, TD_ACTIVE_DRIVER_PET_PROC, 0, 25, 14.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
	if index == 11
		return tdActiveSkillDefinition(15, TD_ACTIVE_DRIVER_PET_PROC, 0, 26, 18.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
	if index == 12
		return tdActiveSkillDefinition(16, TD_ACTIVE_DRIVER_PET_PROC, 0, 27, 10.0, 0, 0, TD_ACTIVE_AUTOCAST_UNKNOWN)
