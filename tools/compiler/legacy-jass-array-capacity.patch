+package tests.wurstscript.tests;
+
+import org.testng.annotations.Test;
+
+/** Execute generated Jass as well as IM; returning error handlers expose accidental slot-zero writes. */
+public class LegacyJassAllocationTests extends WurstScriptTest {
+    @Test
+    public void targetCapacitySurvivesEarlyTreeShakeForClassesAndClosures() {
+        test().targetArrayCapacity().executeProg().executeProgOnlyAfterTransforms().lines(
+            "globals",
+            "    constant integer JASS_MAX_ARRAY_SIZE = 3",
+            "endglobals",
+            "package ErrorHandling",
+            "    public int errors = 0",
+            "    public function error(string msg)",
+            "        errors += 1",
+            "endpackage",
+            "package Test",
+            "    import ErrorHandling",
+            "    native testSuccess()",
+            "    int closureInit = 0",
+            "    abstract class F",
+            "        construct()",
+            "            closureInit += 1",
+            "        abstract function run() returns int",
+            "    class A",
+            "        int value = 7",
+            "    class B extends A",
+            "    function runTest()",
+            "        let a = new A()",
+            "        let b = new B()",
+            "        let c = new B()",
+            "        if c != null or errors != 1",
+            "            return",
+            "        let seed = 11",
+            "        F f1 = () -> seed",
+            "        F f2 = () -> seed + 11",
+            "        F f3 = () -> seed + 22",
+            "        if f3 == null and f1.run() == 11 and f2.run() == 22 and errors == 2 and closureInit == 2",
+            "            testSuccess()",
+            "    init",
+            "        runTest()",
+            "endpackage");
+    }
+
+    @Test
+    public void exhaustionDoesNotInitializeNullAndFreeIdsRemainReusable() {
+        test().executeProg().executeProgOnlyAfterTransforms().lines(
+            "package ErrorHandling",
+            "    public int errors = 0",
+            "    public function error(string msg)",
+            "        errors += 1",
+            "endpackage",
+            "package Test",
+            "    import ErrorHandling",
+            "    native testSuccess()",
+            "    int initialized = 0",
+            "    class A",
+            "        int value = 42",
+            "        int array[2] values",
+            "        construct()",
+            "            initialized += 1",
+            "            values[0] = 17",
+            "            values[1] = 29",
+            "    class B extends A",
+            "    function runTest()",
+            "        A first = new B()",
+            "        A last = first",
+            "        for i = 2 to 8191",
+            "            last = new A()",
+            "        if (last castTo int) != 8191 or initialized != 8191",
+            "            return",
+            "        let fail1 = new B()",
+            "        let fail2 = new A()",
+            "        if fail1 != null or fail2 != null or initialized != 8191 or errors != 2",
+            "            return",
+            "        if last.value != 42 or last.values[0] != 17 or last.values[1] != 29",
+            "            return",
+            "        let oldId = first castTo int",
+            "        destroy first",
+            "        let reused = new B()",
+            "        if (reused castTo int) == oldId and reused.values[1] == 29 and initialized == 8192",
+            "            testSuccess()",
+            "    init",
+            "        runTest()",
+            "endpackage");
+    }
+}
